-- Persistence: re-assert F down on Heartbeat (runs even unfocused/minimized,
-- unlike RenderStepped) so the hold survives tabbing out or switching clients.
-- The game can drop virtual key state on focus loss; re-pressing is idempotent.
local lastTestHoldPulse = 0
table.insert(connections, RunService.Heartbeat:Connect(function()
	if not testHoldBlock then return end
	local now = os.clock()
	if now - lastTestHoldPulse < 0.15 then return end
	lastTestHoldPulse = now
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum or hum.Health <= 0 then return end
	scriptFDown()
end))


local lastFired = 0
local function fireBlackFlashM1()
	local now = tick()
	if now - lastFired < 0.5 then return end
	lastFired = now

	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not bp then return end
	local input = bp:FindFirstChild("Input")
	if not input then return end

	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	input:FireServer("M1", {
		air = false,
		mousehit = root.CFrame,
		md = Vector3.zero,
		dodgevelo = nil,
		skeydown = false,
		skeyreal = false
	})
end

local customBlackFlashHandler
customBlackFlashHandler = function(p1, p2)
	local v1 = p1 - p2
	pcall(function()
		local camTween = game:GetService("TweenService"):Create(
			workspace.CurrentCamera,
			TweenInfo.new(v1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
			{ FieldOfView = 6 }
		)
		camTween:Play()
	end)
	
	-- Delay M1 to the peak of the zoom (60ms before deadline) to bypass server response speed limits
	local delayTime = math.max(0, v1 - 0.06)
	task.wait(delayTime)
	
	pcall(fireBlackFlashM1)
	
	task.wait(math.max(0, v1 - delayTime))
	
	pcall(function()
		workspace.CurrentCamera.FieldOfView = 70
		task.spawn(function()
			task.wait(0.1)
			workspace.CurrentCamera.FieldOfView = 70
		end)
	end)
	return true, false
end

local function applyBlackFlashHook()
	if not blackFlashCheck then
		blackFlashCheck = game.ReplicatedStorage:FindFirstChild("BlackFlashCheck")
	end
	if blackFlashCheck and not originalBlackFlashHandler then
		local success, result = pcall(function() return blackFlashCheck.OnClientInvoke end)
		if success and type(result) == "function" then
			originalBlackFlashHandler = result
		end
	end
	if blackFlashCheck then
		if autoBlackFlashEnabled then
			blackFlashCheck.OnClientInvoke = customBlackFlashHandler
		else
			if originalBlackFlashHandler then
				blackFlashCheck.OnClientInvoke = originalBlackFlashHandler
			end
		end
	end
end






local function snatchPSCodes()
    local results = {}
    local function searchDescendants(parent, playerName)
        for _, descendant in ipairs(parent:GetDescendants()) do
            if descendant:IsA("StringValue") and string.lower(descendant.Name) == "lastpscode" then
                local code = descendant.Value
                if code and code ~= "" then
                    results[playerName] = code
                end
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        searchDescendants(player, player.Name)
        if player.Character then
            searchDescendants(player.Character, player.Name)
        end
    end

    local count = 0
    local resultsList = {}
    for name, code in pairs(results) do
        count = count + 1
        table.insert(resultsList, name .. ": " .. code)
    end

    if count > 0 then
        local outputText = table.concat(resultsList, "\n")
        do end
        local setClipboardFn = setclipboard or toclipboard
        if setClipboardFn then
            pcall(function() setClipboardFn(outputText) end)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "PS Code Snatcher",
                    Text = "Snatched " .. tostring(count) .. " codes! Copied to clipboard.",
                    Duration = 5
                })
            end)
        else
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "PS Code Snatcher",
                    Text = "Snatched " .. tostring(count) .. " codes! Check console (F9).",
                    Duration = 5
                })
            end)
        end
    else
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "PS Code Snatcher",
                Text = "No PS Codes found in the server.",
                Duration = 5
            })
        end)
    end
end

snatchBtn.MouseButton1Click:Connect(function()
	if snatchPSCodes then snatchPSCodes() end
end)

