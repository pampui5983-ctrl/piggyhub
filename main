	-- input ----------------------------------------------------------------
	local mouseLocked = false
	local savedMouseBehavior = nil
	local mutedInputs = {}
	local canMuteInputs = type(getconnections) == "function"

	local function muteGameInput()
		if not canMuteInputs or #mutedInputs > 0 then return end
		local ok, list = pcall(getconnections, UIS.InputChanged)
		if not ok or type(list) ~= "table" then return end
		for _, c in ipairs(list) do
			if pcall(function() c:Disable() end) then
				mutedInputs[#mutedInputs + 1] = c
			end
		end
	end

	local function unmuteGameInput()
		for i = #mutedInputs, 1, -1 do
			local c = mutedInputs[i]
			pcall(function() c:Enable() end)
			mutedInputs[i] = nil
		end
	end

	local function lockMouse()
		if mouseLocked then return end
		mouseLocked = true
		savedMouseBehavior = UIS.MouseBehavior
		UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		muteGameInput()
	end

	local function unlockMouse()
		if not mouseLocked then return end
		mouseLocked = false
		UIS.MouseBehavior = savedMouseBehavior or Enum.MouseBehavior.Default
		savedMouseBehavior = nil
		unmuteGameInput()
	end

	local function isDragInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	local function pointInEdge(input)
		local size = holder.AbsoluteSize
		-- InputObject.Position is a Vector3; AbsolutePosition is a Vector2
		local p = Vector2.new(input.Position.X, input.Position.Y) - holder.AbsolutePosition
		return p.X <= EDGE_MARGIN
			or p.Y <= EDGE_MARGIN
			or p.X >= size.X - EDGE_MARGIN
			or p.Y >= size.Y - EDGE_MARGIN
	end

	local function endDrag()
		local wasResize = dragMode == "resize"
		dragMode = nil
		unlockMouse()
		if wasResize then autoSaveSettings() end
	end

	table.insert(connections, holder.InputBegan:Connect(function(input)
		if not isDragInput(input) then return end
		dragOrigin = holder.Position
		local localPos = Vector2.new(input.Position.X, input.Position.Y) - holder.AbsolutePosition
		local size = holder.AbsoluteSize
		if localPos.X >= size.X - RESIZE_GRIP and localPos.Y >= size.Y - RESIZE_GRIP then
			unlockMouse()
			dragMode = "resize"
			dragStart = UIS:GetMouseLocation()
			resizeStart = size
		elseif pointInEdge(input) then
			unlockMouse()
			dragMode = "move"
			dragStart = UIS:GetMouseLocation()
		else
			dragMode = "orbit"
			lockMouse()
		end
	end))

	table.insert(connections, UIS.InputEnded:Connect(function(input)
		if isDragInput(input) then endDrag() end
	end))

	local function zoom(notches)
		camDist = math.clamp(camDist * (1 - notches * ZOOM_STEP), CAM_DIST_MIN, CAM_DIST_MAX)
	end

	table.insert(connections, holder.MouseWheelForward:Connect(function() zoom(1) end))
	table.insert(connections, holder.MouseWheelBackward:Connect(function() zoom(-1) end))

	local function updateInput()
		if not dragMode then return end
		if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			endDrag()
			return
		end

		local now = UIS:GetMouseLocation()

		if dragMode == "move" then
			local delta = now - dragStart
			local viewport = gui.AbsoluteSize
			local nx = dragOrigin.X.Offset + delta.X
			local ny = dragOrigin.Y.Offset + delta.Y
			nx = math.clamp(nx, -WINDOW_W + 40, math.max(-WINDOW_W + 40, viewport.X - 40))
			ny = math.clamp(ny, -WINDOW_H + 40, math.max(-WINDOW_H + 40, viewport.Y - 40))
			holder.Position = UDim2.fromOffset(math.floor(nx), math.floor(ny))
		elseif dragMode == "resize" then
			local viewport = gui.AbsoluteSize
			local delta = now - dragStart
			local maxW = math.max(MIN_WIN_W, viewport.X - math.max(holder.Position.X.Offset, 0))
			local maxH = math.max(MIN_WIN_H, viewport.Y - math.max(holder.Position.Y.Offset, 0))
			local w = math.clamp(resizeStart.X + delta.X, MIN_WIN_W, maxW)
			local h = math.clamp(resizeStart.Y + delta.Y, MIN_WIN_H, maxH)
			WINDOW_W, WINDOW_H = math.floor(w), math.floor(h)
			pipCfg.winW, pipCfg.winH = WINDOW_W, WINDOW_H
			holder.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
		else
			-- cursor is pinned, only relative motion is available
			if not mouseLocked then lockMouse() end
			if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCurrentPosition then
				UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			end
			local delta = UIS:GetMouseDelta()
			if delta.Magnitude > 0 then
				yaw = yaw - delta.X * ORBIT_SENS
				pitch = math.clamp(pitch + delta.Y * ORBIT_SENS, math.rad(-45), math.rad(80))
			end
		end
	end

	-- character mirrors ----------------------------------------------------
	local function stripClone(c)
		local doomed = {}
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BaseScript") or d:IsA("ModuleScript") then table.insert(doomed, d) end
		end
		for _, d in ipairs(doomed) do d:Destroy() end
		c.PrimaryPart = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
	end

	local function makeMirror(char)
		local c = char:Clone()
		stripClone(c)
		c.Name = "__mirror_" .. char.Name
		c.Parent = world
		local hum = c:FindFirstChildOfClass("Humanoid")
		if hum and not hum:FindFirstChildOfClass("Animator") then
			local a = Instance.new("Animator")
			a.Parent = hum
		end
		return { char = char, clone = c, tracks = {}, nextAppearCheck = os.clock() + 0.35 }
	end

	local function dropMirror(entry)
		for _, t in pairs(entry.tracks) do
			pcall(function() t:Stop(0) end)
		end
		entry.tracks = {}
		pcall(function() entry.clone:Destroy() end)
	end

	local function visualSignature(root)
		local s = { shirt = 0, pants = 0, acc = 0, mesh = 0, grey = 0, parts = 0 }
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Shirt") or d:IsA("ShirtGraphic") then
				s.shirt = s.shirt + 1
			elseif d:IsA("Pants") then
				s.pants = s.pants + 1
			elseif d:IsA("Accessory") or d:IsA("Hat") then
				s.acc = s.acc + 1
			elseif d:IsA("MeshPart") then
				s.mesh = s.mesh + 1
			end
			if d:IsA("BasePart") then
				s.parts = s.parts + 1
				local col = d.Color
				if math.abs(col.R - DEFAULT_GREY.R) < 0.02
					and math.abs(col.G - DEFAULT_GREY.G) < 0.02
					and math.abs(col.B - DEFAULT_GREY.B) < 0.02 then
					s.grey = s.grey + 1
				end
			end
		end
		return s
	end

	local function needsRebuild(live, clone)
		local a = visualSignature(live)
		local b = visualSignature(clone)
		if a.shirt > b.shirt then return true end
		if a.pants > b.pants then return true end
		if a.acc > b.acc then return true end
		if a.mesh > b.mesh then return true end
		if b.grey > a.grey then return true end
		return false
	end

	local function syncAnimations(entry, liveChar)
		local liveHum = liveChar:FindFirstChildOfClass("Humanoid")
		local cloneHum = entry.clone:FindFirstChildOfClass("Humanoid")
		if not liveHum or not cloneHum then return end
		if liveHum.Health <= 0 then return end
		local liveAnim = liveHum:FindFirstChildOfClass("Animator")
		if not liveAnim then return end
		local cloneAnim = cloneHum:FindFirstChildOfClass("Animator")
		if not cloneAnim then return end

		local playing = {}
		local ok, tracks = pcall(function()
			return liveAnim:GetPlayingAnimationTracks()
		end)
		if ok and tracks then
			for _, t in ipairs(tracks) do
				local anim = t.Animation
				local id = anim and anim.AnimationId
				if id and id ~= "" then playing[id] = t end
			end
		end

		for id, ct in pairs(entry.tracks) do
			if not playing[id] then
				pcall(function() ct:Stop(0.1) end)
				entry.tracks[id] = nil
			end
		end

		for id, lt in pairs(playing) do
			local ct = entry.tracks[id]
			if not ct then
				local ok2, newTrack = pcall(function()
					return cloneAnim:LoadAnimation(lt.Animation)
				end)
				if ok2 and newTrack then
					newTrack:Play(0, lt.WeightCurrent, lt.Speed)
					newTrack.TimePosition = lt.TimePosition
					entry.tracks[id] = newTrack
					ct = newTrack
				end
			end
			if ct then
				local drift = ct.TimePosition - lt.TimePosition
				if math.abs(drift) > ANIM_DRIFT and lt.Speed ~= 0 then
					ct.TimePosition = lt.TimePosition
				end
				if math.abs(ct.Speed - lt.Speed) > 0.01 then
					ct:AdjustSpeed(lt.Speed)
				end
				if math.abs(ct.WeightCurrent - lt.WeightCurrent) > 0.05 then
					ct:AdjustWeight(lt.WeightCurrent, 0.1)
				end
			end
		end
	end

	local function collectStaticParts()
		local list = {}
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 then
				local ok, p = true, d
				while p and p ~= workspace do
					if Players:GetPlayerFromCharacter(p) or p:IsA("Accessory") or p:IsA("Tool") then
						ok = false
						break
					end
					p = p.Parent
				end
				if ok then list[#list + 1] = d end
			end
		end
		return list
	end

	-- Chunked workspace scan: same result as collectStaticParts but it yields to
	-- the scheduler every ~0.6 ms, so scanning a big place never stalls a frame.
	-- Whole subtrees (player characters, accessories, tools) are skipped up front
	-- instead of walking every part's ancestor chain.
	local function walkWorkspace(onPart)
		-- one walk at a time: a rebuild must never read a half-finished scan
		while scanBusy do task.wait() end
		scanBusy = true
		local ok = pcall(function()
			local stack = { workspace }
			local budget = 0.0006
			while #stack > 0 do
				local frameStart = os.clock()
				repeat
					local node = table.remove(stack)
					local skip = node:IsA("Accessory") or node:IsA("Tool")
						or (node:IsA("Model") and Players:GetPlayerFromCharacter(node) ~= nil)
					if not skip then
						for _, ch in ipairs(node:GetChildren()) do
							if ch:IsA("BasePart") then
								if ch.Transparency < 1 then onPart(ch) end
							else
								stack[#stack + 1] = ch
							end
						end
					end
				until #stack == 0 or (os.clock() - frameStart) >= budget
				if #stack > 0 then task.wait() end
			end
		end)
		scanBusy = false
		return ok
	end

	local function commitSnapshot(snap)
		local previous = {}
		for _, ch in ipairs(world:GetChildren()) do
			if ch.Name == "__worldsnap" then table.insert(previous, ch) end
		end
		snap.Name = "__worldsnap"
		snap.Parent = world
		if #previous == 0 then return end
		-- take the old islands out of the render list at once, then free their
		-- instances in small slices so the destroy does not cost a frame
		for _, ch in ipairs(previous) do pcall(function() ch.Parent = nil end) end
		task.spawn(function()
			for _, ch in ipairs(previous) do
				local kids = ch:GetChildren()
				for j = 1, #kids do
					pcall(function() kids[j]:Destroy() end)
					if j % 60 == 0 then task.wait() end
				end
				pcall(function() ch:Destroy() end)
			end
		end)
	end

	local function cloneInto(snap, list)
		local n = 0
		for _, d in ipairs(list) do
			local ok, c = pcall(function() return d:Clone() end)
			if ok and c then
				c.Anchored = true
				c.CanCollide = false
				c.Parent = snap
				n = n + 1
			end
		end
		return n
	end

	-- NOTE: no synthetic ground plane. One used to be added under the target,
	-- which meant a rebuild while they were airborne dropped a huge grey slab at
	-- that altitude and hid the real geometry once they landed. Only real map
	-- parts are mirrored now.

	-- Whole-map mirror: if the map fits the budget it is cloned once, so the PiP
	-- never shows a floating island that lags behind the target. Both the scan and
	-- the clone run on a per-frame time budget, so a map reload costs at most a
	-- couple of milliseconds per frame instead of a visible freeze.
	local function buildFullWorld()
		if rebuilding then return true end
		rebuilding = true
		worldFull = true
		snapAt = os.clock()
		task.spawn(function()
			local list = {}
			local complete = walkWorkspace(function(part) list[#list + 1] = part end)
			if not complete or not pipCfg.enabled or not worldFull then
				rebuilding = false
				if not complete then
					-- fall back to the radius patch instead of showing an empty world
					worldFull = false
					snapCenter = nil
					mapPartCount = 0
				end
				return
			end
			if #list > WORLD_FULL_BUDGET then
				-- too big for a full mirror: let the radius fallback take over
				rebuilding = false
				worldFull = false
				mapPartCount = 0
				snapCenter = nil
				return
			end
			mapPartCount = #list
			local snap = Instance.new("Model")
			local i = 1
			while i <= #list do
				local frameStart = os.clock()
				repeat
					local ok, c = pcall(function() return list[i]:Clone() end)
					if ok and c then
						c.Anchored = true
						c.CanCollide = false
						c.Parent = snap
					end
					i = i + 1
				until i > #list or (os.clock() - frameStart) >= 0.002
				task.wait()
				if not pipCfg.enabled or not worldFull then
					pcall(function() snap:Destroy() end)
					rebuilding = false
					-- the snapshot was cleared while we were building (PiP toggled
					-- off/on, or a map swap): start over if it is still wanted
					if pipCfg.enabled and not worldFull then task.defer(buildFullWorld) end
					return
				end
			end
			commitSnapshot(snap)
			snapAt = os.clock()
			rebuilding = false
		end)
		return true
	end

	-- Fallback for very large maps: a radius patch around the target that follows it.
	local function snapshotWorld(center, radius, budget)
		if radius <= 0 then return 0 end
		local cand = {}
		for _, d in ipairs(collectStaticParts()) do
			local dist = (d.Position - center).Magnitude
			if dist <= radius then table.insert(cand, { part = d, dist = dist }) end
		end
		table.sort(cand, function(a, b) return a.dist < b.dist end)
		local list = {}
		for i = 1, math.min(budget, #cand) do list[i] = cand[i].part end
		local snap = Instance.new("Model")
		local n = cloneInto(snap, list)
		commitSnapshot(snap)
		worldFull = false
		mapPartCount = n
		return n
	end

	local function checkFullWorld()
		if not pipCfg.enabled or not worldFull or rebuilding or scanBusy then return end
		task.spawn(function()
			local count = 0
			walkWorkspace(function() count = count + 1 end)
			if not pipCfg.enabled or not worldFull or rebuilding then return end
			if math.abs(count - mapPartCount) > math.max(30, mapPartCount * 0.05) then
				buildFullWorld()
			end
		end)
	end

	local function attemptCount(plr, char)
		local a = attempts[plr]
		if not a or a.char ~= char then return 0 end
		return a.n
	end

	local function bumpAttempt(plr, char)
		local a = attempts[plr]
		if not a or a.char ~= char then
			a = { char = char, n = 0 }
			attempts[plr] = a
		end
		a.n = a.n + 1
		return a.n
	end

	local function forceRebuild(plr)
		local entry = mirrors[plr]
		if not entry then return end
		if bumpAttempt(plr, entry.char) > APPEAR_MAX_REBUILDS then return end
		dropMirror(entry)
		mirrors[plr] = nil
	end

	local function markRebuild(plr)
		local entry = mirrors[plr]
		if not entry then return end
		if attemptCount(plr, entry.char) >= APPEAR_MAX_REBUILDS then return end
		forceRebuild(plr)
	end

	local function bindPlayer(plr)
		if playerConns[plr] then return end
		local conns = {}
		conns[#conns + 1] = plr.CharacterAppearanceLoaded:Connect(function()
			task.delay(0.05, function() markRebuild(plr) end)
		end)
		conns[#conns + 1] = plr.CharacterAdded:Connect(function()
			task.delay(0.05, function() markRebuild(plr) end)
		end)
		playerConns[plr] = conns
	end

	local function unbindAll()
		for _, list in pairs(playerConns) do
			for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
		end
		playerConns = {}
	end

	local function wantsMirror(plr)
		if plr == pipTarget then return true end
		local tc = pipTarget and pipTarget.Character
		local thrp = tc and tc:FindFirstChild("HumanoidRootPart")
		local hrc = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not (thrp and hrc) then return false end
		return (hrc.Position - thrp.Position).Magnitude <= MIRROR_NEARBY_DIST
	end

	local function pipIsTeammate(plr)
		if plr == LocalPlayer then return true end
		if not LocalPlayer.Team or not plr.Team then
			return LocalPlayer.TeamColor == plr.TeamColor
		end
		return LocalPlayer.Team == plr.Team or LocalPlayer.TeamColor == plr.TeamColor
	end

	-- Nearest living player to the spectated character that we would consider an
	-- enemy. With Team Check off every player counts (FFA places rarely set teams).
	local function scanEnemies(originPos)
		local bestPlr, bestDist = nil, ENEMY_RANGE
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= pipTarget and plr ~= LocalPlayer then
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hum and hrp and hum.Health > 0 then
					local friendly = teamCheckEnabled and pipIsTeammate(plr)
					if not friendly then
						local dist = (hrp.Position - originPos).Magnitude
						if dist < bestDist then
							bestDist, bestPlr = dist, plr
						end
					end
				end
			end
		end
		return bestPlr, bestDist
	end

	local function resolveTarget(preferred)
		if preferred and preferred ~= "" then
			local p = Players:FindFirstChild(preferred)
			if p then return p end
		end
		local fallback
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then return p end
			fallback = fallback or p
		end
		return fallback
	end

	local function clearSnapOnly()
		for _, ch in ipairs(world:GetChildren()) do
			if ch.Name == "__worldsnap" then pcall(function() ch:Destroy() end) end
		end
		snapCenter, snapAt = nil, 0
		worldFull = false
		mapPartCount = 0
	end

	local function clearMirrors()
		for _, entry in pairs(mirrors) do dropMirror(entry) end
		mirrors = {}
		attempts = {}
		clearSnapOnly()
	end

	-- ESP tab controls -----------------------------------------------------
	local ddRow = Instance.new("Frame")
	ddRow.Size = UDim2.new(1, 0, 0, 32)
	ddRow.Position = UDim2.new(0, 0, 0, 504)
	ddRow.BackgroundTransparency = 1
	ddRow.ZIndex = 20 -- keep the popup above the sliders it opens over
	ddRow.Parent = tabFrames.esp

	local ddLabel = Instance.new("TextLabel")
	ddLabel.Size = UDim2.new(1, -160, 1, 0)
	ddLabel.BackgroundTransparency = 1
	ddLabel.Text = "Spectate Player"
	ddLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
	ddLabel.TextSize = 13
	ddLabel.Font = Enum.Font.GothamMedium
	ddLabel.TextXAlignment = Enum.TextXAlignment.Left
	ddLabel.Parent = ddRow

	local ddBtn = Instance.new("TextButton")
	ddBtn.Size = UDim2.new(0, 150, 0, 24)
	ddBtn.Position = UDim2.new(1, -150, 0.5, -12)
	ddBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	ddBtn.Text = "No one"
	ddBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	ddBtn.Font = Enum.Font.GothamBold
	ddBtn.TextSize = 12
	ddBtn.TextTruncate = Enum.TextTruncate.AtEnd
	ddBtn.AutoButtonColor = false
	ddBtn.Parent = ddRow
	do
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = ddBtn
		local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(60, 60, 75) s.Thickness = 1 s.Parent = ddBtn
	end

	local ddList = Instance.new("Frame")
	ddList.Size = UDim2.new(0, 150, 0, 160)
	ddList.Position = UDim2.new(1, -150, 0, -164)
	ddList.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
	ddList.BorderSizePixel = 0
	ddList.Visible = false
	ddList.ZIndex = 20
	ddList.ClipsDescendants = true
	ddList.Parent = ddRow
	do
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = ddList
		local s = Instance.new("UIStroke") s.Color = Color3.fromRGB(60, 60, 75) s.Thickness = 1 s.Parent = ddList
	end

	local ddScroll = Instance.new("ScrollingFrame")
	ddScroll.Size = UDim2.new(1, 0, 1, 0)
	ddScroll.BackgroundTransparency = 1
	ddScroll.BorderSizePixel = 0
	ddScroll.ScrollBarThickness = 4
	ddScroll.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 95)
	ddScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	ddScroll.ZIndex = 20
	ddScroll.Parent = ddList

	refreshButton = function()
		if pipTarget and pipTarget.Parent then
			ddBtn.Text = pipTarget.Name
			ddBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			ddBtn.Text = "No one"
			ddBtn.TextColor3 = Color3.fromRGB(150, 150, 170)
		end
	end

	refreshPlayerList = function()
		for _, ch in ipairs(ddScroll:GetChildren()) do
			if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
		end

		-- Teammates first, enemies under them. With Team Check off only real Team
		-- assignments (plus yourself) count as teammates, otherwise an FFA place
		-- where everybody shares the neutral TeamColor would list everyone as one.
		local team, others = {}, {}
		for _, p in ipairs(Players:GetPlayers()) do
			local friendly = p == LocalPlayer
				or (teamCheckEnabled and pipIsTeammate(p))
				or (LocalPlayer.Team ~= nil and p.Team ~= nil and LocalPlayer.Team == p.Team)
			table.insert(friendly and team or others, p)
		end
		local function byName(a, b) return a.Name:lower() < b.Name:lower() end
		table.sort(team, byName)
		table.sort(others, byName)

		local y = 0
		local function addHeader(text)
			local h = Instance.new("TextLabel")
			h.Size = UDim2.new(1, -6, 0, 16)
			h.Position = UDim2.new(0, 4, 0, y + 4)
			h.BackgroundTransparency = 1
			h.Text = text
			h.TextColor3 = Color3.fromRGB(150, 150, 170)
			h.TextSize = 10
			h.Font = Enum.Font.GothamBold
			h.TextXAlignment = Enum.TextXAlignment.Left
			h.ZIndex = 20
			h.Parent = ddScroll
			y = y + 20
		end

		local function addOption(p)
			local opt = Instance.new("TextButton")
			opt.Size = UDim2.new(1, -4, 0, 22)
			opt.Position = UDim2.new(0, 2, 0, y + 2)
			opt.BackgroundColor3 = (p == pipTarget) and Color3.fromRGB(70, 45, 65) or Color3.fromRGB(30, 28, 38)
			opt.Text = (p == LocalPlayer) and (p.Name .. "  (you)") or p.Name
			opt.TextColor3 = Color3.fromRGB(230, 230, 240)
			opt.Font = Enum.Font.Gotham
			opt.TextSize = 12
			opt.TextTruncate = Enum.TextTruncate.AtEnd
			opt.TextXAlignment = Enum.TextXAlignment.Left
			opt.BorderSizePixel = 0
			opt.ZIndex = 20
			opt.Parent = ddScroll
			opt.MouseButton1Click:Connect(function()
				setTarget(p)
				ddList.Visible = false
				autoSaveSettings()
			end)
			opt.MouseEnter:Connect(function()
				opt.BackgroundColor3 = Color3.fromRGB(50, 48, 58)
			end)
			opt.MouseLeave:Connect(function()
				opt.BackgroundColor3 = (p == pipTarget) and Color3.fromRGB(70, 45, 65) or Color3.fromRGB(30, 28, 38)
			end)
			y = y + 24
		end

		if #team > 0 then
			addHeader("TEAMMATES")
			for _, p in ipairs(team) do addOption(p) end
		end
		if #others > 0 then
			if #team > 0 then y = y + 2 end
			addHeader("ENEMIES")
			for _, p in ipairs(others) do addOption(p) end
		end

		ddScroll.CanvasSize = UDim2.new(0, 0, 0, y + 4)
		ddScroll.CanvasPosition = Vector2.zero
	end

	setTarget = function(p)
		if not p then return end
		pipTarget = p
		pipCfg.target = p.Name
		pipAutoYaw = nil
		pipEnemy, pipEnemyYaw, pipEnemyDist = nil, nil, 0
		enemyAcc = 1
		refreshButton()
		if pipCfg.enabled then clearMirrors() end
	end

	ddBtn.MouseButton1Click:Connect(function()
		ddList.Visible = not ddList.Visible
		if ddList.Visible then refreshPlayerList() end
	end)

	table.insert(connections, Players.PlayerAdded:Connect(function()
		if ddList.Visible then refreshPlayerList() end
	end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(plr)
		if pipTarget == plr then
			pipTarget = nil
			refreshButton()
		end
		if ddList.Visible then refreshPlayerList() end
	end))

	applyEnabled = function(state)
		pipCfg.enabled = state and true or false
		if pipCfg.enabled then
			if not pipTarget or not pipTarget.Parent then
				pipTarget = resolveTarget(pipCfg.target)
				pipCfg.target = pipTarget and pipTarget.Name or ""
			end
			refreshButton()
			gui.Enabled = true
			clearSnapOnly()
			if not buildFullWorld() then snapCenter = nil end
			if not placed then
				placed = true
				task.defer(function()
					local vs = gui.AbsoluteSize
					if vs.X > 0 then
						local x = math.clamp(MARGIN, 0, math.max(0, vs.X - WINDOW_W))
						local y = math.clamp(TOP_SAFE, 0, math.max(0, vs.Y - WINDOW_H - MARGIN))
						holder.Position = UDim2.fromOffset(x, y)
					end
				end)
			end
		else
			gui.Enabled = false
			ddList.Visible = false
			pcall(unlockMouse)
			dragMode = nil
			clearMirrors()
			unbindAll()
		end
	end

	local pipToggleRef = createToggle(tabFrames.esp, "Player PiP", 386, pipCfg.enabled, function(state)
		applyEnabled(state)
	end)
	settingsRefs.pipEnabled = pipToggleRef

	local pipAutoturnRef, pipEnemyLockRef

	pipAutoturnRef = createToggle(tabFrames.esp, "PiP Autoturn", 424, pipCfg.autoturn, function(state)
		pipCfg.autoturn = state
		if state and pipCfg.enemyLock then
			pipCfg.enemyLock = false
			if pipEnemyLockRef then pipEnemyLockRef.Set(false) end
		end
	end)
	settingsRefs.pipAutoturn = pipAutoturnRef

	pipEnemyLockRef = createToggle(tabFrames.esp, "PiP Enemy Lock", 466, pipCfg.enemyLock, function(state)
		pipCfg.enemyLock = state
		if state then
			enemyAcc = 1 -- scan on the next frame
			if pipCfg.autoturn then
				pipCfg.autoturn = false
				if pipAutoturnRef then pipAutoturnRef.Set(false) end
			end
		end
	end)
	settingsRefs.pipEnemyLock = pipEnemyLockRef

	pipCfg.setEnabled = function(state)
		pipToggleRef.Set(state and true or false)
		if pipCfg.winW and pipCfg.winH then
			WINDOW_W, WINDOW_H = pipCfg.winW, pipCfg.winH
			holder.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
		end
		applyEnabled(state)
	end

	pipCfg.setTarget = function(name)
		local p = Players:FindFirstChild(tostring(name or ""))
		if p then setTarget(p) end
	end

	pipCleanup = function()
		pcall(unlockMouse)
		pcall(unbindAll)
		for _, entry in pairs(mirrors) do pcall(dropMirror, entry) end
		mirrors = {}
		pcall(function() gui:Destroy() end)
		if getgenv().__pipState then getgenv().__pipState = nil end
	end

	getgenv().__pipState = function()
		return string.format("enabled=%s autoturn=%s enemyLock=%s enemy=%s(%.0f) autoYaw=%s target=%s mirrors=%d world=%s(%d) win=%dx%d dist=%.1f yaw=%.1f pitch=%.1f label=%q",
			tostring(pipCfg.enabled), tostring(pipCfg.autoturn), tostring(pipCfg.enemyLock),
			pipEnemy and pipEnemy.Name or "none", pipEnemyDist,
			pipAutoYaw and string.format("%.1f", math.deg(pipAutoYaw)) or "nil",
			pipTarget and pipTarget.Name or "none",
			(function() local n = 0 for _ in pairs(mirrors) do n = n + 1 end return n end)(),
			worldFull and "full" or "radius", mapPartCount,
			WINDOW_W, WINDOW_H,
			camDist, math.deg(yaw), math.deg(pitch), label.Text)
	end

	-- follow loop ----------------------------------------------------------
	table.insert(connections, RS.RenderStepped:Connect(function(dt)
		if not pipCfg.enabled then return end

		pcall(updateInput)
		if mouseLocked and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			pcall(endDrag)
		end

		if not pipTarget or not pipTarget.Parent then
			pipTarget = resolveTarget(pipCfg.target)
			pipCfg.target = pipTarget and pipTarget.Name or ""
			refreshButton()
		end
		if not pipTarget then
			label.Text = "no players"
			return
		end

		frames = frames + 1
		acc = acc + dt
		if acc >= 0.5 then
			fps = frames / acc
			frames, acc = 0, 0
		end

		for plr, entry in pairs(mirrors) do
			if not plr.Parent or not wantsMirror(plr) or entry.char ~= plr.Character then
				dropMirror(entry)
				mirrors[plr] = nil
			end
		end

		local mirrored = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if wantsMirror(plr) then
				bindPlayer(plr)
				local char = plr.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local entry = mirrors[plr]
					if not entry then
						entry = makeMirror(char)
						mirrors[plr] = entry
					end
					entry.clone:PivotTo(hrp.CFrame)
					mirrored = mirrored + 1
				end
			end
		end

		appearAcc = appearAcc + dt
		if appearAcc >= (1 / APPEAR_CHECK_HZ) then
			appearAcc = 0
			local now = os.clock()
			for plr, entry in pairs(mirrors) do
				if plr.Character == entry.char and now >= entry.nextAppearCheck then
					entry.nextAppearCheck = now + 0.5
					if attemptCount(plr, entry.char) < APPEAR_MAX_REBUILDS
						and needsRebuild(entry.char, entry.clone) then
						forceRebuild(plr)
					end
				end
			end
		end

		animAcc = animAcc + dt
		if animAcc >= (1 / ANIM_HZ) then
			animAcc = 0
			for plr, entry in pairs(mirrors) do
				if plr.Character == entry.char then
					syncAnimations(entry, entry.char)
				end
			end
		end

		local tchar = pipTarget.Character
		local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
		if not thrp then
			label.Text = pipTarget.Name .. " | no character"
			return
		end

		-- PiP turn modes (mutually exclusive): enemy lock wins, run-follow otherwise.
		if pipCfg.enemyLock then
			enemyAcc = enemyAcc + dt
			if enemyAcc >= (1 / ENEMY_SCAN_HZ) then
				enemyAcc = 0
				local found, dist = scanEnemies(thrp.Position)
				pipEnemy, pipEnemyDist = found, dist or 0
			end
			if pipEnemy then
				local ec = pipEnemy.Character
				local ehrp = ec and ec:FindFirstChild("HumanoidRootPart")
				local ehum = ec and ec:FindFirstChildOfClass("Humanoid")
				if ehrp and ehum and ehum.Health > 0 then
					local flat = ehrp.Position - thrp.Position
					flat = Vector3.new(flat.X, 0, flat.Z)
					if flat.Magnitude > 0.5 then
						pipEnemyYaw = math.atan2(-flat.X, -flat.Z)
					end
				end
			end
			if pipEnemyYaw then
				local delta = (pipEnemyYaw - yaw + math.pi) % (2 * math.pi) - math.pi
				local step = AUTO_YAW_RATE * dt
				yaw = yaw + math.clamp(delta, -step, step)
			end
		elseif pipCfg.autoturn then
			local flat = Vector3.zero
			local hum = tchar:FindFirstChildOfClass("Humanoid")
			local md = hum and hum.MoveDirection or Vector3.zero
			flat = Vector3.new(md.X, 0, md.Z)
			if flat.Magnitude < 0.05 then
				-- MoveDirection is not always replicated for other players; fall back
				-- to the actual horizontal velocity while they are really moving.
				local v = thrp.AssemblyLinearVelocity
				flat = Vector3.new(v.X, 0, v.Z)
				if flat.Magnitude < 8 then flat = Vector3.zero end
			end
			if flat.Magnitude > 0.05 then
				flat = flat.Unit
				local look = thrp.CFrame.LookVector
				local lookFlat = Vector3.new(look.X, 0, look.Z)
				if lookFlat.Magnitude > 0.01 and lookFlat.Unit:Dot(flat) > 0.35 then
					pipAutoYaw = math.atan2(-flat.X, -flat.Z)
				end
			end
			if pipAutoYaw then
				local delta = (pipAutoYaw - yaw + math.pi) % (2 * math.pi) - math.pi
				local step = AUTO_YAW_RATE * dt
				yaw = yaw + math.clamp(delta, -step, step)
			end
		end

		if worldFull then
			if os.clock() - snapAt >= 10 then
				snapAt = os.clock()
				pcall(checkFullWorld)
			end
		else
			local needSnap = snapCenter == nil
			if not needSnap and (thrp.Position - snapCenter).Magnitude > SNAP_REFRESH_DIST then
				needSnap = (os.clock() - snapAt) >= SNAP_MIN_INTERVAL
			end
			if needSnap then
				pcall(snapshotWorld, thrp.Position, WORLD_RADIUS, WORLD_BUDGET)
				snapCenter = thrp.Position
				snapAt = os.clock()
			end
		end

		local focus = thrp.Position + Vector3.new(0, LOOK_AT_Y, 0)
		local cp = math.cos(pitch)
		local dir = Vector3.new(math.sin(yaw) * cp, math.sin(pitch), math.cos(yaw) * cp)
		cam.CFrame = CFrame.lookAt(focus + dir * camDist, focus)

		if pipCfg.enemyLock then
			if pipEnemy then
				label.Text = string.format("%s  >>  %s (%.0f)", pipTarget.Name, pipEnemy.Name, pipEnemyDist)
			else
				label.Text = pipTarget.Name .. "  >>  no enemy"
			end
		else
			label.Text = string.format("SPECTATING %s  |  %d chars  |  %.1f  |  %.0f fps",
				pipTarget.Name, mirrored, camDist, fps)
		end
	end))
end)()

-- ====================== AUTOINFINITY ======================
-- Loads PiggyHub/Database.json once, builds a whitelist of move-trigger anim
-- ids (the anim present in ~every sample of each move), then constantly scans
-- enemy animators. When a whitelisted move is detected, presses 4 (Infinity).
-- Auto-Infinity caches + tuning (bundled for register headroom)
aiState = {
	anims = {}, -- was autoInfinityAnims
	recent = {}, -- was autoInfinityRecent
	recentMove = {}, -- was autoInfinityRecentMove
	scheduled = {}, -- was autoInfinityScheduled
	proj = {}, -- was autoInfinityProj
	rush = {}, -- was autoInfinityRush
	counterMoves = {}, -- was autoInfinityCounterMoves
	lead = 0.4, -- was AUTOINFINITY_LEAD
	rushLead = 0.4, -- was AUTOINFINITY_RUSH_LEAD
	margin = 0.16, -- was AUTOINFINITY_MARGIN
	rayRadius = 40, -- was autoInfinityRayRadius
	lookSensitivity = 0.5, -- was autoInfinityLookSensitivity
}

-- AutoInfinity-local teammate check (mirrors the main isTeammate helper but
-- defined before the AutoInfinity heartbeat, which runs earlier in the file).
local function aiIsTeammate(player)
	if LocalPlayer.Neutral or player.Neutral then
		return false
	end
	if not LocalPlayer.Team or not player.Team then
		if LocalPlayer.TeamColor == player.TeamColor then return true end
		return false
	end
	return LocalPlayer.Team == player.Team or LocalPlayer.TeamColor == player.TeamColor
end
local function pressInfinityKey()
	if autoInfinityUnlocked and UserInputService:IsKeyDown(Enum.KeyCode.F) then
		-- "Infinity unblock": drop the guard first so Infinity isn't
		-- swallowed while we're holding block, then fire 4 after the
		-- block physics drops (mirrors AutoCounter's unblock-then-M1).
		blockingState = false
		scriptFUp()
		task.spawn(function()
			task.wait(0.06)
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Four, false, game)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Four, false, game)
		end)
		return
	end
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Four, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Four, false, game)
end

local function autoInfinityLoadDatabase()
	aiState.anims = {}
	aiState.recent = {}
	aiState.counterMoves = {}
	if not readfile or not isfile then return false, "no readfile" end
	if not isfile("PiggyHub/Database.json") then return false, "no Database.json" end
	local ok, data = pcall(readfile, "PiggyHub/Database.json")
	if not ok or not data or data == "" then return false, "empty file" end
	local okd, db = pcall(HttpService.JSONDecode, HttpService, data)
	if not okd or type(db) ~= "table" or type(db.profiles) ~= "table" then
		return false, "bad JSON"
	end
	local count = 0
	local function whitelistAnim(idNum, charName, moveName, gate)
		-- same anim id can be owned by several chars (ABA reuses assets); merge
		local existing = aiState.anims[idNum]
		if existing then
			existing.chars[charName] = true
		else
			gate.chars = { [charName] = true }
			aiState.anims[idNum] = gate
		end
		if not aiState.counterMoves[charName] then aiState.counterMoves[charName] = {} end
		aiState.counterMoves[charName][moveName] = true
		count = count + 1
	end
	for charName, moves in pairs(db.profiles) do
		for moveName, prof in pairs(moves) do
			-- range gate: only whitelist moves whose captured reach is known and
			-- which have enough samples (a 1-sample move whitelists every anim,
			-- e.g. Run/Jump, at freq 1.0 and would false-trigger Infinity).
local reach = prof.range
				local enough = type(prof.sampleCount) == 'number' and prof.sampleCount >= 2
				if type(reach) ~= 'number' or reach <= 0 or not enough then do end
				else
					-- projectile timing data (used by the timed trigger): model
					-- type, launch windup and travel speed. Only "proj"/"rush"
					-- measure speed; fixed (melee) moves have no flight time.
					local pModel, pSpeed, pLaunch = prof.model, prof.speed, prof.launchDelay
					if pModel ~= "proj" and pModel ~= "rush" then pSpeed, pLaunch = nil, nil end
					-- Captured move windup. For scheduling we use the MINIMUM windup
					-- (fastest observed move-start -> landed hit): an occasional late
					-- outlier sample drags the average up (e.g. ORA! avg 1.33 vs min
					-- 0.76) and schedules the press AFTER the move already landed.
					-- Pressing for the earliest hit keeps Infinity up before impact.
					local wStat = prof.windup
					local pWindup = (type(wStat) == "table" and type(wStat.min) == "number") and wStat.min
						or (type(wStat) == "table" and type(wStat.avg) == "number" and wStat.avg) or nil
					-- average windup kept separately: the hard cap for rush/proj ETAs
					-- (they move far, min would over-clamp and ignore real flight time).
					local pWindupAvg = (type(wStat) == "table" and type(wStat.avg) == "number") and wStat.avg or pWindup
				local best = nil
				for _, a in ipairs(prof.anims or {}) do
					local idNum = (a.id and tostring(a.id):match("%d+")) or ""
					-- ABA move-trigger anims are named "Animation"; locomotion /
					-- idle anims (Run, jump, Jump, ...) get descriptive names and
					-- must never be whitelisted (they'd false-trigger Infinity).
					local aName = tostring(a.name or "")
					if idNum ~= "" and aName == "Animation" then
						local freq = a.freq or 0
						if not best or freq > (best.freq or 0) then best = { idNum = idNum, freq = freq } end
						if freq >= 0.9 and not aiState.anims[idNum] then
							whitelistAnim(idNum, charName, moveName, { move = moveName, range = reach, model = pModel, speed = pSpeed, launchDelay = pLaunch, windup = pWindup, windupAvg = pWindupAvg })
						end
					end
				end
				-- fallback: no >=0.9 "Animation" anim, use the most frequent
				-- "Animation"-named one (only if confidently the move's anim)
				if best and best.freq >= 0.5 then
					whitelistAnim(best.idNum, charName, moveName, { move = moveName, range = reach, model = pModel, speed = pSpeed, launchDelay = pLaunch, windup = pWindup, windupAvg = pWindupAvg })
				end
			end
		end
	end
	do end
	return count > 0
end

table.insert(connections, RunService.Heartbeat:Connect(function()
	if not autoInfinityEnabled then return end
	local now = os.clock()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and teamCheckEnabled and aiIsTeammate(player) then continue end
		if player ~= LocalPlayer then
			local char = player.Character
			if char and char.Parent then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if animator then
					local enemyRoot = char:FindFirstChild("HumanoidRootPart")
					local enemyBase = player:GetAttribute("SpawnChar") or (char.GetAttribute and char:GetAttribute("SpawnChar"))
					local enemyOwned = enemyBase and (enemyBase .. " [Awakening]")
					local dist = (myRoot and enemyRoot) and math.floor((enemyRoot.Position - myRoot.Position).Magnitude * 10) / 10 or nil
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						local anim = track.Animation
						if anim and track.IsPlaying then
							local idNum = (tostring(anim.AnimationId):match("%d+")) or ""
							local gate = idNum ~= "" and aiState.anims[idNum] or nil
							-- anim ids are shared across characters (ABA reuses assets),
							-- so only fire if THIS enemy owns the move the anim was captured for
							if gate and enemyBase then
								if not (gate.chars[enemyBase] or gate.chars[enemyOwned]) then
									gate = nil
								end
							end
							if gate then
								local last = aiState.recent[idNum] or 0
								-- projectile moves schedule a press at time-to-impact; melee/
								-- fixed moves (no speed) counter immediately. Re-fire is
								-- allowed every 1.5s per move.
								local lastMove = aiState.recentMove[player.Name .. "::" .. gate.move] or 0
								if now - last >= 1.2 and now - lastMove > 1.5 then
									aiState.recent[idNum] = now
									aiState.recentMove[player.Name .. "::" .. gate.move] = now
									if dist and dist <= gate.range + 2 then
										if gate.model == "rush" then
											-- Dash moves run toward the player, so the enemy's facing
											-- IS the travel direction. Ray-pass against that.
											local origin = enemyRoot.Position
											local aimDir = enemyRoot.CFrame.LookVector
											local delta = myRoot.Position - origin
											local along = delta:Dot(aimDir)
											local closest = origin + aimDir * along
											local miss = (myRoot.Position - closest).Magnitude
											if along > 0 and miss <= aiState.rayRadius then
local flight = gate.speed and gate.speed > 0 and (along / gate.speed) or 0
											local eta = (gate.launchDelay or 0) + flight
											-- Dash moves (e.g. Detroit Smash) close distance on their own; a
											-- mis-fit tiny speed would inflate flight far past reality. The
											-- captured windup is the measured time-to-impact — cap by it.
											if gate.windupAvg and eta > gate.windupAvg then eta = gate.windupAvg end
												if eta - aiState.rushLead < aiState.margin then
													-- Dash too imminent to schedule a timed lead press: press
													-- Infinity NOW so it's up before the dash lands (e.g. close
													-- Detroit Smash where launchDelay fills almost the whole ETA).
													do end
													pressInfinityKey()
												else
													local entry = {
															at = now + math.max(eta - aiState.lead - aiState.rushLead, 0),
															move = gate.move,
															id = idNum,
															player = player.Name,
															est = eta,
															cancelled = false,
														}
														table.insert(aiState.scheduled, entry)
														-- register for the velocity confirm/cancel tracker below
														aiState.rush[player.Name] = {
															pos = origin,
															prev = origin,
															t0 = now,
															entry = entry,
														}
														do end
													end
											else do end
											end
										elseif gate.model == "proj" then
											-- Projectile: schedule the press IMMEDIATELY at anim-start for fast
											-- reaction, but only when the enemy's body is actually facing us
											-- (cheap early gate). That blocks the common "fired the other way"
											-- false trigger without waiting on the beam and losing the reaction
											-- window. The beam tracker below still CANCELS the press if the real
											-- beam is mouse-aimed away (body faces us but muzzle goes up/side).
											local projLookSens = (enemyRoot and myRoot)
												and (enemyRoot.CFrame.LookVector):Dot((myRoot.Position - enemyRoot.Position).Unit) or 0
											if projLookSens < aiState.lookSensitivity then do end
											else
local pSpeed = gate.speed or 0
											local tSpeed = pSpeed > 0 and pSpeed or 40
											local travelGuess = dist and (dist / tSpeed) or 0
											local eta = (gate.launchDelay or 0) + travelGuess
											-- A dash/beam sample mis-fit as a slow projectile (tiny fitted speed)
											-- inflates travelGuess way past the real time-to-impact. The captured
											-- windup (move-start -> landed health-drop) IS the measured impact
											-- ETA; never schedule slower than it.
											if gate.windupAvg and eta > gate.windupAvg then eta = gate.windupAvg end
												if eta < aiState.margin then do end
												else
													local entry = {
														at = now + math.max(eta - aiState.lead, 0),
														move = gate.move,
														id = idNum,
														player = player.Name,
														est = travelGuess,
														cancelled = false,
													}
													table.insert(aiState.scheduled, entry)
													aiState.proj[player.Name] = {
														start = now,
														flight = eta,
														id = idNum,
														move = gate.move,
														entry = entry,
														confirmed = false,
													}
												end
											end
										else
											-- Fixed (melee/AoE) move: counter only if the enemy is actually
											-- looking at us (facing dot >= look sensitivity), so a
											-- side/back swing can't eat the counter while they miss.
											-- Timing: the captured windup IS the time-to-impact ETA (fixed
											-- moves have no flight speed). Long windups schedule the press
											-- so Infinity comes out just before impact instead of instantly;
											-- short windups (fast melee) still press immediately, since
											-- waiting would leave too little time for Infinity to activate.
											local aimDir = enemyRoot.CFrame.LookVector
											local toUs = (myRoot.Position - enemyRoot.Position).Unit
											local facing = aimDir:Dot(toUs)
											if facing >= aiState.lookSensitivity then
												local eta = gate.windup or 0
												if eta > aiState.lead + aiState.margin then
													local entry = {
														at = now + math.max(eta - aiState.lead, 0),
														move = gate.move,
														id = idNum,
														player = player.Name,
														est = eta,
														cancelled = false,
													}
													table.insert(aiState.scheduled, entry)
													do end
												else do end
													pressInfinityKey()
												end
											else do end
											end
										end
									else do end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end))

-- Projectile tracker: reads the ACTUAL thrown parts in Workspace.Thrown and uses
-- the beam's real line (muzzle -> FARTHEST beam part) for the ray-pass. The anim
-- heartbeat only confirms a proj move started; the AIM/direction is taken from
-- the real part here, so a beam fired at the ceiling (mouse-aimed while the body
-- faces us) won't falsely trigger — its beam points up, away from us. Using the
-- farthest part from the muzzle gives a long, stable direction baseline; a part
-- sitting at/near the muzzle has a short vector whose .Unit jitters and would
-- make even a head-on shot look "out of zone".
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local thrown = Workspace:FindFirstChild("Thrown")
	if not (myRoot and thrown) then return end
	local now = os.clock()
	local myPos = myRoot.Position

	-- prune trackers whose parts are gone (no beam ever confirmed/concurremd)
	for name, info in pairs(aiState.proj) do
		if now - info.start > 2.5 then
			aiState.proj[name] = nil
		end
	end

	-- pass 1: for each enemy with a pending proj move, find the FARTHEST beam
	-- part attributed to its muzzle (longest baseline = true beam line)
	local far = {}               -- muzzleHRP -> { farPos = Vector3, farD = number }
	for _, inst in ipairs(thrown:GetDescendants()) do
		if not inst:IsA("BasePart") or not inst.Parent then continue end
		local pos = inst.Position
		local muzzle, bestD = nil, math.huge
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= LocalPlayer then
				local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp.Parent then
					local d = (hrp.Position - pos).Magnitude
					if d < bestD then muzzle, bestD = hrp, d end
				end
			end
		end
		if muzzle and bestD <= 90 then
			local eChar = muzzle.Parent
			local ePlayer = eChar and Players:GetPlayerFromCharacter(eChar)
			if ePlayer and aiState.proj[ePlayer.Name] then
				local f = far[muzzle]
				local dM = (pos - muzzle.Position).Magnitude
				if not f or dM > f.farD then far[muzzle] = { farPos = pos, farD = dM } end
			end
		end
	end

	-- pass 2: ray-pass once per muzzle from the beam line
	for muzzle in pairs(far) do
		local eChar = muzzle.Parent
		local ePlayer = eChar and Players:GetPlayerFromCharacter(eChar)
		if ePlayer then
			local info = aiState.proj[ePlayer.Name]
			if info and (now - info.start) < 2.5 then
				local muzzlePos = muzzle.Position
				local mDelta = myPos - muzzlePos
				-- The aim is the shooter's BODY facing: with lock-on it's
				-- deterministic and identical at every range, which is exactly
				-- what we want the press decision tied to. The far Thrown part
				-- direction was flapping between random projectiles and muzzle
				-- pieces, so it must NOT veto a clean aim read.
				local look = muzzle.CFrame.LookVector
				local alongM = mDelta:Dot(look)            -- studs from muzzle along aim
				local closestM = muzzlePos + look * alongM
				local missM = (myPos - closestM).Magnitude -- studs off the aim ray
				local cancels = missM > aiState.rayRadius or alongM < -4
				if info.entry then info.entry.cancelled = cancels end
				do end
				aiState.proj[ePlayer.Name] = nil   -- consumed
			end
		end
	end
end))

-- Rush confirm/cancel tracker: dashes track a target (often the nearest, not the
-- facing), so a LookVector ray at anim-start can be a false positive when a nearby
-- teammate is the actual target. This samples the enemy's REAL displacement over a
-- couple frames, derives a velocity direction, and ray-passes it against our own
-- position — cancelling the scheduled press if the dash is actually flying at
-- someone else (or off toward a teammate).
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local now = os.clock()
	-- prune stalls (no movement, enemy was never tracked or dash over)
	for name, info in pairs(aiState.rush) do
		if info.entry.cancelled or (now - info.t0) > 2.5 then aiState.rush[name] = nil end
	end
	for name, info in pairs(aiState.rush) do
		local pl = Players:FindFirstChild(name)
		local eChar = pl and pl.Character
		local eRoot = eChar and eChar.Parent and eChar:FindFirstChild("HumanoidRootPart")
		if not (eRoot and eRoot.Parent) then
			aiState.rush[name] = nil
		else
			local cur = eRoot.Position
			local dx = cur - info.prev
			info.vel = (info.vel or Vector3.zero) * 0.5 + dx * 0.5  -- smoothed velocity
			info.prev = cur
			-- need enough cumulative travel for a stable direction baseline
			local traveled = (cur - info.pos).Magnitude
			if traveled >= 4 and info.vel.Magnitude > 0.5 and now - info.t0 >= 0.05 then
				local diru = info.vel.Unit
				local origin = info.pos
				local delta = myRoot.Position - origin
				local along = delta:Dot(diru)
				local closest = origin + diru * along
				local miss = (myRoot.Position - closest).Magnitude
				local cancels = along <= 0 or miss > aiState.rayRadius
				info.entry.cancelled = cancels
				do end
				aiState.rush[name] = nil  -- decided
			end
		end
	end
end))

-- Scheduled time-of-impact executor: fires the timed Infinity presses that
-- projectile/rush moves scheduled from the anim heartbeat. A polling loop
-- (instead of task.delay) keeps ordering deterministic and prunes stale ones.
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	if #aiState.scheduled == 0 then return end
	local now = os.clock()
	local keep = {}
	for _, sched in ipairs(aiState.scheduled) do
		if sched.cancelled then
			-- beam confirmed aimed away -> never press, drop immediately
		elseif now >= sched.at then do end
			pressInfinityKey()
		else
			keep[#keep + 1] = sched
		end
	end
	aiState.scheduled = keep
end))

