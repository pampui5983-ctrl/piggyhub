        dropList.Visible = not dropList.Visible
    end)
    refreshSlotText()
    settingsRefs.triggerbotSlot = {
        Set = function(val)
            if type(val) == "number" and val >= 1 and val <= 4 then
                triggerbotSlot = math.floor(val)
                refreshSlotText()
            end
        end
    }
end

