-- ====================== PLAYER PIP ======================
-- ViewportFrame "spectator": mirrors the selected player, the players standing
-- near them and the static geometry around them into a small draggable window.
--   drag near an edge -> move the window
--   drag in the middle-> orbit the PiP camera (cursor is pinned for the drag)
--   mouse wheel       -> zoom the PiP camera in / out
-- Roblox only renders workspace.CurrentCamera for the real world and a
-- ViewportFrame renders only its own descendants, hence the clones.
;(function()
	local UIS = UserInputService
	local RS = RunService

	local WINDOW_W, WINDOW_H = pipCfg.winW, pipCfg.winH
	local MIN_WIN_W, MIN_WIN_H = 180, 110
	local RESIZE_GRIP = 20
	local MARGIN, TOP_SAFE = 18, 58
	local CAM_DIST_MIN, CAM_DIST_MAX = 3.5, 45
	local ORBIT_SENS, ZOOM_STEP = 0.007, 0.12
	local EDGE_MARGIN, LOOK_AT_Y = 26, 1.2
	local WORLD_RADIUS, WORLD_BUDGET = 160, 800
	local WORLD_FULL_BUDGET = 4000 -- maps with fewer parts than this are mirrored whole
	local SNAP_REFRESH_DIST, SNAP_MIN_INTERVAL = 45, 1.2
	local ANIM_HZ, ANIM_DRIFT = 15, 0.10
	local APPEAR_CHECK_HZ, APPEAR_MAX_REBUILDS = 2, 4
	local MIRROR_NEARBY_DIST = 90
	local AUTO_YAW_RATE = 9.0 -- rad/s the PiP view swings toward the target's run direction / locked enemy
	local ENEMY_RANGE = 300 -- studs, max distance for the enemy lock
	local ENEMY_SCAN_HZ = 10 -- enemy re-scan rate
	local DEFAULT_GREY = Color3.fromRGB(163, 162, 165)

	-- drop a window left behind by an earlier run of this file / the prototype
	do
		local old = parentGui:FindFirstChild("PiggyPiP")
		if old then pcall(function() old:Destroy() end) end
		pcall(function()
			local stop = getgenv and getgenv().__pipStop
			if type(stop) == "function" then stop() end
		end)
	end

	local pipTarget
	local camDist = 12
	local yaw, pitch = 0, math.rad(22)
	local pipAutoYaw = nil -- last forward-run heading (radians) the view swings to
	local pipEnemy = nil -- Player the enemy lock is currently watching
	local pipEnemyYaw = nil -- heading (radians) toward that enemy
	local pipEnemyDist = 0
	local enemyAcc = 0
	local mirrors, attempts, playerConns = {}, {}, {}
	local snapCenter, snapAt = nil, 0
	local worldFull = false
	local mapPartCount = 0
	local rebuilding, scanBusy = false, false
	local animAcc, appearAcc = 0, 0
	local fps, frames, acc = 0, 0, 0
	local placed = false
	local dragMode, dragStart, dragOrigin, resizeStart

	-- forward handles (assigned below, called by the tab controls / unload)
	local applyEnabled, refreshButton, refreshPlayerList, setTarget

	-- window chrome --------------------------------------------------------
