local antiBanToggleRef = createToggle(tbContainer, "Anti Ban", 240, antiBanEnabled, function(state)
	local wasEnabled = antiBanEnabled
	antiBanEnabled = state
	if state then
		antiBanCharacters = {}
		if antiBanBoxRef[1].Text ~= "" then antiBanCharacters[#antiBanCharacters+1] = antiBanBoxRef[1].Text end
		antiBanCharIdx = 1
		antiBanPhase = "ban"
		antiBanActioned = false
		antiBanCooldown = 0
		antiBanPageIdx = 0
		antiBanPages = {}
	end
	autoSaveSettings()
end)
settingsRefs.antiBanEnabled = antiBanToggleRef
antiBanToggleRef.Switch.Parent.Visible = false

local searchPageIdx = 0
local searchPagesList = {}
local banCooldown = 0
local lastBanChooserAvail = false

local function getPageFrames(chars)
	local pages = {}
	for _, p in chars:GetChildren() do
		if p:IsA("Frame") and p.Name:find("Page") then
			table.insert(pages, p)
		end
	end
	return pages
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	if not targetBanEnabled and not antiBanEnabled then return end
	local bcAvail = PlayerGui:FindFirstChild("BanChooser")
	bcAvail = bcAvail and bcAvail.Enabled
	if bcAvail and not lastBanChooserAvail then
		if targetBanEnabled and #targetBanCharacters > 0 and banActioned then
			banActioned = false; targetBanCharIdx = 1; lastBannedChars = {}
			searchPagesList = {}; searchPageIdx = 0; banCooldown = 0
		end
		if antiBanEnabled and #antiBanCharacters > 0 and antiBanActioned then
			antiBanActioned = false; antiBanCharIdx = 1; antiBanPhase = "ban"
			antiBanPages = {}; antiBanPageIdx = 0; antiBanCooldown = 0
		end
	end
	lastBanChooserAvail = bcAvail

	local ok, err = pcall(function()
		if not targetBanEnabled then return end
		if #targetBanCharacters == 0 then return end
		if banActioned then return end
		if banCooldown > 0 then banCooldown = banCooldown - 1 return end

		while targetBanCharIdx <= #targetBanCharacters do
			local n = targetBanCharacters[targetBanCharIdx]:lower()
			local skip = false
			for _, b in lastBannedChars do
				if b:lower() == n then skip = true break end
			end
			if not skip then break end
			targetBanCharIdx = targetBanCharIdx + 1
		end
		if targetBanCharIdx > #targetBanCharacters then
			banActioned = true
			return
		end

		local searchName = targetBanCharacters[targetBanCharIdx]:lower()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if not bc or not bc.Enabled then return end
		local cs = bc:FindFirstChild("CharacterSelect")
		if not cs then return end
		local chars = cs:FindFirstChild("Characters")
		if not chars then return end

		if #searchPagesList == 0 then
			searchPagesList = getPageFrames(chars)
		end
		if #searchPagesList == 0 then return end

		local btn
		for _, p in searchPagesList do
			if not p.Visible then continue end
			for _, cat in p:GetChildren() do
				if not cat:IsA("Frame") then continue end
				local slots = cat:FindFirstChild("Slots")
				if not slots then continue end
				for _, b in slots:GetChildren() do
					if not b:IsA("ImageButton") then continue end
					local n = b.Name:lower()
					if n == searchName or n:find(searchName, 1, true) then
						btn = b
						break
					end
				end
				if btn then break end
			end
			if btn then break end
		end

		if btn then
			if clickBanButton(btn) then
				table.insert(lastBannedChars, btn.Name)
				targetBanCharIdx = targetBanCharIdx + 1
				searchPageIdx = 0
				searchPagesList = {}
				banCooldown = 30
				do end
			end
			return
		end

		if searchPageIdx > #searchPagesList then
			targetBanCharIdx = targetBanCharIdx + 1
			searchPageIdx = 0
			searchPagesList = {}
			do end
			return
		end
		if searchPageIdx < #searchPagesList then
			searchPageIdx = searchPageIdx + 1
		end
		for i, p in ipairs(searchPagesList) do
			p.Visible = (i == searchPageIdx)
		end
	end)
	if not ok then do end
	end

	local ok2, err2 = pcall(function()
		if not antiBanEnabled then return end
		if antiBanActioned then return end
		if targetBanEnabled and not banActioned then return end
		if #antiBanCharacters == 0 then return end
		if antiBanCooldown > 0 then antiBanCooldown = antiBanCooldown - 1 return end

		local searchName = antiBanCharacters[1]:lower()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if not bc or not bc.Enabled then return end
		local cs = bc:FindFirstChild("CharacterSelect")
		if not cs then return end
		local chars = cs:FindFirstChild("Characters")
		if not chars then return end

		if #antiBanPages == 0 then
			antiBanPages = getPageFrames(chars)
		end
		if #antiBanPages == 0 then return end

		local btn
		for _, p in antiBanPages do
			if not p.Visible then continue end
			for _, cat in p:GetChildren() do
				if not cat:IsA("Frame") then continue end
				local slots = cat:FindFirstChild("Slots")
				if not slots then continue end
				for _, b in slots:GetChildren() do
					if not b:IsA("ImageButton") then continue end
					local n = b.Name:lower()
					if n == searchName or n:find(searchName, 1, true) then
						btn = b
						break
					end
				end
				if btn then break end
			end
			if btn then break end
		end

		if btn then
			if clickBanButton(btn) then
				if antiBanPhase == "ban" then
					antiBanPhase = "unban"
					antiBanCooldown = 30
					antiBanPageIdx = 0
					antiBanPages = {}
					do end
				else
					antiBanActioned = true
					antiBanPhase = "ban"
					antiBanPageIdx = 0
					antiBanPages = {}
					do end
				end
			end
		elseif antiBanPageIdx >= #antiBanPages then do end
			antiBanActioned = true
			antiBanPageIdx = 0
			antiBanPages = {}
		else
			antiBanPageIdx = antiBanPageIdx + 1
			for i, p in ipairs(antiBanPages) do
				p.Visible = (i == antiBanPageIdx)
			end
		end
	end)
	if not ok2 then do end
	end
end))

