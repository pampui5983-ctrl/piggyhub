-- Hollow Purple chain core (ported from hollow_purple.luau). Single persistent
-- Thrown listener, armed once here; the toggle only gates steering.
local function hpLivingDummiesNear(pos, radius)
	-- NOTE: retargeted to live PLAYERS (was dummies). Shared by Hollow Purple
	-- and Spirit Gun chains, so both toggles now chain across players.
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		-- Inline team check (isTeammate is defined later in the file, so we
		-- can't call it from here without a forward declaration).
		if teamCheckEnabled then
			local teammate = false
			pcall(function()
				if not (LocalPlayer.Neutral or player.Neutral) then
					if LocalPlayer.Team and player.Team then
						teammate = (LocalPlayer.Team == player.Team or LocalPlayer.TeamColor == player.TeamColor)
					else
						teammate = (LocalPlayer.TeamColor == player.TeamColor)
					end
				end
			end)
			if teammate then continue end
		end
		local m = player.Character
		if m then
			local hrp = m:FindFirstChild("HumanoidRootPart")
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - pos).Magnitude
				if d < radius then
					list[#list + 1] = { model = m, dist = d }
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

local function hpBallSize(c)
	local s = 0
	pcall(function()
		if c:IsA("BasePart") then
			local sz = c.Size
			s = math.max(sz.X, sz.Y, sz.Z)
		end
	end)
	return s
end

local function hpZeroMovers(c)
	pcall(function()
		local bv = c:FindFirstChildOfClass("BodyVelocity")
		if bv then bv.Velocity = Vector3.new(0, 0, 0) end
		local lv = c:FindFirstChildOfClass("LinearVelocity")
		if lv then lv.VectorVelocity = Vector3.new(0, 0, 0) end
		local vf = c:FindFirstChildOfClass("VectorForce")
		if vf then vf.Force = Vector3.new(0, 0, 0) end
		if c:IsA("BasePart") and not c.Anchored then
			c.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			c.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end)
end

task.spawn(function()
	-- Deferred (NOT tracked in connections: task.spawn returns a thread, and
	-- the unload drain indexes .Connected unprotected) so a slow-replicating
	-- Thrown can't break script boot. The ChildAdded hook below IS tracked.
	local thrown = workspace:FindFirstChild("Thrown") or workspace:WaitForChild("Thrown", 15)
	if not thrown then return end
	table.insert(connections, thrown.ChildAdded:Connect(function(c)
	if c.Name ~= "Ball" then return end
	if not chainState.hpEnabled then return end
	if hpBallSize(c) < chainState.hpMinSize then return end
	local char = LocalPlayer.Character
	local hrp0 = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp0 then return end
	local near = false
	pcall(function()
		near = (c.Position - hrp0.Position).Magnitude < chainState.hpOwnRadius
	end)
	if not near then return end
	task.spawn(function()
		task.wait(chainState.hpArmDelay)
		if not c.Parent then return end
		local list = hpLivingDummiesNear(c.Position, chainState.hpRadius)
		for _, entry in ipairs(list) do
			if not c.Parent then break end
			if not chainState.hpEnabled then break end
			pcall(function()
				local m = entry.model
				local hrp = m:FindFirstChild("HumanoidRootPart")
				local hum = m:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					c.CFrame = hrp.CFrame
					hpZeroMovers(c)
				end
			end)
			task.wait(chainState.hpDelay)
		end
		local RunService = game:GetService("RunService")
		local speed = 250
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if not c.Parent then conn:Disconnect() return end
			if not chainState.hpEnabled then conn:Disconnect() return end
			pcall(function()
				if c.Anchored then return end
				local target = hpLivingDummiesNear(c.Position, chainState.hpRadius)[1]
				if target then
					local tp = target.model.HumanoidRootPart.Position
					local dir = tp - c.Position
					if dir.Magnitude > 2 then
						hpZeroMovers(c)
						c.CFrame = CFrame.new(c.Position + dir.Unit * speed * 0.016, tp)
					end
				end
			end)
		end)
		task.delay(2, function() pcall(function() conn:Disconnect() end) end)
	end)
end))
end)

-- Spirit Gun chain core (ported from spirit_gun.luau). Same deferred-listener
-- shape as HP. Small Balls only (HP orbs are size > 8 and handled above);
-- both toggles can safely stay on together.
task.spawn(function()
	local thrown = workspace:FindFirstChild("Thrown") or workspace:WaitForChild("Thrown", 15)
	if not thrown then return end
	table.insert(connections, thrown.ChildAdded:Connect(function(c)
	if c.Name ~= "Ball" then return end
	if not chainState.sgEnabled then return end
	if hpBallSize(c) >= chainState.sgMaxSize then return end
	local char = LocalPlayer.Character
	local hrp0 = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp0 then return end
	local near = false
	pcall(function()
		near = (c.Position - hrp0.Position).Magnitude < chainState.sgOwnRadius
	end)
	if not near then return end
	task.spawn(function()
		task.wait(chainState.sgArmDelay)
		if not c.Parent then return end
		local bv = c:FindFirstChildOfClass("BodyVelocity")
		if bv then
			pcall(function()
				bv.MaxForce = Vector3.new(400000, 400000, 400000)
			end)
		end
		local speed = 180
		pcall(function()
			if bv then speed = bv.Velocity.Magnitude end
		end)
		if speed < 50 then speed = 180 end
		local list = hpLivingDummiesNear(c.Position, chainState.sgRadius)
		for _, entry in ipairs(list) do
			if not c.Parent then break end
			if not chainState.sgEnabled then break end
			pcall(function()
				local m = entry.model
				local hrp = m:FindFirstChild("HumanoidRootPart")
				local hum = m:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					c.CFrame = hrp.CFrame
					local b2 = c:FindFirstChildOfClass("BodyVelocity")
					if b2 then b2.Velocity = Vector3.new(0, 0, 0) end
				end
			end)
			task.wait(chainState.sgDelay)
		end
		if c.Parent and bv and bv.Parent then
			local nt = hpLivingDummiesNear(c.Position, chainState.sgRadius)[1]
			if nt then
				pcall(function()
					bv.Velocity = ((nt.model.HumanoidRootPart.Position - c.Position).Unit) * speed
				end)
			else
				pcall(function()
					bv.Velocity = c.CFrame.LookVector * speed
				end)
			end
		end
		local RunService = game:GetService("RunService")
		local conn
		conn = RunService.Heartbeat:Connect(function()
			if not c.Parent then conn:Disconnect() return end
			if not chainState.sgEnabled then conn:Disconnect() return end
			pcall(function()
				local b3 = c:FindFirstChildOfClass("BodyVelocity")
				if not b3 then return end
				local target = hpLivingDummiesNear(c.Position, chainState.sgRadius)[1]
				if target then
					local tp = target.model.HumanoidRootPart.Position + Vector3.new(0, 1, 0)
					local dir = tp - c.Position
					if dir.Magnitude > 1 then
						b3.Velocity = dir.Unit * speed
					end
				end
			end)
		end)
		task.delay(6, function() pcall(function() conn:Disconnect() end) end)
	end)
end))
end)

