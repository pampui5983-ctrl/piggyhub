local labelDrag, labelDragStart, labelStartPos
table.insert(connections, counterLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		labelDrag = true
		labelDragStart = input.Position
		labelStartPos = counterLabel.Position
	end
end))
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if labelDrag and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - labelDragStart
		counterLabel.Position = UDim2.new(labelStartPos.X.Scale, labelStartPos.X.Offset + delta.X, labelStartPos.Y.Scale, labelStartPos.Y.Offset + delta.Y)
	end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then labelDrag = false end
end))

