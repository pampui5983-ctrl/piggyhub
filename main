local function makeTBBox(y, placeholder)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 28)
	container.Position = UDim2.new(0, 0, 0, y)
	container.BackgroundTransparency = 1
	container.Parent = tbContainer

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 28)
	box.Position = UDim2.new(0, 0, 0, 0)
	box.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
	box.Text = ""
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Color3.fromRGB(150, 150, 170)
	box.TextColor3 = Color3.fromRGB(230, 230, 240)
	box.TextSize = 12
	box.Font = Enum.Font.Gotham
	box.ClearTextOnFocus = false
	box.Parent = container
	local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0, 5) corner.Parent = box
	local stroke = Instance.new("UIStroke") stroke.Color = Color3.fromRGB(45, 8, 8) stroke.Thickness = 1 stroke.Parent = box

	local dropdown = Instance.new("Frame")
	dropdown.Size = UDim2.new(1, 0, 0, 140)
	dropdown.Position = UDim2.new(0, 0, 1, 0)
	dropdown.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
	dropdown.BorderSizePixel = 0
	dropdown.Visible = false
	dropdown.ZIndex = 10
	dropdown.Parent = container
	local ddCorner = Instance.new("UICorner") ddCorner.CornerRadius = UDim.new(0, 5) ddCorner.Parent = dropdown

	local ddList = Instance.new("ScrollingFrame")
	ddList.Size = UDim2.new(1, 0, 1, 0)
	ddList.BackgroundTransparency = 1
	ddList.BorderSizePixel = 0
	ddList.Parent = dropdown
	ddList.CanvasSize = UDim2.new(0, 0, 0, 0)
	ddList.ScrollBarThickness = 4
	ddList.ZIndex = 10

	local function updateDropdown()
		for _, child in ddList:GetChildren() do
			if child:IsA("TextButton") then child:Destroy() end
		end
		local text = box.Text:lower()
		local yPos = 0
		local matchCount = 0
		for _, name in charNameCache do
			if text == "" or name:lower():find(text, 1, true) then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 24)
				btn.Position = UDim2.new(0, 0, 0, yPos)
				btn.Text = name
				btn.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
				btn.TextColor3 = Color3.fromRGB(230, 230, 240)
				btn.TextSize = 12
				btn.Font = Enum.Font.Gotham
				btn.BorderSizePixel = 0
				btn.Parent = ddList
				btn.ZIndex = 10
				btn.MouseButton1Click:Connect(function()
					box.Text = name
					dropdown.Visible = false
					autoSaveSettings()
				end)
				btn.MouseEnter:Connect(function()
					btn.BackgroundColor3 = Color3.fromRGB(50, 48, 58)
				end)
				btn.MouseLeave:Connect(function()
					btn.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
				end)
				yPos = yPos + 24
				matchCount = matchCount + 1
			end
		end
		ddList.CanvasSize = UDim2.new(0, 0, 0, yPos)
		dropdown.Visible = matchCount > 0
		ddList.CanvasPosition = Vector2.new(0, 0)
	end

	box.Focused:Connect(function()
		updateDropdown()
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if dropdown.Visible then updateDropdown() end
	end)
	box.FocusLost:Connect(function()
		autoSaveSettings()
		task.delay(0.15, function()
			dropdown.Visible = false
		end)
	end)

	return box
end

targetBanBoxRefs[1] = makeTBBox(22, "Character 1")
targetBanBoxRefs[2] = makeTBBox(54, "Character 2")
targetBanBoxRefs[3] = makeTBBox(86, "Character 3")
targetBanBoxRefs[4] = makeTBBox(118, "Character 4")

local function unbanChar(name)
	local ok, err = pcall(function()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if bc then
			local comm = bc:FindFirstChild("Communicate")
			if comm and comm:IsA("RemoteEvent") then
				comm:FireServer(name)
				return true
			end
		end
	end)
	return ok
end

local targetBanToggleRef = createToggle(tbContainer, "Auto Ban Target", 150, targetBanEnabled, function(state)
	local wasEnabled = targetBanEnabled
	targetBanEnabled = state
	if state then
		targetBanCharacters = {}
		if targetBanBoxRefs[1].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[1].Text end
		if targetBanBoxRefs[2].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[2].Text end
		if targetBanBoxRefs[3].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[3].Text end
		if targetBanBoxRefs[4].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[4].Text end
		targetBanCharIdx = 1
		lastBannedChars = {}
		banActioned = false
		banCooldown = 0
	end
	if wasEnabled and not state and #lastBannedChars > 0 then
		for _, name in lastBannedChars do
			unbanChar(name)
			task.wait(0.15)
		end
	end
	autoSaveSettings()
end)
settingsRefs.targetBanEnabled = targetBanToggleRef

