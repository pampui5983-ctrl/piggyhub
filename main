local searchPageIdx = 0
local searchPagesList = {}
local banCooldown = 0
local lastBanChooserAvail = false

local function getPageFrames(chars)
	local pages = {}
	for _, p in chars:GetChildren() do
		if p:IsA("Frame") and p.Name:find("Page") then
			table.insert(pages, p)
		end
	end
	return pages
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	if not banState.targetEnabled and not banState.antiEnabled then return end
	local bcAvail = PlayerGui:FindFirstChild("BanChooser")
	bcAvail = bcAvail and bcAvail.Enabled
	if bcAvail and not lastBanChooserAvail then
		if banState.targetEnabled and #banState.targets > 0 and banState.targetActioned then
			banState.targetActioned = false; banState.targetIdx = 1; banState.lastBanned = {}
			searchPagesList = {}; searchPageIdx = 0; banCooldown = 0
		end
		if banState.antiEnabled and #banState.antiChars > 0 and banState.antiActioned then
			banState.antiActioned = false; banState.antiIdx = 1; banState.antiPhase = "ban"
			banState.antiPages = {}; banState.antiPageIdx = 0; banState.antiCooldown = 0
		end
	end
	lastBanChooserAvail = bcAvail

	local ok, err = pcall(function()
		if not banState.targetEnabled then return end
		if #banState.targets == 0 then return end
		if banState.targetActioned then return end
		if banCooldown > 0 then banCooldown = banCooldown - 1 return end

		while banState.targetIdx <= #banState.targets do
			local n = banState.targets[banState.targetIdx]:lower()
			local skip = false
			for _, b in banState.lastBanned do
				if b:lower() == n then skip = true break end
			end
			if not skip then break end
			banState.targetIdx = banState.targetIdx + 1
		end
		if banState.targetIdx > #banState.targets then
			banState.targetActioned = true
			return
		end

		local searchName = banState.targets[banState.targetIdx]:lower()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if not bc or not bc.Enabled then return end
		local cs = bc:FindFirstChild("CharacterSelect")
		if not cs then return end
		local chars = cs:FindFirstChild("Characters")
		if not chars then return end

		if #searchPagesList == 0 then
			searchPagesList = getPageFrames(chars)
		end
		if #searchPagesList == 0 then return end

		local btn
		for _, p in searchPagesList do
			if not p.Visible then continue end
			for _, cat in p:GetChildren() do
				if not cat:IsA("Frame") then continue end
				local slots = cat:FindFirstChild("Slots")
				if not slots then continue end
				for _, b in slots:GetChildren() do
					if not b:IsA("ImageButton") then continue end
					local n = b.Name:lower()
					if n == searchName or n:find(searchName, 1, true) then
						btn = b
						break
					end
				end
				if btn then break end
			end
			if btn then break end
		end

		if btn then
			if clickBanButton(btn) then
				table.insert(banState.lastBanned, btn.Name)
				banState.targetIdx = banState.targetIdx + 1
				searchPageIdx = 0
				searchPagesList = {}
				banCooldown = 30
				do end
			end
			return
		end

		if searchPageIdx > #searchPagesList then
			banState.targetIdx = banState.targetIdx + 1
			searchPageIdx = 0
			searchPagesList = {}
			do end
			return
		end
		if searchPageIdx < #searchPagesList then
			searchPageIdx = searchPageIdx + 1
		end
		for i, p in ipairs(searchPagesList) do
			p.Visible = (i == searchPageIdx)
		end
	end)
	if not ok then do end
	end

	local ok2, err2 = pcall(function()
		if not banState.antiEnabled then return end
		if banState.antiActioned then return end
		if banState.targetEnabled and not banState.targetActioned then return end
		if #banState.antiChars == 0 then return end
		if banState.antiCooldown > 0 then banState.antiCooldown = banState.antiCooldown - 1 return end

		local searchName = banState.antiChars[1]:lower()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if not bc or not bc.Enabled then return end
		local cs = bc:FindFirstChild("CharacterSelect")
		if not cs then return end
		local chars = cs:FindFirstChild("Characters")
		if not chars then return end

		if #banState.antiPages == 0 then
			banState.antiPages = getPageFrames(chars)
		end
		if #banState.antiPages == 0 then return end

		local btn
		for _, p in banState.antiPages do
			if not p.Visible then continue end
			for _, cat in p:GetChildren() do
				if not cat:IsA("Frame") then continue end
				local slots = cat:FindFirstChild("Slots")
				if not slots then continue end
				for _, b in slots:GetChildren() do
					if not b:IsA("ImageButton") then continue end
					local n = b.Name:lower()
					if n == searchName or n:find(searchName, 1, true) then
						btn = b
						break
					end
				end
				if btn then break end
			end
			if btn then break end
		end

		if btn then
			if clickBanButton(btn) then
				if banState.antiPhase == "ban" then
					banState.antiPhase = "unban"
					banState.antiCooldown = 30
					banState.antiPageIdx = 0
					banState.antiPages = {}
					do end
				else
					banState.antiActioned = true
					banState.antiPhase = "ban"
					banState.antiPageIdx = 0
					banState.antiPages = {}
					do end
				end
			end
		elseif banState.antiPageIdx >= #banState.antiPages then do end
			banState.antiActioned = true
			banState.antiPageIdx = 0
			banState.antiPages = {}
		else
			banState.antiPageIdx = banState.antiPageIdx + 1
			for i, p in ipairs(banState.antiPages) do
				p.Visible = (i == banState.antiPageIdx)
			end
		end
	end)
	if not ok2 then do end
	end
end))

