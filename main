local function getLockTorso()
	local char = lockedTarget and lockedTarget.Parent
	if not char then return nil end
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function refreshLockIndicator()
	local torso = (guiEnabled and active) and getLockTorso() or nil
	if torso then
		if lockIndicator.Adornee ~= torso then
			lockIndicator.Adornee = torso
		end
		lockIndicator.Enabled = true
	else
		lockIndicator.Enabled = false
		lockIndicator.Adornee = nil
	end
end

