-- Lock-on indicator: small red hollow ring pinned to the locked target's torso
-- (pure UI shapes, no font glyphs/assets, so it always renders). Parented to
-- screenGui so Unload UI destroys it automatically.
local lockIndicator = Instance.new("BillboardGui")
lockIndicator.Name = "PiggyLockIndicator"
lockIndicator.Size = UDim2.new(1.2, 0, 1.2, 0)
lockIndicator.StudsOffset = Vector3.new(0, 0, 0)
lockIndicator.AlwaysOnTop = true
lockIndicator.Enabled = false
lockIndicator.Parent = screenGui

do
    local lockRing = Instance.new("Frame")
    lockRing.Name = "Ring"
    lockRing.Size = UDim2.new(1, 0, 1, 0)
    lockRing.BackgroundTransparency = 1
    lockRing.Parent = lockIndicator
    addCorner(lockRing, UDim.new(1, 0))
    addStroke(lockRing, Color3.fromRGB(255, 50, 50), 2)
end

local function getLockTorso()
	local char = lockedTarget and lockedTarget.Parent
	if not char then return nil end
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function refreshLockIndicator()
	local torso = (guiEnabled and active) and getLockTorso() or nil
	if torso then
		if lockIndicator.Adornee ~= torso then
			lockIndicator.Adornee = torso
		end
		lockIndicator.Enabled = true
	else
		lockIndicator.Enabled = false
		lockIndicator.Adornee = nil
	end
end

