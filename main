        opt.MouseLeave:Connect(function()
            opt.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
        end)
    end

    dropBtn.MouseButton1Click:Connect(function()
        dropList.Visible = not dropList.Visible
    end)
    refreshSlotText()
    settingsRefs.triggerbot2Slot = {
        Set = function(val)
            if type(val) == "number" and val >= 1 and val <= 4 then
                tbState.slot2 = math.floor(val)
                refreshSlotText()
            end
        end
    }
end

