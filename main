-- Counter Status Label (right side, draggable)
local counterLabel = Instance.new("TextLabel")
counterLabel.Name = "CounterLabel"
counterLabel.Size = UDim2.new(0, 140, 0, 28)
counterLabel.Position = UDim2.new(1, 0, 0, 450)
counterLabel.AnchorPoint = Vector2.new(1, 0)
counterLabel.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
counterLabel.BackgroundTransparency = 0.15
counterLabel.BorderSizePixel = 0
counterLabel.Text = "COUNTER: OFF"
counterLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
counterLabel.TextSize = 15
counterLabel.Font = Enum.Font.GothamBold
counterLabel.TextXAlignment = Enum.TextXAlignment.Center
counterLabel.Parent = screenGui
addCorner(counterLabel, UDim.new(0, 6))

-- Drag state for the floating status labels. One shared table instead of six
-- top-level locals: the main chunk is tight against Luau's 200-local limit.
local labelDragState = {}
table.insert(connections, counterLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		labelDragState.counter = true
		labelDragState.counterFrom = input.Position
		labelDragState.counterOrig = counterLabel.Position
	end
end))
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if labelDragState.counter and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - labelDragState.counterFrom
		counterLabel.Position = UDim2.new(
			labelDragState.counterOrig.X.Scale, labelDragState.counterOrig.X.Offset + delta.X,
			labelDragState.counterOrig.Y.Scale, labelDragState.counterOrig.Y.Offset + delta.Y)
	end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then labelDragState.counter = false end
end))

local function updateCounterLabel()
	if autoCounterEnabled then
		counterLabel.Text = "COUNTER: ON"
		counterLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
	else
		counterLabel.Text = "COUNTER: OFF"
		counterLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	end
end
updateCounterLabel()

