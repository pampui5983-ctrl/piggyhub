	local name = configNameBox.Text
	if name and name ~= "" then
		ConfigManager.save(name)
		refreshConfigList()
		configNameBox.Text = ""
	end
end)

local configListFrame = Instance.new("Frame")
configListFrame.Size = UDim2.new(1, 0, 1, -50)
configListFrame.Position = UDim2.new(0, 0, 0, configY + 38)
configListFrame.BackgroundTransparency = 1
configListFrame.Parent = configTabFrame

local configListLayout = Instance.new("UIListLayout")
configListLayout.FillDirection = Enum.FillDirection.Vertical
configListLayout.SortOrder = Enum.SortOrder.Name
configListLayout.Padding = UDim.new(0, 6)
configListLayout.Parent = configListFrame

local function createConfigEntry(name)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 32)
	row.BackgroundTransparency = 1
	row.Parent = configListFrame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(0.5, -4, 1, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = name
	nameLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
	nameLabel.TextSize = 13
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = row

	local loadBtn = Instance.new("TextButton")
	loadBtn.Size = UDim2.new(0.25, -2, 0, 28)
	loadBtn.Position = UDim2.new(0.5, 2, 0.5, -14)
	loadBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 230)
	loadBtn.Text = "Load"
	loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	loadBtn.Font = Enum.Font.GothamBold
	loadBtn.TextSize = 11
	loadBtn.Parent = row
	local loadCorner = Instance.new("UICorner") loadCorner.CornerRadius = UDim.new(0, 6) loadCorner.Parent = loadBtn

	local deleteBtn = Instance.new("TextButton")
	deleteBtn.Size = UDim2.new(0.25, -2, 0, 28)
	deleteBtn.Position = UDim2.new(0.75, 4, 0.5, -14)
	deleteBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
	deleteBtn.Text = "Delete"
	deleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	deleteBtn.Font = Enum.Font.GothamBold
	deleteBtn.TextSize = 11
	deleteBtn.Parent = row
	local deleteCorner = Instance.new("UICorner") deleteCorner.CornerRadius = UDim.new(0, 6) deleteCorner.Parent = deleteBtn

	loadBtn.MouseButton1Click:Connect(function()
		local ok, err = pcall(function() ConfigManager.load(name) end)
		if ok then
			loadBtn.Text = "Done!"
			loadBtn.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
		else
			local msg = tostring(err)
			loadBtn.Text = msg:sub(1, 80)
			loadBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
			do end
		end
		task.delay(3, function()
			loadBtn.Text = "Load"
			loadBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 230)
		end)
	end)

	deleteBtn.MouseButton1Click:Connect(function()
		ConfigManager.delete(name)
		row:Destroy()
	end)
end

function refreshConfigList()
	for _, child in ipairs(configListFrame:GetChildren()) do
		if child ~= configListLayout then
			child:Destroy()
		end
	end
	local configs = ConfigManager.list()
	for _, name in ipairs(configs) do
		createConfigEntry(name)
	end
end

refreshConfigList()

