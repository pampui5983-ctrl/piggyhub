-- ====================== FUNCTIONS ======================
local function isTeammate(player)
	-- If they are Neutral (i.e. FFA match), they are not teammates
	if LocalPlayer.Neutral or player.Neutral then
		return false
	end
	if not LocalPlayer.Team or not player.Team then
		if LocalPlayer.TeamColor == player.TeamColor then return true end
		return false
	end
	return LocalPlayer.Team == player.Team or LocalPlayer.TeamColor == player.TeamColor
end

local function getTargetNearCursor(maxDistance)
	maxDistance = maxDistance or 150
	local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
	local closestTarget = nil
	local closestDistance = maxDistance

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if teamCheckEnabled and isTeammate(player) then continue end
			local character = player.Character
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if humanoid and hrp and humanoid.Health > 0 then
				local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local dx = screenPos.X - mousePos.X
					local dy = screenPos.Y - mousePos.Y
					local distance = math.sqrt(dx*dx + dy*dy)
					if distance < closestDistance then
						closestDistance = distance
						closestTarget = hrp
					end
				end
			end
		end
	end
	return closestTarget
end

unloadScript = function()
	guiEnabled = false
	lockMode = "Off"
	silentRotateOff = false
	if silentNoRotateObj then
		pcall(function() silentNoRotateObj:Destroy() end)
		silentNoRotateObj = nil
	end
	pcall(function()
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h then h.AutoRotate = true end
	end)
	active = false
	minimized = false
	lockedTarget = nil
	teamCheckEnabled = false
	predictionEnabled = false
	arrowsEnabled = false
	ultEspEnabled = false
	autoBlockEnabled = false
	autoCounterEnabled = false
	moveEspEnabled = false
	moveInputsEnabled = false
	autoBlackFlashEnabled = false
	autoPlayEnabled = false
	autoSprintEnabled = false
	triggerbotEnabled = false
	flyEnabled = false
	cleanupFlyMovers()
	headAttachEnabled = false
	headAttachHolding = false
	headAttachFlying = false
	headAttachCurrent = nil
	pcall(function()
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if h then h.PlatformStand = false end
	end)
	triggerbot1Pending = false
	triggerbot2Pending = false
	triggerbotMarkPlayer = nil
	triggerbotMarkChar = nil
	triggerbotWasBlocking = false
	triggerbotAwaitingCd = false
	triggerbot2AwaitingCd = false
	targetBanCharacters = {}
	targetBanCharIdx = 1
	targetBanEnabled = false
	banActioned = false
	lastBannedChars = {}
	banCooldown = 0
	antiBanCharacters = {}
	antiBanCharIdx = 1
	antiBanEnabled = false
	antiBanActioned = false
	antiBanPhase = "ban"
	antiBanCooldown = 0
	antiBanPageIdx = 0
	antiBanPages = {}
	if banThread then task.cancel(banThread) banThread = nil end
	
	if blackFlashCheck and originalBlackFlashHandler then
		pcall(function() blackFlashCheck.OnClientInvoke = originalBlackFlashHandler end)
	end
	

	
	if blockingState then
		blockingState = false
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
	end
	if testHoldBlock then
		testHoldBlock = false
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
	end
	if sprintHeld then
		sprintHeld = false
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
	end
	
	for _, conn in ipairs(activeConnections) do
		if conn and conn.Connected then
			pcall(function() conn:Disconnect() end)
		end
	end
	activeConnections = {}
	
	for i = #connections, 1, -1 do
		local c = connections[i]
		if c and c.Connected then c:Disconnect() end
		connections[i] = nil
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local billboard = parentGui:FindFirstChild(player.Name .. "_ChargeBillboard")
		if billboard then billboard:Destroy() end
		
		local mBillboard = parentGui:FindFirstChild(player.Name .. "_MoveBillboard")
		if mBillboard then mBillboard:Destroy() end
	end
	if _G.__SkinCleanup then
		if _G.__SkinCleanup.enforceCor then
			local close = coroutine.close
			if close then pcall(close, _G.__SkinCleanup.enforceCor) end
		end
		_G.__SkinCleanup = nil
	end
	if screenGui then screenGui:Destroy() end
	-- stealth: restore SendNotification hook, wipe globals and attempt to clear console (no print left)
	pcall(function()
		if _G.__PiggyOrigSetCore then
			game:GetService("StarterGui").SetCore = _G.__PiggyOrigSetCore
			_G.__PiggyOrigSetCore = nil
		end
	end)
	pcall(function() game:GetService("LogService"):ClearOutput() end)
	pcall(function() if rconsoleclear then rconsoleclear() end end)
	_G.PiggyV2Connections = nil
	_G.PiggyAnimCache = nil
	_G.PiggyModeSkip = nil
	_G.PiggyConnections = nil
	_G.airSwingTrack = nil
end

-- ====================== CHARGE ESP SYSTEM ======================
local ThemeESP = {
	Font = Enum.Font.SourceSansBold,
	TextSize = 18,
	StrokeColor = Color3.fromRGB(0, 0, 0),
	HighColor = Color3.fromRGB(50, 220, 110),   -- Green (>75%)
	MiddleColor = Color3.fromRGB(240, 180, 50), -- Yellow/Orange (>30%)
	LowColor = Color3.fromRGB(240, 80, 80),     -- Red (<=30%)
	DefaultColor = Color3.fromRGB(115, 95, 230) -- Purple
}

local MAX_CHARGE = 325

local function getPlayerCharge(player)
	local directVal = player:FindFirstChild("Charge")
	if directVal then
		local success, val = pcall(function() return directVal.Value end)
		if success and val ~= nil then return val end
	end
	local attr = player:GetAttribute("Charge")
	if attr ~= nil then return tonumber(attr) or attr end
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local chargeVal = leaderstats:FindFirstChild("Charge")
		if chargeVal then
			local success, val = pcall(function() return chargeVal.Value end)
			if success and val ~= nil then return val end
		end
	end
	local char = player.Character
	if char then
		local charVal = char:FindFirstChild("Charge")
		if charVal then
			local success, val = pcall(function() return charVal.Value end)
			if success and val ~= nil then return val end
		end
		local charAttr = char:GetAttribute("Charge")
		if charAttr ~= nil then return tonumber(charAttr) or charAttr end
	end
	return nil
end

local function calculateChargeDisplay(rawVal)
	if rawVal == nil then
		return "N/A", ThemeESP.DefaultColor
	end
	local numVal = tonumber(rawVal)
	if numVal then
		local percent = (numVal / MAX_CHARGE) * 100
		local formattedText = string.format("%.0f%%", percent)
		local color
		if percent > 75 then
			color = ThemeESP.HighColor
		elseif percent > 30 then
			color = ThemeESP.MiddleColor
		else
			color = ThemeESP.LowColor
		end
		return formattedText, color
	else
		local str = tostring(rawVal)
		if string.find(str, "%%") then
			return str, ThemeESP.DefaultColor
		end
		return str .. "%", ThemeESP.DefaultColor
	end
end

local function getCharacterHeadNonYielding(character)
	if not character then return nil end
	local head = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
	if not head then
		head = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso")
	end
	if not head then
		head = character.PrimaryPart
	end
	if not head then
		head = character:FindFirstChildOfClass("Part") or character:FindFirstChildOfClass("MeshPart")
	end
	return head
end

local function getCharacterHeadYielding(character)
	if not character then return nil end
	local head = getCharacterHeadNonYielding(character)
	if not head then
		local startTime = os.clock()
		while os.clock() - startTime < 3 do
			if not character or not character.Parent then return nil end
			head = getCharacterHeadNonYielding(character)
			if head then break end
			task.wait(0.05)
		end
	end
	return head
end

local function createChargeBillboard(player, character)
	if player == LocalPlayer then return end
	if not ultEspEnabled then return end
	if not character then return end
	local head = getCharacterHeadYielding(character)
	if not head then return end
	
	local Billboard = parentGui:FindFirstChild(player.Name .. "_ChargeBillboard")
	local Label
	if Billboard then
		Label = Billboard:FindFirstChild("ChargeText")
		Billboard.Size = UDim2.new(ultEspSize, 0, ultEspSize / 3, 0)
		Billboard.StudsOffset = Vector3.new(-(ultEspSize * 0.25 + 2.65), 0, ultEspSize / 6)
	else
		Billboard = Instance.new("BillboardGui")
		Billboard.Name = player.Name .. "_ChargeBillboard"
		Billboard.Size = UDim2.new(ultEspSize, 0, ultEspSize / 3, 0)
		Billboard.StudsOffset = Vector3.new(-(ultEspSize * 0.25 + 2.65), 0, ultEspSize / 6)
		Billboard.AlwaysOnTop = true
		
		Label = Instance.new("TextLabel")
		Label.Name = "ChargeText"
		Label.Size = UDim2.new(1, 0, 1, 0)
		Label.BackgroundTransparency = 1
		Label.Text = "Checking..."
		Label.TextColor3 = ThemeESP.DefaultColor
		Label.TextScaled = true -- Scaled to container stud size
		Label.Font = ThemeESP.Font
		Label.Parent = Billboard
		
		local textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.MinTextSize = 8
		textConstraint.MaxTextSize = 60
		textConstraint.Parent = Label
		
		local Stroke = Instance.new("UIStroke")
		Stroke.Thickness = 1.5
		Stroke.Color = ThemeESP.StrokeColor
		Stroke.Parent = Label
		
		Billboard.Parent = parentGui
	end
	
	Billboard.Adornee = head
	chargeBillboards[player] = Label
end

-- Per-player cached full move ordering. Stable within a single life to avoid
-- jitter, but re-evaluated from scratch whenever the player's character changes
-- (respawn) so a wrong order from a previous life can self-correct.
local moveOrderCache = {}
local moveOrderChar = {}

local function getPlayerCooldowns(player)
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return {} end
	
	local cds = {}
	local index = 0
	for _, config in ipairs(backpack:GetChildren()) do
		if config:IsA("Configuration") then
			index = index + 1
			local cdVal = config:GetAttribute("COOLDOWN")
			local cdNum = cdVal and tonumber(cdVal)
			
			local key = player.Name .. "_" .. config.Name
			local lastCd = lastCdNums[key]
			local remaining = 0
			
			if cdNum then
				-- Track maximum value in current cycle to filter attribute jitter
				local maxSeen = maxCooldowns[key]
				if not maxSeen then
					maxCooldowns[key] = cdNum
				elseif cdNum > maxSeen then
					maxCooldowns[key] = cdNum
				elseif maxSeen - cdNum > 5 then
					maxCooldowns[key] = cdNum
				else
					cdNum = maxSeen
				end
				
				-- Rate calibration & smooth interpolation between attribute updates
				local now = os.clock()
				local changeTime = cdChangeTimes[key]
				local changeValue = cdChangeValues[key]
				
				if changeValue ~= cdNum then
					if changeTime and changeValue and cdNum > changeValue then
						local dt = now - changeTime
						local dv = cdNum - changeValue
						if dt > 0.05 and dv > 0 then
							cdRates[key] = dv / dt
						end
					end
					cdChangeTimes[key] = now
					cdChangeValues[key] = cdNum
				end
				
				local rate = cdRates[key]
				if rate and rate > 0.001 and cdChangeTimes[key] then
					local elapsed = now - cdChangeTimes[key]
					local estimatedCd = math.min(20, cdNum + elapsed * rate)
					remaining = (20 - estimatedCd) / rate
				else
					remaining = 20 - cdNum
				end
				if remaining < 0 then remaining = 0 end
			else
				-- Cooldown completed
				maxCooldowns[key] = nil
				cdChangeTimes[key] = nil
				cdChangeValues[key] = nil
				cdRates[key] = nil
				remaining = 0
			end
			
			lastCdNums[key] = cdNum
			
			if remaining > 0.5 then
				table.insert(cds, { Name = config.Name, Remaining = remaining, IsReady = false, Config = config, Index = index })
			else
				table.insert(cds, { Name = config.Name, Remaining = 0, IsReady = true, Config = config, Index = index })
			end
		end
	end
	
	local function getMoveSlot(config)
		if not config then return nil end
		local dotConfig = config:FindFirstChild(".Config")
		if dotConfig then
			for i = 1, 5 do
				if dotConfig:FindFirstChild("Slot" .. i) then
					return i
				end
			end
		end
		return nil
	end

	-- Build an order value (name -> sort key) from the current move set.
	-- Moves with a detected slot sort by slot number first; any move without a
	-- slot keeps its current list position after all slotted moves. The result is
	-- cached per player and reused after respawns for a stable 1234 layout.
	local function buildOrderMap(list)
		local map = {}
		local sawSlot = false
		for _, cd in ipairs(list) do
			local sl = getMoveSlot(cd.Config)
			if sl then
				map[cd.Name] = sl
				sawSlot = true
			end
		end
		local maxSlot = 0
		for _, v in pairs(map) do
			if v > maxSlot then maxSlot = v end
		end
		local offset = maxSlot
		for i, cd in ipairs(list) do
			if map[cd.Name] == nil then
				offset = offset + 1
				map[cd.Name] = offset
			end
		end
		return map, sawSlot
	end

	-- Reuse the cached order if it still matches the exact move set AND the player
	-- is on the same character instance (stable within a life). On respawn the
	-- character changes, so we rebuild the order fresh and let it self-correct.
	local cached = moveOrderCache[player.Name]
	local useCache = false
	if cached and moveOrderChar[player.Name] == player.Character then
		useCache = true
		local present = {}
		for _, cd in ipairs(cds) do present[cd.Name] = true end
		for _, cd in ipairs(cds) do
			if not cached[cd.Name] then useCache = false break end
		end
		if useCache then
			for k in pairs(cached) do
				if not present[k] then useCache = false break end
			end
		end
	end
	local orderMap
	if useCache then
		orderMap = cached
	else
		orderMap = buildOrderMap(cds)
		moveOrderCache[player.Name] = orderMap
		moveOrderChar[player.Name] = player.Character
	end

	table.sort(cds, function(a, b)
		return (orderMap[a.Name] or 0) < (orderMap[b.Name] or 0)
	end)
	
	return cds
end

local function onPlayerRemoving(player)
	local billboard = parentGui:FindFirstChild(player.Name .. "_ChargeBillboard")
	if billboard then billboard:Destroy() end
	chargeBillboards[player] = nil
	
	local mBillboard = parentGui:FindFirstChild(player.Name .. "_MoveBillboard")
	if mBillboard then mBillboard:Destroy() end
	moveBillboards[player] = nil
	
	for k in pairs(moveFlashTimes) do
		if k:find(player.Name .. "_") then
			moveFlashTimes[k] = nil
		end
	end
	local conns = moveInputConns[player]
	if conns then
		for _, conn in ipairs(conns) do
			conn:Disconnect()
		end
		moveInputConns[player] = nil
	end
	moveOrderCache[player.Name] = nil
	moveOrderChar[player.Name] = nil
	local pn = player.Name .. "_"
	for _, tbl in ipairs({maxCooldowns, lastCdNums, cdChangeTimes, cdChangeValues, cdRates}) do
		for k in pairs(tbl) do
			if k:sub(1, #pn) == pn then tbl[k] = nil end
		end
	end
	if _G.PiggyModeSkip then _G.PiggyModeSkip[player] = nil end
end

local function setupCooldownListeners(player)
	if moveInputConns[player] then return end
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return end
	local conns = {}
	local function listenConfig(config)
		local lastVal = config:GetAttribute("COOLDOWN")
		local cfgName = config.Name
		local conn = config.AttributeChanged:Connect(function(attr)
			if attr ~= "COOLDOWN" then return end
			local newVal = config:GetAttribute("COOLDOWN")
			local newNum = newVal and tonumber(newVal)
			local lastNum = lastVal and tonumber(lastVal)
			lastVal = newVal
		end)
		table.insert(conns, conn)
	end
	for _, config in ipairs(backpack:GetChildren()) do
		if config:IsA("Configuration") then
			listenConfig(config)
		end
	end
	local childConn = backpack.ChildAdded:Connect(function(child)
		task.wait()
		if child:IsA("Configuration") then
			listenConfig(child)
		end
	end)
	table.insert(conns, childConn)
	moveInputConns[player] = conns
end

local function createMoveBillboard(player, character)
	if player == LocalPlayer then return end
	if not moveEspEnabled and not moveInputsEnabled then return end
	if not character then return end
	local head = getCharacterHeadYielding(character)
	if not head then return end
	
	local Billboard = parentGui:FindFirstChild(player.Name .. "_MoveBillboard")
	local Container
	if Billboard then
		Container = Billboard:FindFirstChild("Container")
	else
		Billboard = Instance.new("BillboardGui")
		Billboard.Name = player.Name .. "_MoveBillboard"
		Billboard.Size = UDim2.new(moveEspSize, 0, 7.2, 0)
		Billboard.StudsOffset = Vector3.new(3.4, 0, 0)
		Billboard.AlwaysOnTop = true
		
		Container = Instance.new("Frame")
		Container.Name = "Container"
		Container.Size = UDim2.new(1, 0, 1, 0)
		Container.BackgroundTransparency = 1
		Container.Parent = Billboard
		
		local ListLayout = Instance.new("UIListLayout")
		ListLayout.FillDirection = Enum.FillDirection.Vertical
		ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		ListLayout.Padding = UDim.new(0.03, 0)
		ListLayout.Parent = Container
		
		Billboard.Parent = parentGui
	end
	
	if Billboard then
		Billboard.Adornee = head
	end
	if Container then
		moveBillboards[player] = Container
	end
	setupCooldownListeners(player)
end

-- ====================== IMPROVED ARROW SYSTEM ======================
local function getArrow()
	for _, arrow in ipairs(arrowPool) do
		if not arrow.Used then
			arrow.Used = true
			arrow.Frame.Visible = true
			return arrow
		end
	end
	
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 40, 0, 40)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = screenGui

	local arrowLabel = Instance.new("TextLabel")
	arrowLabel.Size = UDim2.new(1,0,1,0)
	arrowLabel.BackgroundTransparency = 1
	arrowLabel.Text = "^"
	arrowLabel.TextScaled = true
	arrowLabel.TextColor3 = Color3.new(1,1,1)
	arrowLabel.Font = Enum.Font.GothamBold
	arrowLabel.Parent = frame

	local distanceLabel = Instance.new("TextLabel")
	distanceLabel.Size = UDim2.new(0, 60, 0, 20)
	distanceLabel.Position = UDim2.new(0.5, -30, 1, 5)
	distanceLabel.BackgroundTransparency = 1
	distanceLabel.Text = "0"
	do end
distanceLabel.TextScaled = true
	distanceLabel.TextColor3 = Color3.new(1,1,1)
	distanceLabel.Font = Enum.Font.Gotham
	distanceLabel.Parent = frame

	local arrow = {Frame = frame, Label = arrowLabel, DistanceLabel = distanceLabel, Used = true}
	table.insert(arrowPool, arrow)
	return arrow
end

local function updateArrows()
	for _, arrow in ipairs(arrowPool) do
		arrow.Used = false
		arrow.Frame.Visible = false
	end

	-- Arrow display works independently of the main aimlock Enable toggle
	if not arrowsEnabled then return end

	local cameraCFrame = Camera.CFrame
	local cameraForward = cameraCFrame.LookVector
	local cameraRight = cameraCFrame.RightVector

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer or not player.Character then continue end
		if teamCheckEnabled and isTeammate(player) then continue end

		local hrp = player.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then continue end

		local toTarget = (hrp.Position - cameraCFrame.Position).Unit
		local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
		if onScreen then continue end

		local arrow = getArrow()

		local angle = math.deg(math.atan2(toTarget:Dot(cameraRight), toTarget:Dot(cameraForward)))
		arrow.Label.Rotation = angle

		arrow.Label.TextColor3 = player.Team and player.Team.TeamColor.Color or Color3.new(1, 0.3, 0.3)

		local distance = math.floor((hrp.Position - cameraCFrame.Position).Magnitude)
		arrow.DistanceLabel.Text = tostring(distance)

		local viewport = Camera.ViewportSize
		local center = Vector2.new(viewport.X/2, viewport.Y/2)
		local edgeDistance = 140

		local edgeDir = Vector2.new(toTarget:Dot(cameraRight), -toTarget:Dot(cameraForward)).Unit
		local edgePos = center + edgeDir * edgeDistance

		edgePos = Vector2.new(
			math.clamp(edgePos.X, 50, viewport.X - 50),
			math.clamp(edgePos.Y, 50, viewport.Y - 50)
		)

		arrow.Frame.Position = UDim2.new(0, edgePos.X - 20, 0, edgePos.Y - 20)
	end
end

-- ====================== AUTO BLOCK & COUNTER RETALIATION SYSTEM ======================
local function getLocalBlockSound()
	local char = LocalPlayer.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			return hrp:FindFirstChild("BlockSound")
		end
	end
	return nil
end

-- Check if player is holding a movement key
local function isLocalPlayerMoving()
    local moves = {Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D}
    for _, key in ipairs(moves) do
        if UserInputService:IsKeyDown(key) then
            return true
        end
    end
    return false
end

