local function makeTabBtn(name, order, isFirst)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.BackgroundColor3 = isFirst and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(35, 35, 45)
	btn.Text = name
	btn.TextColor3 = isFirst and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 170)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.LayoutOrder = order
	btn.AutoButtonColor = false
	btn.Parent = tabsContainer
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = btn
	return btn
end

