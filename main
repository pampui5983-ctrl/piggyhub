-- STEALTH PATCH: silent mode - no console output, no traces on unload
-- (all print/warn calls rewritten to do end below)
-- original boot print removed
-- The COUNTER DIAGNOSTICS block is OFF by default; set
-- getgenv().PiggyCounterOptIn = true before executing to trace again.
do -- stealth: suppress SendNotification popups (no visual trace)
    pcall(function()
        local sg = game:GetService("StarterGui")
        _G.__PiggyOrigSetCore = _G.__PiggyOrigSetCore or sg.SetCore
        local orig = _G.__PiggyOrigSetCore
        sg.SetCore = function(self, key, data)
            if key == "SendNotification" then return end
            return orig(self, key, data)
        end
    end)
end
