-- Script-owned F presses expect exactly one InputBegan/Ended echo each, so the
-- userHoldingF tracker below can tell synthetic presses apart from a physical
-- finger with no timing blind spots and no IsKeyDown polling. Zero delay:
-- bookkeeping happens inline, no waits added to any block/counter path.
local function scriptFDown()
	pendingDownEcho = pendingDownEcho + 1
	lastDownStamp = os.clock()
	pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
end
local function scriptFUp()
	pendingUpEcho = pendingUpEcho + 1
	lastUpStamp = os.clock()
	pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
end
table.insert(connections, UserInputService.InputBegan:Connect(function(input, _gp)
	if input.KeyCode == Enum.KeyCode.F and input.UserInputType == Enum.UserInputType.Keyboard then
		if pendingDownEcho > 0 and os.clock() - lastDownStamp < ECHO_WINDOW then
			pendingDownEcho = pendingDownEcho - 1
			return
		end
		pendingDownEcho = 0
		userHoldingF = true
	end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.F and input.UserInputType == Enum.UserInputType.Keyboard then
		if pendingUpEcho > 0 and os.clock() - lastUpStamp < ECHO_WINDOW then
			pendingUpEcho = pendingUpEcho - 1
			return
		end
		pendingUpEcho = 0
		userHoldingF = false
	end
end))
pcall(function() userHoldingF = UserInputService:IsKeyDown(Enum.KeyCode.F) end)

local function clickBanButton(btn)
	local ok = pcall(function()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if bc then
			local comm = bc:FindFirstChild("Communicate")
			if comm and comm:IsA("RemoteEvent") then
				comm:FireServer(btn.Name)
			end
		end
		-- Also click via mouse for visual feedback
		local pos = btn.AbsolutePosition
		local size = btn.AbsoluteSize
		if pos.X > 0 and pos.Y > 0 then
			VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2 + 75, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2 + 75, 0, false, game, 0)
		end
	end)
	return ok
end

local function clickPos(x, y)
	local ok = pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
	return ok
end

local function findCharButton(searchName)
	local bc = PlayerGui:FindFirstChild("BanChooser")
	if not bc or not bc.Enabled then return nil, nil end
	local cs = bc:FindFirstChild("CharacterSelect")
	if not cs then return nil, nil end
	local chars = cs:FindFirstChild("Characters")
	if not chars then return nil, nil end

	for _, page in chars:GetChildren() do
		if not page:IsA("Frame") then continue end
		for _, cat in page:GetChildren() do
			if not cat:IsA("Frame") then continue end
			local slots = cat:FindFirstChild("Slots")
			if not slots then continue end
			for _, btn in slots:GetChildren() do
				if not btn:IsA("ImageButton") then continue end
				local n = btn.Name:lower()
				if n == searchName or n:find(searchName, 1, true) then
					return btn, page
				end
			end
		end
	end
	return nil, nil
end

local function navigateToPage(chars, targetPage, cs)
	local pages = {}
	for _, p in chars:GetChildren() do
		if p:IsA("Frame") then
			table.insert(pages, p)
		end
	end
	if #pages == 0 then return true end

	local targetIdx, currentIdx
	for i, p in ipairs(pages) do
		if p == targetPage then targetIdx = i end
		if p.Visible then currentIdx = i end
	end
	if not targetIdx or not currentIdx or targetIdx == currentIdx then return true end

	local diff = targetIdx - currentIdx
	local btnName = diff > 0 and "Next" or "Back"
	local navBtn = cs:FindFirstChild(btnName)
	if navBtn and navBtn:IsA("TextButton") then
		local npos = navBtn.AbsolutePosition
		local nsz = navBtn.AbsoluteSize
		if npos.X > 0 and npos.Y > 0 then
			clickPos(npos.X + nsz.X/2, npos.Y + nsz.Y/2)
		end
		return false
	end
	return true
end

