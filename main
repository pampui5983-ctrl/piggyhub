-- ====================== AUTOINFINITY ======================
-- Loads PiggyHub/Database.json once, builds a whitelist of move-trigger anim
-- ids (the anim present in ~every sample of each move), then constantly scans
-- enemy animators. When a whitelisted move is detected, presses 4 (Infinity).
local autoInfinityAnims = {}          -- animId -> move name
local autoInfinityRecent = {}         -- animIdNum -> last trigger time
local autoInfinityRecentMove = {}     -- playerName::moveName -> last trigger time
local autoInfinityScheduled = {}      -- scheduled timed presses { at, move, id, player }
local autoInfinityProj = {}           -- enemy playerName -> pending proj info { start, launch, speed, id, move }
local autoInfinityRush = {}           -- enemy playerName -> pending rush info { pos, prev, entry } for velocity confirm
local autoInfinityCounterMoves = {}   -- profile charName -> {moveName -> true} (moves that got whitelisted)

-- AutoInfinity-local teammate check (mirrors the main isTeammate helper but
-- defined before the AutoInfinity heartbeat, which runs earlier in the file).
local function aiIsTeammate(player)
	if LocalPlayer.Neutral or player.Neutral then
		return false
	end
	if not LocalPlayer.Team or not player.Team then
		if LocalPlayer.TeamColor == player.TeamColor then return true end
		return false
	end
	return LocalPlayer.Team == player.Team or LocalPlayer.TeamColor == player.TeamColor
end
local AUTOINFINITY_LEAD = 0.4         -- press Infinity this many s before impact
local AUTOINFINITY_RUSH_LEAD = 0.4    -- extra lead for rushes (short eta + fast close eat the base lead)
local AUTOINFINITY_MARGIN = 0.16      -- minimum time-to-impact (Infinity windup): skip if nearest to time to respond
local autoInfinityRayRadius = 40    -- half of the hit zone the aim ray must pass through (Ray cast sensitivity)
local autoInfinityLookSensitivity = 0.5    -- min enemy facing dot (toward us) required to counter a fixed move; 1 = dead-on
local function pressInfinityKey()
	if autoInfinityUnlocked and UserInputService:IsKeyDown(Enum.KeyCode.F) then
		-- "Infinity unblock": drop the guard first so Infinity isn't
		-- swallowed while we're holding block, then fire 4 after the
		-- block physics drops (mirrors AutoCounter's unblock-then-M1).
		blockingState = false
		scriptFUp()
		task.spawn(function()
			task.wait(0.06)
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Four, false, game)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Four, false, game)
		end)
		return
	end
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Four, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Four, false, game)
end

local function autoInfinityLoadDatabase()
	autoInfinityAnims = {}
	autoInfinityRecent = {}
	autoInfinityCounterMoves = {}
	if not readfile or not isfile then return false, "no readfile" end
	if not isfile("PiggyHub/Database.json") then return false, "no Database.json" end
	local ok, data = pcall(readfile, "PiggyHub/Database.json")
	if not ok or not data or data == "" then return false, "empty file" end
	local okd, db = pcall(HttpService.JSONDecode, HttpService, data)
	if not okd or type(db) ~= "table" or type(db.profiles) ~= "table" then
		return false, "bad JSON"
	end
	local count = 0
	local function whitelistAnim(idNum, charName, moveName, gate)
		-- same anim id can be owned by several chars (ABA reuses assets); merge
		local existing = autoInfinityAnims[idNum]
		if existing then
			existing.chars[charName] = true
		else
			gate.chars = { [charName] = true }
			autoInfinityAnims[idNum] = gate
		end
		if not autoInfinityCounterMoves[charName] then autoInfinityCounterMoves[charName] = {} end
		autoInfinityCounterMoves[charName][moveName] = true
		count = count + 1
	end
	for charName, moves in pairs(db.profiles) do
		for moveName, prof in pairs(moves) do
			-- range gate: only whitelist moves whose captured reach is known and
			-- which have enough samples (a 1-sample move whitelists every anim,
			-- e.g. Run/Jump, at freq 1.0 and would false-trigger Infinity).
local reach = prof.range
				local enough = type(prof.sampleCount) == 'number' and prof.sampleCount >= 2
				if type(reach) ~= 'number' or reach <= 0 or not enough then do end
				else
					-- projectile timing data (used by the timed trigger): model
					-- type, launch windup and travel speed. Only "proj"/"rush"
					-- measure speed; fixed (melee) moves have no flight time.
					local pModel, pSpeed, pLaunch = prof.model, prof.speed, prof.launchDelay
					if pModel ~= "proj" and pModel ~= "rush" then pSpeed, pLaunch = nil, nil end
					-- Captured move windup. For scheduling we use the MINIMUM windup
					-- (fastest observed move-start -> landed hit): an occasional late
					-- outlier sample drags the average up (e.g. ORA! avg 1.33 vs min
					-- 0.76) and schedules the press AFTER the move already landed.
					-- Pressing for the earliest hit keeps Infinity up before impact.
					local wStat = prof.windup
					local pWindup = (type(wStat) == "table" and type(wStat.min) == "number") and wStat.min
						or (type(wStat) == "table" and type(wStat.avg) == "number" and wStat.avg) or nil
					-- average windup kept separately: the hard cap for rush/proj ETAs
					-- (they move far, min would over-clamp and ignore real flight time).
					local pWindupAvg = (type(wStat) == "table" and type(wStat.avg) == "number") and wStat.avg or pWindup
				local best = nil
				for _, a in ipairs(prof.anims or {}) do
					local idNum = (a.id and tostring(a.id):match("%d+")) or ""
					-- ABA move-trigger anims are named "Animation"; locomotion /
					-- idle anims (Run, jump, Jump, ...) get descriptive names and
					-- must never be whitelisted (they'd false-trigger Infinity).
					local aName = tostring(a.name or "")
					if idNum ~= "" and aName == "Animation" then
						local freq = a.freq or 0
						if not best or freq > (best.freq or 0) then best = { idNum = idNum, freq = freq } end
						if freq >= 0.9 and not autoInfinityAnims[idNum] then
							whitelistAnim(idNum, charName, moveName, { move = moveName, range = reach, model = pModel, speed = pSpeed, launchDelay = pLaunch, windup = pWindup, windupAvg = pWindupAvg })
						end
					end
				end
				-- fallback: no >=0.9 "Animation" anim, use the most frequent
				-- "Animation"-named one (only if confidently the move's anim)
				if best and best.freq >= 0.5 then
					whitelistAnim(best.idNum, charName, moveName, { move = moveName, range = reach, model = pModel, speed = pSpeed, launchDelay = pLaunch, windup = pWindup, windupAvg = pWindupAvg })
				end
			end
		end
	end
	do end
	return count > 0
end

table.insert(connections, RunService.Heartbeat:Connect(function()
	if not autoInfinityEnabled then return end
	local now = os.clock()
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and teamCheckEnabled and aiIsTeammate(player) then continue end
		if player ~= LocalPlayer then
			local char = player.Character
			if char and char.Parent then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if animator then
					local enemyRoot = char:FindFirstChild("HumanoidRootPart")
					local enemyBase = player:GetAttribute("SpawnChar") or (char.GetAttribute and char:GetAttribute("SpawnChar"))
					local enemyOwned = enemyBase and (enemyBase .. " [Awakening]")
					local dist = (myRoot and enemyRoot) and math.floor((enemyRoot.Position - myRoot.Position).Magnitude * 10) / 10 or nil
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						local anim = track.Animation
						if anim and track.IsPlaying then
							local idNum = (tostring(anim.AnimationId):match("%d+")) or ""
							local gate = idNum ~= "" and autoInfinityAnims[idNum] or nil
							-- anim ids are shared across characters (ABA reuses assets),
							-- so only fire if THIS enemy owns the move the anim was captured for
							if gate and enemyBase then
								if not (gate.chars[enemyBase] or gate.chars[enemyOwned]) then
									gate = nil
								end
							end
							if gate then
								local last = autoInfinityRecent[idNum] or 0
								-- projectile moves schedule a press at time-to-impact; melee/
								-- fixed moves (no speed) counter immediately. Re-fire is
								-- allowed every 1.5s per move.
								local lastMove = autoInfinityRecentMove[player.Name .. "::" .. gate.move] or 0
								if now - last >= 1.2 and now - lastMove > 1.5 then
									autoInfinityRecent[idNum] = now
									autoInfinityRecentMove[player.Name .. "::" .. gate.move] = now
									if dist and dist <= gate.range + 2 then
										if gate.model == "rush" then
											-- Dash moves run toward the player, so the enemy's facing
											-- IS the travel direction. Ray-pass against that.
											local origin = enemyRoot.Position
											local aimDir = enemyRoot.CFrame.LookVector
											local delta = myRoot.Position - origin
											local along = delta:Dot(aimDir)
											local closest = origin + aimDir * along
											local miss = (myRoot.Position - closest).Magnitude
											if along > 0 and miss <= autoInfinityRayRadius then
local flight = gate.speed and gate.speed > 0 and (along / gate.speed) or 0
											local eta = (gate.launchDelay or 0) + flight
											-- Dash moves (e.g. Detroit Smash) close distance on their own; a
											-- mis-fit tiny speed would inflate flight far past reality. The
											-- captured windup is the measured time-to-impact — cap by it.
											if gate.windupAvg and eta > gate.windupAvg then eta = gate.windupAvg end
												if eta - AUTOINFINITY_RUSH_LEAD < AUTOINFINITY_MARGIN then
													-- Dash too imminent to schedule a timed lead press: press
													-- Infinity NOW so it's up before the dash lands (e.g. close
													-- Detroit Smash where launchDelay fills almost the whole ETA).
													do end
													pressInfinityKey()
												else
													local entry = {
															at = now + math.max(eta - AUTOINFINITY_LEAD - AUTOINFINITY_RUSH_LEAD, 0),
															move = gate.move,
															id = idNum,
															player = player.Name,
															est = eta,
															cancelled = false,
														}
														table.insert(autoInfinityScheduled, entry)
														-- register for the velocity confirm/cancel tracker below
														autoInfinityRush[player.Name] = {
															pos = origin,
															prev = origin,
															t0 = now,
															entry = entry,
														}
														do end
													end
											else do end
											end
										elseif gate.model == "proj" then
											-- Projectile: schedule the press IMMEDIATELY at anim-start for fast
											-- reaction, but only when the enemy's body is actually facing us
											-- (cheap early gate). That blocks the common "fired the other way"
											-- false trigger without waiting on the beam and losing the reaction
											-- window. The beam tracker below still CANCELS the press if the real
											-- beam is mouse-aimed away (body faces us but muzzle goes up/side).
											local projLookSens = (enemyRoot and myRoot)
												and (enemyRoot.CFrame.LookVector):Dot((myRoot.Position - enemyRoot.Position).Unit) or 0
											if projLookSens < autoInfinityLookSensitivity then do end
											else
local pSpeed = gate.speed or 0
											local tSpeed = pSpeed > 0 and pSpeed or 40
											local travelGuess = dist and (dist / tSpeed) or 0
											local eta = (gate.launchDelay or 0) + travelGuess
											-- A dash/beam sample mis-fit as a slow projectile (tiny fitted speed)
											-- inflates travelGuess way past the real time-to-impact. The captured
											-- windup (move-start -> landed health-drop) IS the measured impact
											-- ETA; never schedule slower than it.
											if gate.windupAvg and eta > gate.windupAvg then eta = gate.windupAvg end
												if eta < AUTOINFINITY_MARGIN then do end
												else
													local entry = {
														at = now + math.max(eta - AUTOINFINITY_LEAD, 0),
														move = gate.move,
														id = idNum,
														player = player.Name,
														est = travelGuess,
														cancelled = false,
													}
													table.insert(autoInfinityScheduled, entry)
													autoInfinityProj[player.Name] = {
														start = now,
														flight = eta,
														id = idNum,
														move = gate.move,
														entry = entry,
														confirmed = false,
													}
												end
											end
										else
											-- Fixed (melee/AoE) move: counter only if the enemy is actually
											-- looking at us (facing dot >= look sensitivity), so a
											-- side/back swing can't eat the counter while they miss.
											-- Timing: the captured windup IS the time-to-impact ETA (fixed
											-- moves have no flight speed). Long windups schedule the press
											-- so Infinity comes out just before impact instead of instantly;
											-- short windups (fast melee) still press immediately, since
											-- waiting would leave too little time for Infinity to activate.
											local aimDir = enemyRoot.CFrame.LookVector
											local toUs = (myRoot.Position - enemyRoot.Position).Unit
											local facing = aimDir:Dot(toUs)
											if facing >= autoInfinityLookSensitivity then
												local eta = gate.windup or 0
												if eta > AUTOINFINITY_LEAD + AUTOINFINITY_MARGIN then
													local entry = {
														at = now + math.max(eta - AUTOINFINITY_LEAD, 0),
														move = gate.move,
														id = idNum,
														player = player.Name,
														est = eta,
														cancelled = false,
													}
													table.insert(autoInfinityScheduled, entry)
													do end
												else do end
													pressInfinityKey()
												end
											else do end
											end
										end
									else do end
									end
								end
							end
						end
					end
				end
			end
		end
	end
end))

-- Projectile tracker: reads the ACTUAL thrown parts in Workspace.Thrown and uses
-- the beam's real line (muzzle -> FARTHEST beam part) for the ray-pass. The anim
-- heartbeat only confirms a proj move started; the AIM/direction is taken from
-- the real part here, so a beam fired at the ceiling (mouse-aimed while the body
-- faces us) won't falsely trigger — its beam points up, away from us. Using the
-- farthest part from the muzzle gives a long, stable direction baseline; a part
-- sitting at/near the muzzle has a short vector whose .Unit jitters and would
-- make even a head-on shot look "out of zone".
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local thrown = Workspace:FindFirstChild("Thrown")
	if not (myRoot and thrown) then return end
	local now = os.clock()
	local myPos = myRoot.Position

	-- prune trackers whose parts are gone (no beam ever confirmed/concurremd)
	for name, info in pairs(autoInfinityProj) do
		if now - info.start > 2.5 then
			autoInfinityProj[name] = nil
		end
	end

	-- pass 1: for each enemy with a pending proj move, find the FARTHEST beam
	-- part attributed to its muzzle (longest baseline = true beam line)
	local far = {}               -- muzzleHRP -> { farPos = Vector3, farD = number }
	for _, inst in ipairs(thrown:GetDescendants()) do
		if not inst:IsA("BasePart") or not inst.Parent then continue end
		local pos = inst.Position
		local muzzle, bestD = nil, math.huge
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= LocalPlayer then
				local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp.Parent then
					local d = (hrp.Position - pos).Magnitude
					if d < bestD then muzzle, bestD = hrp, d end
				end
			end
		end
		if muzzle and bestD <= 90 then
			local eChar = muzzle.Parent
			local ePlayer = eChar and Players:GetPlayerFromCharacter(eChar)
			if ePlayer and autoInfinityProj[ePlayer.Name] then
				local f = far[muzzle]
				local dM = (pos - muzzle.Position).Magnitude
				if not f or dM > f.farD then far[muzzle] = { farPos = pos, farD = dM } end
			end
		end
	end

	-- pass 2: ray-pass once per muzzle from the beam line
	for muzzle in pairs(far) do
		local eChar = muzzle.Parent
		local ePlayer = eChar and Players:GetPlayerFromCharacter(eChar)
		if ePlayer then
			local info = autoInfinityProj[ePlayer.Name]
			if info and (now - info.start) < 2.5 then
				local muzzlePos = muzzle.Position
				local mDelta = myPos - muzzlePos
				-- The aim is the shooter's BODY facing: with lock-on it's
				-- deterministic and identical at every range, which is exactly
				-- what we want the press decision tied to. The far Thrown part
				-- direction was flapping between random projectiles and muzzle
				-- pieces, so it must NOT veto a clean aim read.
				local look = muzzle.CFrame.LookVector
				local alongM = mDelta:Dot(look)            -- studs from muzzle along aim
				local closestM = muzzlePos + look * alongM
				local missM = (myPos - closestM).Magnitude -- studs off the aim ray
				local cancels = missM > autoInfinityRayRadius or alongM < -4
				if info.entry then info.entry.cancelled = cancels end
				do end
				autoInfinityProj[ePlayer.Name] = nil   -- consumed
			end
		end
	end
end))

-- Rush confirm/cancel tracker: dashes track a target (often the nearest, not the
-- facing), so a LookVector ray at anim-start can be a false positive when a nearby
-- teammate is the actual target. This samples the enemy's REAL displacement over a
-- couple frames, derives a velocity direction, and ray-passes it against our own
-- position — cancelling the scheduled press if the dash is actually flying at
-- someone else (or off toward a teammate).
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local now = os.clock()
	-- prune stalls (no movement, enemy was never tracked or dash over)
	for name, info in pairs(autoInfinityRush) do
		if info.entry.cancelled or (now - info.t0) > 2.5 then autoInfinityRush[name] = nil end
	end
	for name, info in pairs(autoInfinityRush) do
		local pl = Players:FindFirstChild(name)
		local eChar = pl and pl.Character
		local eRoot = eChar and eChar.Parent and eChar:FindFirstChild("HumanoidRootPart")
		if not (eRoot and eRoot.Parent) then
			autoInfinityRush[name] = nil
		else
			local cur = eRoot.Position
			local dx = cur - info.prev
			info.vel = (info.vel or Vector3.zero) * 0.5 + dx * 0.5  -- smoothed velocity
			info.prev = cur
			-- need enough cumulative travel for a stable direction baseline
			local traveled = (cur - info.pos).Magnitude
			if traveled >= 4 and info.vel.Magnitude > 0.5 and now - info.t0 >= 0.05 then
				local diru = info.vel.Unit
				local origin = info.pos
				local delta = myRoot.Position - origin
				local along = delta:Dot(diru)
				local closest = origin + diru * along
				local miss = (myRoot.Position - closest).Magnitude
				local cancels = along <= 0 or miss > autoInfinityRayRadius
				info.entry.cancelled = cancels
				do end
				autoInfinityRush[name] = nil  -- decided
			end
		end
	end
end))

-- Scheduled time-of-impact executor: fires the timed Infinity presses that
-- projectile/rush moves scheduled from the anim heartbeat. A polling loop
-- (instead of task.delay) keeps ordering deterministic and prunes stale ones.
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	if #autoInfinityScheduled == 0 then return end
	local now = os.clock()
	local keep = {}
	for _, sched in ipairs(autoInfinityScheduled) do
		if sched.cancelled then
			-- beam confirmed aimed away -> never press, drop immediately
		elseif now >= sched.at then do end
			pressInfinityKey()
		else
			keep[#keep + 1] = sched
		end
	end
	autoInfinityScheduled = keep
end))

