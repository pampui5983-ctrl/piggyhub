-- Fly hit-slow hook: stamp flySwingTime whenever WE start an M1 swing
-- (verified live: swing anim plays, impact lands ~0.35s later, Super Dummy
-- loses ~4.2 HP per hit). The Fly heartbeat caps speed to 8 while fresh.
-- ID match (not track-name match): real M1 tracks are generically named
-- "Animation" (e.g. rbxassetid://1470439852).
local flySwingConn = nil
local function hookFlySwing(char)
	if flySwingConn then pcall(function() flySwingConn:Disconnect() end) flySwingConn = nil end
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local anim = hum and hum:FindFirstChildOfClass("Animator")
	if not anim then return end
	flySwingConn = anim.AnimationPlayed:Connect(function(track)
		counterDiagOnOwnAnim(track)
		local aid = track.Animation and track.Animation.AnimationId
		local num = aid and (tostring(aid):match("%d+")) or ""
		if num ~= "" and sharedM1AnimIds[num] then
			flySwingTime = os.clock()
		end
	end)
	table.insert(connections, flySwingConn)
end
if LocalPlayer.Character then hookFlySwing(LocalPlayer.Character) end
table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	hookFlySwing(char)
end))

-- Stand/summon M1 lookup (Jotaro-style): M1 anim plays on Workspace.Stands.<username>, not the character.
-- Covers all stand characters sharing the Stands/<username> convention. Direct lookup keeps attribution
-- exact (no cross-player false positives); team/blocking gates of the owning player still apply.
local function getStandHums(player)
	local out = {}
	local ok, stands = pcall(function() return workspace:FindFirstChild("Stands") end)
	if not ok or not stands then return out end
	local m = stands:FindFirstChild(player.Name)
	if m then
		local hum = m:FindFirstChildOfClass("Humanoid")
		if hum then table.insert(out, hum) end
	end
	return out
end

local function checkShouldBlock()
	if not autoBlockEnabled then return false end
	if transitioningToCounter then
		counterDiagThrottled("shouldBlockTransition", 1, "CHECK_BLOCK_SKIP",
			"reason=transitioning", "counterGen=" .. tostring(counterGen))
		return false
	end
	if os.clock() - lastCounterTime < counterLockoutDuration then return false end

	-- Safety timeout: if blockingState is stuck, force clear it after 1s
	if blockingState and os.clock() - blockStartTime > 1.0 then
		blockingState = false
		scriptFUp()
	end
	if blockingState then return false end

	local localChar = LocalPlayer.Character
	if not localChar then return false end
	local localHrp = localChar:FindFirstChild("HumanoidRootPart")
	local localHum = localChar:FindFirstChildOfClass("Humanoid")
	if not localHrp or not localHum or localHum.Health <= 0 then return false end

	-- Check if LocalPlayer is currently executing an M1 attack to prevent block cancelling attacks
	local localAnimator = localHum:FindFirstChildOfClass("Animator")
	local localTracks = localAnimator and localAnimator:GetPlayingAnimationTracks() or localHum:GetPlayingAnimationTracks()
	local localIsSwinging = false
	local localSwingName, localSwingId
	for _, track in ipairs(localTracks) do
		local name = track.Name:lower()
		if string.find(name, "light") or string.find(name, "punch") or string.find(name, "atk") or string.find(name, "slash") or string.find(name, "swing") then
			localIsSwinging = true
			localSwingName = track.Name
			localSwingId = track.Animation and track.Animation.AnimationId
			break
		end
	end

	if localIsSwinging then
		local prev = lastLocalM1Time
		lastLocalM1Time = os.clock()
		counterDiagThrottled("localSwing", 0.5, "LOCAL_SWING_GUARD",
			"name=" .. tostring(localSwingName), "id=" .. tostring(localSwingId),
			string.format("sinceLastLocalM1=%.3f", os.clock() - prev))
		return false
	end

	-- Exclude blocking if the local player recently clicked M1 or was swinging (covers opponent hitstun frames)
	if os.clock() - lastLocalM1Time < 0.25 then
		return false
	end

		-- Clean up old blocked anim entries older than 2s
	local now = os.clock()
	for i = #lastBlockedAnims, 1, -1 do
		if now - lastBlockedAnims[i].Time > 2.0 then
			table.remove(lastBlockedAnims, i)
		end
	end

-- Track opponent animation IDs
 	if not _G.PiggyAnimCache then _G.PiggyAnimCache = {} end

 	local airSwingTriggered = false

 	for _, player in ipairs(Players:GetPlayers()) do
 		if player ~= LocalPlayer and player.Name ~= LocalPlayer.Name and player.Character then
 			if teamCheckEnabled and isTeammate(player) then continue end

 			local char = player.Character
 			local blockingChild = char:FindFirstChild("Blocking")
 			local isBlocking = false
 			if blockingChild then
 				if blockingChild:IsA("BoolValue") or blockingChild:IsA("ValueBase") then
 					isBlocking = blockingChild.Value == true
 				else
 					isBlocking = true
 				end
 			end
 			if isBlocking or char:GetAttribute("Blocking") == true then continue end

 			local hrp = char:FindFirstChild("HumanoidRootPart")
 			local hum = char:FindFirstChildOfClass("Humanoid")
 			if not hrp or not hum or hum.Health <= 0 then continue end

 			local verticalDist = math.abs(hrp.Position.Y - localHrp.Position.Y)
 			if verticalDist > 11 then continue end
  			local dist = (hrp.Position - localHrp.Position).Magnitude
  			if dist > 25 then continue end

  			-- Quick distance check before track enumeration
  			if dist > 18 then continue end

 			-- Check opponent's animation tracks for known M1 attack IDs
 			local animator = hum:FindFirstChildOfClass("Animator")
 			local playingTracks = animator and animator:GetPlayingAnimationTracks() or hum:GetPlayingAnimationTracks()

 			for _, track in ipairs(playingTracks) do
 				local animId = track.Animation and track.Animation.AnimationId
 				if not animId then continue end

 				local alreadyBlocked = false
 				for _, item in ipairs(lastBlockedAnims) do
 					if item.Track == track then alreadyBlocked = true; break end
 				end
 				if alreadyBlocked then continue end

 				local animIdNum = (tostring(animId):match("%d+")) or ""

if sharedM1AnimIds[animIdNum] then
					table.insert(lastBlockedAnims, { Track = track, Time = os.clock() })
					counterDiag("BLOCK_DETECT", "src=char", "player=" .. tostring(player.Name),
						"name=" .. tostring(track.Name), "id=" .. tostring(animId),
						string.format("dist=%.1f", dist), "blockTapDelay=" .. tostring(blockTapDelay),
						"holdForCounter=" .. tostring(autoCounterEnabled and blockHoldForCounter or blockTapDuration))
					return true, track
				end
  	 	 	 	if not seenUnknownAnimIds[animIdNum] then
  	 	 	 		seenUnknownAnimIds[animIdNum] = true
  	 	 	 		do end
  	 	 	 	end
  	 	 	 end
				-- Stand/summon M1 for this same player (Jotaro-style: anim lives on Stands/<username>)
				do
					local standHums = getStandHums(player)
					for _, shum in ipairs(standHums) do
						local sanim = shum:FindFirstChildOfClass("Animator")
						local stracks = sanim and sanim:GetPlayingAnimationTracks() or shum:GetPlayingAnimationTracks()
						for _, track in ipairs(stracks) do
							local sanimId = track.Animation and track.Animation.AnimationId
							if not sanimId then continue end
							local dup = false
							for _, item in ipairs(lastBlockedAnims) do
								if item.Track == track then dup = true; break end
							end
							if dup then continue end
							local snum = (tostring(sanimId):match("%d+")) or ""
							if sharedM1AnimIds[snum] then
								table.insert(lastBlockedAnims, { Track = track, Time = os.clock() })
								counterDiag("BLOCK_DETECT", "src=stand", "player=" .. tostring(player.Name),
									"name=" .. tostring(track.Name), "id=" .. tostring(sanimId),
									string.format("dist=%.1f", dist), "blockTapDelay=" .. tostring(blockTapDelay),
									"holdForCounter=" .. tostring(autoCounterEnabled and blockHoldForCounter or blockTapDuration))
								return true, track
							end
						end
					end
				end
end
end
end

local function triggerCounterM1(tag)
	counterDiag("M1_SEND", "src=" .. tostring(tag or "?"),
		"counterGen=" .. tostring(counterGen),
		"transitioning=" .. tostring(transitioningToCounter),
		counterDiagBlocking())
	local success, err = pcall(function()
		local bp = LocalPlayer:FindFirstChild("Backpack")
		local input = bp and bp:FindFirstChild("Input")
		if input then
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
			counterDiag("M1_PATH", "src=" .. tostring(tag or "?"), "path=input:FireServer")
			input:FireServer("M1", {
				air = false,
				mousehit = root.CFrame,
				md = Vector3.zero,
				dodgevelo = nil,
				skeydown = false,
				skeyreal = false
			})
			return
			end
		end

		counterDiag("M1_PATH", "src=" .. tostring(tag or "?"), "path=mouseFallback")
		if mouse1click then
			mouse1click()
		else
			local mousePos = UserInputService:GetMouseLocation()
			VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 0)
			task.spawn(function()
				task.wait(0.01) -- Release M1 on the next frame to prevent locking
				VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 0)
			end)
		end
	end)
	if not success then
		counterDiag("M1_ERROR", "src=" .. tostring(tag or "?"), tostring(err))
		do end
		local mousePos = UserInputService:GetMouseLocation()
		VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 0)
		task.spawn(function()
			task.wait(0.01)
			VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 0)
		end)
	end
end

local function doParryTap(track)
	if blockingState then return end
	blockGen = blockGen + 1
	local myGen = blockGen
	blockingState = true
	blockStartTime = os.clock()
	counterDiag("PARRY_TAP_START", "gen=" .. tostring(myGen), "blockTapDelay=" .. tostring(blockTapDelay),
		"hold=" .. tostring(autoCounterEnabled and blockHoldForCounter or blockTapDuration),
		"track=" .. tostring(track and track.Name))

	task.spawn(function()
		if blockTapDelay > 0 then
			task.wait(blockTapDelay)
		end

		-- Stale tap: a newer tap owns the key now, touch nothing.
		if myGen ~= blockGen then
			counterDiag("PARRY_TAP_STALE", "gen=" .. tostring(myGen), "blockGen=" .. tostring(blockGen))
			return
		end
		-- Ensure we are still in blockingState and haven't transitioned to counter during the wait
		if blockingState and not transitioningToCounter then
			scriptFDown()
			counterDiag("PARRY_TAP_DOWN", "gen=" .. tostring(myGen),
				"hold=" .. tostring(autoCounterEnabled and blockHoldForCounter or blockTapDuration))
			-- Balance flag: if a newer generation kills us after this point,
			-- we MUST release our own press on the way out, otherwise the
			-- game is left holding F with nobody owning it (stuck block that
			-- only a physical F cycle clears). The killer always unblocks
			-- first (counters scriptFUp unconditionally; a newer tap sends
			-- its own fresh down), so releasing here is safe either way.
			local sentDown = true

			local holdDuration = autoCounterEnabled and blockHoldForCounter or blockTapDuration
			local elapsed = 0
			local checkInterval = 0.02

			while elapsed < holdDuration and blockingState and not transitioningToCounter and myGen == blockGen do
				task.wait(checkInterval)
				elapsed = elapsed + checkInterval

				if track and not track.IsPlaying then
					break
				end
			end

			if myGen ~= blockGen then
				counterDiag("PARRY_TAP_KILLED", "gen=" .. tostring(myGen), "blockGen=" .. tostring(blockGen),
					"sentDown=" .. tostring(sentDown), "transitioning=" .. tostring(transitioningToCounter),
					"userHoldingF=" .. tostring(userHoldingF))
				if sentDown then
					sentDown = false
					scriptFUp()
				end
				return
			end
			if blockingState and not transitioningToCounter then
				blockingState = false
				if userHoldingF then
					-- Finger took over mid-tap: cede the key, don't cut their hold.
					counterDiag("PARRY_TAP_CEDE", "gen=" .. tostring(myGen), "userHoldingF=true")
				else
					counterDiag("PARRY_TAP_END", "gen=" .. tostring(myGen), "userHoldingF=false")
					scriptFUp()
				end
			end
		else
			counterDiag("PARRY_TAP_ABORT", "gen=" .. tostring(myGen), "blockGen=" .. tostring(blockGen),
				"blockingState=" .. tostring(blockingState),
				"transitioning=" .. tostring(transitioningToCounter))
			if myGen == blockGen then blockingState = false end
		end
	end)
end

-- ====================== AIR SWING (fixed-timing whiff punish) ======================
-- Independent from Auto Block: when Auto Counter + Air Swing are on, an enemy M1
-- animation within Swing Range starts a fixed timer (Air Swing Delay slider),
-- anchored to the swing's true start via the track's TimePosition -- so the
-- slider reads as "time since they started swinging" no matter when the
-- scan first noticed it. Crank it late to punish deep recovery.
-- When it expires the swing has landed-or-whiffed either way, so we M1 straight
-- into their recovery -- no block impact required, even while holding block.
-- F is only touched at the fire instant (release to swing, re-press to restore
-- a hold), never while tracking. A real impact always wins the race first
-- (it is event-driven and instant; the timer is deliberately biased late), so
-- whatever is still standing at expiry is a whiff by definition. M1 startups
-- cluster tightly enough that one hardcoded delay lands in recovery reliably,
-- and our own M1 startup absorbs the leftover variance.
local AIR_SWING_TIMEOUT = 1.5 -- backstop: must exceed max slider delay + MAX_LATE
local AIR_SWING_MAX_LATE = 0.25 -- max seconds past the delay we still punish (older = too stale, drop it)
local AIR_SWING_SELF_GUARD = 0.15 -- seconds after our own M1 that we don't arm a new punish (room to block)
local AIR_SWING_FRESH_WINDOW = 0.25 -- only arm on swings first seen this early in playback (larger = stale track, skip it)
local airSwingArmed = nil -- { root, t0 } (tracking only, never touches block)

-- True when WE are holding block right now (key down, or the game showing it).
-- Air Swing only answers swings fired while this holds -- see the arm gate.
local function isAirSwingHolding()
	if UserInputService:IsKeyDown(Enum.KeyCode.F) then return true end
	local c = LocalPlayer.Character
	if not c then return false end
	local b = c:FindFirstChild("Blocking")
	if b then
		if b:IsA("BoolValue") or b:IsA("ValueBase") then
			return b.Value == true
		end
		return true
	end
	if c:GetAttribute("Blocking") == true then return true end
	return false
end

local function findAirSwingTarget(localHrp)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Name ~= LocalPlayer.Name and player.Character then
			if teamCheckEnabled and isTeammate(player) then continue end

			local char = player.Character
			local blockingChild = char:FindFirstChild("Blocking")
			local isBlocking = false
			if blockingChild then
				if blockingChild:IsA("BoolValue") or blockingChild:IsA("ValueBase") then
					isBlocking = blockingChild.Value == true
				else
					isBlocking = true
				end
			end
			if isBlocking or char:GetAttribute("Blocking") == true then continue end

			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then continue end

			local verticalDist = math.abs(hrp.Position.Y - localHrp.Position.Y)
			if verticalDist > 11 then continue end
			local dist = (hrp.Position - localHrp.Position).Magnitude
			if dist > swingRange then continue end

			local animator = hum:FindFirstChildOfClass("Animator")
			local playingTracks = animator and animator:GetPlayingAnimationTracks() or hum:GetPlayingAnimationTracks()

			for _, track in ipairs(playingTracks) do
				local animId = track.Animation and track.Animation.AnimationId
				if not animId then continue end

				local alreadySeen = false
				for _, item in ipairs(lastBlockedAnims) do
					if item.Track == track then alreadySeen = true; break end
				end
				if alreadySeen then continue end

			local animIdNum = (tostring(animId):match("%d+")) or ""
			if sharedM1AnimIds[animIdNum] then
					table.insert(lastBlockedAnims, { Track = track, Time = os.clock() })
					return track, hrp
				end
			end
			-- Stand/summon M1 for this same player (Jotaro-style: anim lives on Stands/<username>)
			do
				local standHums = getStandHums(player)
				for _, shum in ipairs(standHums) do
					local sanim = shum:FindFirstChildOfClass("Animator")
					local stracks = sanim and sanim:GetPlayingAnimationTracks() or shum:GetPlayingAnimationTracks()
					local sroot = shum.Parent and (shum.Parent:FindFirstChild("HumanoidRootPart") or shum.Parent:FindFirstChildWhichIsA("BasePart"))
					for _, track in ipairs(stracks) do
						local sanimId = track.Animation and track.Animation.AnimationId
						if not sanimId then continue end
						local dup = false
						for _, item in ipairs(lastBlockedAnims) do
							if item.Track == track then dup = true; break end
						end
						if dup then continue end
						local snum = (tostring(sanimId):match("%d+")) or ""
						if sharedM1AnimIds[snum] then
							table.insert(lastBlockedAnims, { Track = track, Time = os.clock() })
							return track, sroot or hrp
						end
					end
				end
			end
		end
	end
	return nil
end

local function airSwingFire()
	airSwingArmed = nil
	if transitioningToCounter then
		counterDiag("AIR_FIRE_BLOCKED", "reason=transitioning", "counterGen=" .. tostring(counterGen))
		return
	end
	transitioningToCounter = true
	counterTransitionStart = os.clock()
	counterTransitionWarned = false
	counterGen = counterGen + 1
	local myGen = counterGen
	blockGen = blockGen + 1 -- invalidate any in-flight parry tap so it can't release this sequence
	lastCounterTime = os.clock()
	-- Physical finger only: IsKeyDown sees our own synthetic holds too, which is
	-- what used to resurrect stuck holds the user never asked for.
	local wasUserHolding = userHoldingF
	local hadScriptHold = blockingState
	local transitionStarted = counterTransitionStart

	counterDiag("TRANSITION_ON", "src=airswing", "gen=" .. tostring(myGen),
		"counterM1Delay=" .. tostring(counterM1Delay),
		"wasUserHolding=" .. tostring(wasUserHolding),
		"hadScriptHold=" .. tostring(hadScriptHold), counterDiagBlocking())

			-- Unblock/time/reblock mechanics only -- there is no impact trigger here.
	-- The server eats M1s thrown while blocking, so F must be released for the
	-- punish to exist at all, then re-pressed so a physical hold survives intact.
	task.spawn(function()
		local ok, err = pcall(function()
			blockingState = false
			scriptFUp()
			counterDiag("AIR_UNBLOCK", "gen=" .. tostring(myGen),
				"counterM1Delay=" .. tostring(counterM1Delay))

			-- Full Counter Delay, same as the block-impact path below: the Air
			-- Swing Delay slider positioned the punish in their recovery, this
			-- lets our block physics drop so the M1 isn't swallowed.
			task.wait(counterM1Delay)

			if myGen ~= counterGen then
				counterDiag("COUNTER_ABORT", "src=airswing", "gen=" .. tostring(myGen),
					"counterGen=" .. tostring(counterGen), "leakRisk=true",
					"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
				return
			end
			counterDiagNoteM1Send("airswing")
			triggerCounterM1("airswing")
			task.wait(0.02)
			if myGen ~= counterGen then
				counterDiag("COUNTER_ABORT", "src=airswing", "gen=" .. tostring(myGen),
					"counterGen=" .. tostring(counterGen), "leakRisk=true",
					"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
				return
			end
			triggerCounterM1("airswing")
			task.wait(0.05)
		end)
		if not ok then
			counterDiag("COUNTER_ERROR", "src=airswing", tostring(err))
		end
		if myGen ~= counterGen then
			counterDiag("COUNTER_ABORT", "src=airswing", "gen=" .. tostring(myGen),
				"counterGen=" .. tostring(counterGen), "leakRisk=true", "stage=post-task",
				"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
			return
		end
		transitioningToCounter = false
		counterDiag("TRANSITION_OFF", "src=airswing", "gen=" .. tostring(myGen),
			string.format("heldFor=%.3f", os.clock() - transitionStarted))

		if wasUserHolding and userHoldingF then
			counterDiag("REPRESS", "src=airswing", "reason=fingerStillDown",
				"autoBlockEnabled=" .. tostring(autoBlockEnabled),
				"hadScriptHold=" .. tostring(hadScriptHold))
			scriptFDown()
			if autoBlockEnabled then
				blockingState = true
				blockStartTime = os.clock()
			else
				blockingState = false
			end
		elseif hadScriptHold and autoBlockEnabled then
			-- Resume script's own hold (no finger involved).
			counterDiag("REPRESS", "src=airswing", "reason=hadScriptHold",
				"releaseOwner=none", "autoBlockEnabled=true")
			scriptFDown()
			blockingState = true
			blockStartTime = os.clock()
		else
			counterDiag("NO_REPRESS", "src=airswing",
				"wasUserHolding=" .. tostring(wasUserHolding),
				"userHoldingF=" .. tostring(userHoldingF),
				"hadScriptHold=" .. tostring(hadScriptHold),
				"autoBlockEnabled=" .. tostring(autoBlockEnabled))
		end
	end)
end

-- Global Block Impact / Stance Reset & Counter Retaliation Listener
local blockSoundConnection = nil
local blockHrpConnection = nil

local function setupGlobalCounterListener()
	if blockSoundConnection then blockSoundConnection:Disconnect() blockSoundConnection = nil end
	if blockHrpConnection then blockHrpConnection:Disconnect() blockHrpConnection = nil end

	local function isOpponentPlayingM1()
		local localChar = LocalPlayer.Character
		local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
		if not localHrp then return false end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				if teamCheckEnabled and isTeammate(player) then continue end

				local char = player.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then continue end

				local hrp = char:FindFirstChild("HumanoidRootPart")
				if not hrp then continue end

				local dist = (hrp.Position - localHrp.Position).Magnitude
				if dist > 30 then continue end

				local animator = hum:FindFirstChildOfClass("Animator")
				local tracks = animator and animator:GetPlayingAnimationTracks() or hum:GetPlayingAnimationTracks()
				for _, track in ipairs(tracks) do
					local animId = track.Animation and track.Animation.AnimationId
					if animId then
						local idNum = tostring(animId):match("%d+") or ""
						if sharedM1AnimIds[idNum] then
							return true
						end
					end
				end
			end
		end
		return false
	end

	local function onBlockImpact()
		do end
		if not autoCounterEnabled then
			counterDiag("IMPACT_REJECT", "reason=autoCounterOff")
			return
		end
		-- Use recent M1 detection cache (race condition fix): BlockSound can fire
		-- after the M1 anim track is no longer enumerable, so isOpponentPlayingM1()
		-- alone is unreliable. lastBlockedAnims is populated by checkShouldBlock.
		local now = os.clock()
		for i = #lastBlockedAnims, 1, -1 do
			if now - lastBlockedAnims[i].Time > 1.0 then
				table.remove(lastBlockedAnims, i)
			end
		end
		local hasRecentM1 = #lastBlockedAnims > 0
		local playingM1 = nil
		if not hasRecentM1 then playingM1 = isOpponentPlayingM1() end
		counterDiag("IMPACT_EVAL", "recentM1=" .. tostring(hasRecentM1),
			"recentCount=" .. tostring(#lastBlockedAnims),
			"playingM1=" .. tostring(playingM1),
			"transitioning=" .. tostring(transitioningToCounter),
			"counterGen=" .. tostring(counterGen))
		if not hasRecentM1 and not playingM1 then
			counterDiag("IMPACT_REJECT", "reason=noM1")
			return
		end
		
		if transitioningToCounter then
			counterDiag("IMPACT_REJECT", "reason=transitioning", "counterGen=" .. tostring(counterGen))
			return
		end
		transitioningToCounter = true
		counterTransitionStart = os.clock()
		counterTransitionWarned = false
		counterGen = counterGen + 1
		local myGen = counterGen
		blockGen = blockGen + 1 -- invalidate any in-flight parry tap so it can't release this sequence
		airSwingArmed = nil -- impact owns this moment: drop any air tracking, no double punish

		-- Physical finger only (fix 2): IsKeyDown also sees our own synthetic
		-- parry hold, which used to re-apply a hold after the counter even when
		-- the user had already let go -> stuck block.
		local wasUserHolding = userHoldingF
		local transitionStarted = counterTransitionStart
		local blockingStateBefore = blockingState
		counterDiag("TRANSITION_ON", "src=impact", "gen=" .. tostring(myGen),
			"counterM1Delay=" .. tostring(counterM1Delay),
			"wasUserHolding=" .. tostring(wasUserHolding),
			"blockingStateBefore=" .. tostring(blockingStateBefore), counterDiagBlocking())
		
		lastCounterTime = os.clock() -- Lockout AutoBlock IMMEDIATELY on hit!
		
		task.spawn(function()
			local success, err = pcall(function()
				-- Force clear blockingState so parry loop is ready
				blockingState = false
				
				-- Release F key IMMEDIATELY to exit block state instantly
				scriptFUp()
				counterDiag("IMPACT_UNBLOCK", "gen=" .. tostring(myGen),
					"counterM1Delay=" .. tostring(counterM1Delay))
				do end
				
				-- Wait counterM1Delay to let block physics drop (tunable via Counter Delay slider)
				task.wait(counterM1Delay)

				if myGen ~= counterGen then
					counterDiag("COUNTER_ABORT", "src=impact", "gen=" .. tostring(myGen),
						"counterGen=" .. tostring(counterGen), "leakRisk=true",
						"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
					return
				end
				
				do end
				counterDiagNoteM1Send("impact")
				triggerCounterM1("impact")
				task.wait(0.02)
				if myGen ~= counterGen then
					counterDiag("COUNTER_ABORT", "src=impact", "gen=" .. tostring(myGen),
						"counterGen=" .. tostring(counterGen), "leakRisk=true",
						"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
					return
				end
				triggerCounterM1("impact")
				
				task.wait(0.05)
			end)
			if myGen ~= counterGen then
				counterDiag("COUNTER_ABORT", "src=impact", "gen=" .. tostring(myGen),
					"counterGen=" .. tostring(counterGen), "leakRisk=true", "stage=post-task",
					"transitioning=" .. tostring(transitioningToCounter), counterDiagBlocking())
				return
			end
			if not success then
				counterDiag("COUNTER_ERROR", "src=impact", tostring(err))
				do end
				blockingState = false
				scriptFUp()
			end
			transitioningToCounter = false
			counterDiag("TRANSITION_OFF", "src=impact", "gen=" .. tostring(myGen),
				string.format("heldFor=%.3f", os.clock() - transitionStarted))

			-- Re-apply block after the counter only if the finger is still down,
			-- so holding F the whole time keeps blocking after the counter M1.
			if wasUserHolding and userHoldingF then
				counterDiag("REPRESS", "src=impact", "reason=fingerStillDown",
					"autoBlockEnabled=" .. tostring(autoBlockEnabled))
				blockingState = true
				blockStartTime = os.clock()
				scriptFDown()
				do end
			else
				counterDiag("NO_REPRESS", "src=impact",
					"wasUserHolding=" .. tostring(wasUserHolding),
					"userHoldingF=" .. tostring(userHoldingF))
			end
		end)
	end

	local function bindSound(sound)
		local conn1 = sound.Played:Connect(function()
			counterDiag("BLOCK_SOUND", "name=" .. tostring(sound.Name),
				"parent=" .. tostring(sound.Parent and sound.Parent.Name))
			onBlockImpact()
		end)
		table.insert(connections, conn1)
	end

	local char = LocalPlayer.Character
	local hrp = char and char:WaitForChild("HumanoidRootPart", 5)
	if hrp then
		-- Connect static BlockSound if already loaded in character
		local existingSound = hrp:FindFirstChild("BlockSound")
		if existingSound then
			bindSound(existingSound)
			do end
		end

		-- Listen for BlockSound being added or played dynamically
		blockHrpConnection = hrp.ChildAdded:Connect(function(child)
			if child:IsA("Sound") and (string.find(child.name:lower(), "block") or child.name == "BlockSound") then do end
				bindSound(child)
			end
		end)
		table.insert(connections, blockHrpConnection)
	end
end

-- Hook global listener to character lifecycle
if LocalPlayer.Character then
	task.spawn(setupGlobalCounterListener)
end
table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	setupGlobalCounterListener()
end))

-- Diagnostic watchdog: catches the "transitioningToCounter got latched" failure.
-- A healthy counter clears well under 0.5s (max slider + fixed 0.07s tail).
local counterDiagNextFileFlush = 0
table.insert(connections, RunService.Heartbeat:Connect(function()
	local nowClock = os.clock()
	if nowClock >= counterDiagNextFileFlush then
		counterDiagNextFileFlush = nowClock + 0.5
		counterDiagFlush()
	end
	if not transitioningToCounter then
		counterTransitionWarned = false
		return
	end
	local elapsed = os.clock() - counterTransitionStart
	if elapsed > 0.5 and not counterTransitionWarned then
		counterTransitionWarned = true
		counterDiag("TRANSITION_STUCK", string.format("elapsed=%.3f", elapsed),
			"counterGen=" .. tostring(counterGen),
			"lastCounterAge=" .. string.format("%.3f", os.clock() - lastCounterTime),
			counterDiagBlocking())
		if counterDiagEnv.PiggyCounterPrint then
			warn(string.format("[CDIAG] transitioningToCounter has been true for %.2fs - counter state is latched. Re-execute the script to clear it.", elapsed))
		end
	end
end))

-- ====================== SYSTEM CONNECTIONS ======================

-- Keybind Press to Toggle lock target
table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
	-- Capture manual M1 clicks to immediately lock out parry detection
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		lastLocalM1Time = os.clock()
	end

	-- Gojo afterimage: redirect Blue dash teleport behind target (BEFORE gp check since game captures Q)
	if gojoAfterimageEnabled and gojoBlueActive and input.KeyCode == Enum.KeyCode.Q then
		gojoBlueActive = false
		local targetPart = lockedTarget
		if not targetPart or not targetPart.Parent then
			local closestPlayer = getClosestPlayer()
			if closestPlayer and closestPlayer.Character then
				targetPart = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
			end
		end
		if targetPart and targetPart.Parent then
			task.spawn(function()
				for i = 1, 5 do
					if not targetPart.Parent then break end
					local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if root then
						root.CFrame = targetPart.CFrame * CFrame.new(0, 0, 6)
					end
					task.wait(0.03)
				end
			end)
		end
	end

	-- AHK ports (fire anywhere, like the originals). Unbound key = never fires.
	do
		local M = getgenv().PiggyMacro
		if M then
			local k = input.KeyCode
			local function tap3()
				local BC = LocalPlayer.PlayerScripts:FindFirstChild("BaseContext")
				local m3 = BC and BC:FindFirstChild("Move3")
				if m3 then m3:Fire(true) task.wait(0.03) m3:Fire(false) end
			end
			local function tapQ()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
				task.wait(0.05)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
			end
			if M.gtKey and k == M.gtKey then
				if M.gtBusy then
					local DS = getgenv().PiggyMacroDbg
					if DS then table.insert(DS, string.format("SKIP-busy %.2f", os.clock())) end
				else
				M.gtBusy = true
				task.spawn(function()
					pcall(function()
						-- recorded manual cadence (wall-clock exact, VIM-only):
						-- instant 3-tap, +120ms M1 (30ms hold), +60ms instant
						-- 3-tap, +10ms Q (10ms tap). task.wait for long gaps
						-- (yields the scheduler), spin-wait only for sub-50ms
						-- gaps (a 200ms+ hard spin hitches follow-up inputs).
						local D = getgenv().PiggyMacroDbg
						if D then
							table.insert(D, string.format("start %.2f", os.clock()))
						end
						local function nap(s)
							if s >= 0.05 then task.wait(s) return end
							local t = os.clock() + s
							while os.clock() < t do end
						end
						local VIM = VirtualInputManager
						VIM:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
						VIM:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
						nap(0.12)
						local mp = UserInputService:GetMouseLocation()
						VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, true, game, 0)
						nap(0.03)
						VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, false, game, 0)
						nap(0.06)
						VIM:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
						VIM:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
						nap(0.03)
						VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
						nap(0.01)
						VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
						local D2 = getgenv().PiggyMacroDbg
						if D2 then
							table.insert(D2, string.format("end %.2f", os.clock()))
						end
					end)
					M.gtBusy = false
				end)
				end
			end
			if M.tbKey and not M.tbBusy and k == M.tbKey then
				M.tbBusy = true
				task.spawn(function()
					pcall(function()
						-- V teleport: single 3, slider delay, Q (VIM-only).
						local dly = tonumber(getgenv().PiggyMacro.qdelay) or 0.09
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Three, false, game)
						task.wait(0.005)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Three, false, game)
						task.wait(dly)
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
						task.wait(0.005)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
					end)
					M.tbBusy = false
				end)
			end
		end
	end

	if gp then return end
	
	-- Toggle lock target
	if guiEnabled and input.KeyCode == lockKey then
		if lockedTarget then
			lockedTarget = nil
			active = false
		else
			lockedTarget = getTargetNearCursor(150)
			active = lockedTarget ~= nil
		end
	end

	-- Toggle auto counter keybind
	if input.KeyCode == counterKey then
		autoCounterEnabled = not autoCounterEnabled
		updateCounterLabel()
		if autoCounterToggleObj then
			autoCounterToggleObj.Set(autoCounterEnabled)
		end
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Auto Counter",
				Text = "Auto Counter is now " .. (autoCounterEnabled and "Enabled" or "Disabled"),
				Duration = 2
			})
		end)
	end

	-- Toggle auto infinity keybind
	if input.KeyCode == autoInfinityKey then
		autoInfinityEnabled = not autoInfinityEnabled
		if autoInfinityEnabled then
			pcall(autoInfinityLoadDatabase)
		end
		if autoInfinityToggleObj then
			autoInfinityToggleObj.Set(autoInfinityEnabled)
		end
		updateInfinityLabel()
		if autoInfinityEnabled then autoInfinityShowNotice() else autoInfinityNotice.Visible = false end
		autoSaveSettings()
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "AutoInfinity",
				Text = "AutoInfinity is now " .. (autoInfinityEnabled and "Enabled" or "Disabled"),
				Duration = 2
			})
		end)
	end

	-- Triggerbot Move 1 fire request: start trying to fire slot 1.
	-- Disabled master toggle means keybinds are ignored entirely.
	-- Re-pressing the same key while its request is still pending cancels it
	-- early (unmarks if no other request remains) instead of retargeting.
	if input.KeyCode == tbState.key and tbState.enabled then
		if tbState.pending1 then
			tbState.clearRequest(1, "Triggerbot cancelled (slot " .. tostring(tbState.slot) .. ")")
		else
			tbState.pending1 = true
			tbState.req1 = os.clock()
			tbState.retarget = true -- re-mark whoever is under the crosshair now
			autoSaveSettings()
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "Triggerbot",
					Text = "Firing move slot " .. tostring(tbState.slot) .. " when clean",
					Duration = 1.5
				})
			end)
		end
	end

	-- Triggerbot Move 2 fire request: start trying to fire slot 2.
	-- Disabled master toggle means keybinds are ignored entirely.
	-- Re-pressing the same key while its request is still pending cancels it
	-- early (unmarks if no other request remains) instead of retargeting.
	if input.KeyCode == tbState.key2 and tbState.enabled then
		if tbState.pending2 then
			tbState.clearRequest(2, "Triggerbot cancelled (slot " .. tostring(tbState.slot2) .. ")")
		else
			tbState.pending2 = true
			tbState.req2 = os.clock()
			tbState.retarget = true -- re-mark whoever is under the crosshair now
			autoSaveSettings()
			pcall(function()
				game:GetService("StarterGui"):SetCore("SendNotification", {
					Title = "Triggerbot",
					Text = "Firing move slot " .. tostring(tbState.slot2) .. " when clean",
					Duration = 1.5
				})
			end)
		end
	end

	-- Toggle fly keybind (unbound by default)
	if flyKey and input.KeyCode == flyKey then
		setFly(not flyEnabled)
		if flyToggleObj then flyToggleObj.Set(flyEnabled) end
		autoSaveSettings()
	end

	-- Toggle Piggy Hub UI visibility (mainFrame only, keep Counter/Infinity labels)
	if input.KeyCode == toggleUIKey then
		uiVisible = not uiVisible
		if mainFrame then
			mainFrame.Visible = uiVisible
		end
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "Piggy Hub",
				Text = uiVisible and "UI Shown" or "UI Hidden",
				Duration = 1.5
			})
		end)
	end
end))

-- Dragging
local dragging = false
local dragStart, startPos

table.insert(connections, titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
	end
end))

table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end))

-- Minimize
table.insert(connections, minimizeButton.MouseButton1Click:Connect(function()
	minimized = not minimized
	bodyFrame.Visible = not minimized
	mainFrame.Size = minimized and UDim2.new(0, 470, 0, 38) or UDim2.new(0, 470, 0, 500)
end))

-- Silent facing helper: yaw-faces our character toward targetPos. Shared by the
-- RenderStepped lock loop and the Heartbeat enforcer below, both suspended
-- while sprint-strafing (see isSprintPause).
-- Root cause of the old failure: ABA's own client loop hard-snaps the root to the
-- CAMERA facing every frame (except while sprinting, which is why silent only
-- appeared to work while running). It skips the snap while a "NoRotate" state
-- object lives in our character, so we hold one (tagged PiggySilent) instead of
-- racing its write. AutoRotate is still held off as backup, and the marker is
-- removed by the enforcer/unload the moment silent disengages.
local function applySilentFacing(targetPos)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp then return end
	if hum and hum.Health > 0 and hum.AutoRotate then
		hum.AutoRotate = false
		silentRotateOff = true
	end
	local flat = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
	if flat.Magnitude > 0.01 then
		hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flat)
	end
end

local function ensureSilentNoRotate(char)
	if not char then return end
	if silentNoRotateObj and silentNoRotateObj.Parent == char then return end
	if silentNoRotateObj then
		pcall(function() silentNoRotateObj:Destroy() end)
		silentNoRotateObj = nil
	end
	local ok, marker = pcall(function()
		local f = Instance.new("Folder")
		f.Name = "NoRotate"
		local tag = Instance.new("BoolValue")
		tag.Name = "PiggySilent"
		tag.Value = true
		tag.Parent = f
		f.Parent = char
		return f
	end)
	if ok and marker then silentNoRotateObj = marker end
end

local function clearSilentNoRotate()
	if silentNoRotateObj then
		pcall(function() silentNoRotateObj:Destroy() end)
		silentNoRotateObj = nil
	end
end

-- Sprint-pause check: silent facing pauses while sprint-strafing
-- (Shift + A/D/S) and runs at all other times, including sprinting forward.
local function isSprintPause()
	local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	if not shift then return false end
	return UserInputService:IsKeyDown(Enum.KeyCode.S)
		or UserInputService:IsKeyDown(Enum.KeyCode.A)
		or UserInputService:IsKeyDown(Enum.KeyCode.D)
end

-- NOTE (retired): redirecting UseMove packets (targ/mousehit/camdir) was tested
-- live and the server drops every mutated packet while accepting identical
-- genuine ones, so packet spoofing cannot deliver target-locked moves on this
-- server. Facing (above) is the part that works; target-gated moves need
-- genuine aim (Camera mode). One-time teardown below in case an older
-- execution left the spoof hook live.
do
	if _G.PiggySilentAimOld and hookmetamethod then
		pcall(hookmetamethod, game, "__namecall", _G.PiggySilentAimOld)
	end
	_G.PiggySilentAimOld = nil
	_G.PiggySilentAimMode = nil
	_G.PiggySilentAimStats = nil
end

-- Main Loop (Camera Lock)
table.insert(connections, RunService.RenderStepped:Connect(function()
	refreshLockIndicator()
	if not guiEnabled or not active or not lockedTarget or not lockedTarget.Parent then return end

	local targetPlayer = Players:GetPlayerFromCharacter(lockedTarget.Parent)
	if teamCheckEnabled and targetPlayer and isTeammate(targetPlayer) then
		lockedTarget = nil active = false return
	end

	local targetPos = lockedTarget.Position
	if predictionEnabled then
		targetPos = targetPos + lockedTarget.Velocity * predictionStrength
	end

	if lockMode == "Silent" then
		-- Silent: camera never moves; our character yaw-faces the target,
		-- pausing only while sprint-strafing.
		if not isSprintPause() then
			applySilentFacing(targetPos)
		end
		return
	end

	local currentPos = Camera.CFrame.Position
	local targetCFrame = CFrame.new(currentPos, targetPos)
	Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothness)
end))

-- Silent enforcer: holds the NoRotate marker (which makes the game's own loop
-- skip its camera snap) and re-applies facing after physics.
table.insert(connections, RunService.Heartbeat:Connect(function()
	local silentOn = guiEnabled and active and lockMode == "Silent"
		and lockedTarget and lockedTarget.Parent
	local faceNow = false
	local targetPos = nil
	if silentOn then
		local targetPlayer = Players:GetPlayerFromCharacter(lockedTarget.Parent)
		if not (teamCheckEnabled and targetPlayer and isTeammate(targetPlayer)) then
			if not isSprintPause() then
				targetPos = lockedTarget.Position
				if predictionEnabled then
					targetPos = targetPos + lockedTarget.Velocity * predictionStrength
				end
				faceNow = true
			end
		end
	end
	if not faceNow then
		clearSilentNoRotate()
		if silentRotateOff then
			silentRotateOff = false
			pcall(function()
				local c = LocalPlayer.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if h then h.AutoRotate = true end
			end)
		end
		return
	end

	ensureSilentNoRotate(LocalPlayer.Character)
	applySilentFacing(targetPos)
end))

-- Real-time update loop for Ult ESP (Displays only [Value%], works independently of Enable toggle)
table.insert(connections, RunService.RenderStepped:Connect(function()
	for player, label in pairs(cdState.charge) do
		local success, err = pcall(function()
			if player and player.Parent and label and label.Parent then
				local char = player.Character
				local head = char and getCharacterHeadNonYielding(char)
				if head and ultEspEnabled then
					-- If Adornee is detached or points to an old character, re-attach it instantly
					if label.Parent.Adornee ~= head then
						label.Parent.Adornee = head
					end
					label.Parent.Enabled = true
					local rawVal = getPlayerCharge(player)
					local text, color = calculateChargeDisplay(rawVal)
					label.Text = "[" .. text .. "]"
					label.TextColor3 = color
				else
					label.Parent.Enabled = false
				end
			else
				local billboard = parentGui:FindFirstChild(player.Name .. "_ChargeBillboard")
				if billboard then billboard:Destroy() end
				cdState.charge[player] = nil
			end
		end)
		if not success then do end
		end
	end
end))

local lastMoveEspUpdate = 0
table.insert(connections, RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local heavyDue = now - lastMoveEspUpdate >= 0.1
	if heavyDue then lastMoveEspUpdate = now end
	for player, container in pairs(cdState.move) do
		local success, err = pcall(function()
			if player and player.Parent and container and container.Parent then
				local char = player.Character
				local head = char and getCharacterHeadNonYielding(char)
				if head and (espState.moveEnabled or espState.inputsEnabled) then
					if container.Parent.Adornee ~= head then
						container.Parent.Adornee = head
					end
					container.Parent.Enabled = true
				else
					container.Parent.Enabled = false
				end
				
				if heavyDue and head and (espState.moveEnabled or espState.inputsEnabled) then
					local cds = getPlayerCooldowns(player)
					
					-- 1. Gather names of moves currently on cooldown
					local activeNames = {}
					for _, cd in ipairs(cds) do
						activeNames[cd.Name] = true
					end
					
					-- 2. Destroy box frames for moves that are no longer on cooldown
					for _, child in ipairs(container:GetChildren()) do
						if child:IsA("Frame") and child.Name ~= "UIListLayout" then
							if not activeNames[child.Name] then
								child:Destroy()
							end
						end
					end
					
					-- 3. Create or update box frames for active cooldowns
					if #cds > 0 then
						for idx, cd in ipairs(cds) do
							local box = container:FindFirstChild(cd.Name)
							if not box then
								box = Instance.new("Frame")
								box.Name = cd.Name
								box.Size = UDim2.new(1, 0, 0.227, 0)
								box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
								box.BorderSizePixel = 0
								box.Parent = container
								
								local corner = Instance.new("UICorner")
								corner.CornerRadius = UDim.new(0, 4)
								corner.Parent = box
								
								local gradient = Instance.new("UIGradient")
								gradient.Color = ColorSequence.new{
									ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 220, 60)),
									ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 90, 20))
								}
								gradient.Rotation = 90
								gradient.Parent = box
								
								local stroke = Instance.new("UIStroke")
								stroke.Thickness = 1.5
								stroke.Color = Color3.fromRGB(60, 10, 10)
								stroke.Parent = box
								
								local numLabel = Instance.new("TextLabel")
								numLabel.Name = "SlotNumber"
								numLabel.Size = UDim2.new(0.3, 0, 0.3, 0)
								numLabel.Position = UDim2.new(0, 4, 0, 2)
								numLabel.BackgroundTransparency = 1
								numLabel.Text = tostring(idx)
								numLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
								numLabel.TextScaled = true
								numLabel.Font = Enum.Font.GothamBold
								numLabel.TextXAlignment = Enum.TextXAlignment.Left
								numLabel.TextYAlignment = Enum.TextYAlignment.Top
								numLabel.Parent = box
								
								local numStroke = Instance.new("UIStroke")
								numStroke.Thickness = 1
								numStroke.Color = Color3.fromRGB(0, 0, 0)
								numStroke.Parent = numLabel
								
								local cdLabel = Instance.new("TextLabel")
								cdLabel.Name = "CooldownText"
								cdLabel.Size = UDim2.new(1, -4, 1, -12)
								cdLabel.Position = UDim2.new(0, 2, 0, 6)
								cdLabel.BackgroundTransparency = 1
								cdLabel.Text = cd.Name
								cdLabel.TextScaled = true
								cdLabel.TextWrapped = true
								cdLabel.Font = Enum.Font.GothamBold
								cdLabel.TextXAlignment = Enum.TextXAlignment.Center
								cdLabel.TextYAlignment = Enum.TextYAlignment.Center
								cdLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
								cdLabel.Parent = box

								local cdStroke = Instance.new("UIStroke")
								cdStroke.Thickness = 1.2
								cdStroke.Color = Color3.fromRGB(0, 0, 0)
								cdStroke.Parent = cdLabel
								
								local cdOverlay = Instance.new("TextLabel")
								cdOverlay.Name = "CooldownOverlay"
								cdOverlay.Size = UDim2.new(1, 0, 1, 0)
								cdOverlay.Position = UDim2.new(0, 0, 0, 0)
								cdOverlay.BackgroundTransparency = 1
								cdOverlay.Text = ""
								cdOverlay.TextScaled = true
								cdOverlay.Font = Enum.Font.GothamBold
								cdOverlay.TextXAlignment = Enum.TextXAlignment.Center
								cdOverlay.TextYAlignment = Enum.TextYAlignment.Center
								cdOverlay.TextColor3 = Color3.fromRGB(255, 75, 75)
								cdOverlay.Visible = false
								cdOverlay.Parent = box
								
								local overStroke = Instance.new("UIStroke")
								overStroke.Thickness = 1.5
								overStroke.Color = Color3.fromRGB(0, 0, 0)
								overStroke.Parent = cdOverlay
							end
							
							local gradient = box:FindFirstChildOfClass("UIGradient")
							local numLabel = box:FindFirstChild("SlotNumber")
							local cdLabel = box:FindFirstChild("CooldownText")
							local cdOverlay = box:FindFirstChild("CooldownOverlay")
							local flashKey = player.Name .. "_" .. cd.Name
							local flashTime = cdState.flashTimes[flashKey]
							local isFlashing = flashTime and (now - flashTime) < 0.15
							
							if numLabel then numLabel.Text = tostring(idx) end
							
							if isFlashing then
								if gradient then gradient.Color = ColorSequence.new(Color3.new(1, 1, 1)) end
								if cdLabel then 
									cdLabel.Visible = true
									cdLabel.TextColor3 = Color3.new(0, 0, 0)
									local str = cdLabel:FindFirstChildOfClass("UIStroke")
									if str then str.Enabled = false end
								end
								if cdOverlay then cdOverlay.Visible = false end
							elseif cd.IsReady then
								if gradient then
									gradient.Color = ColorSequence.new{
										ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 220, 60)),
										ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 90, 20))
									}
								end
								if cdLabel then 
									cdLabel.Visible = true
									cdLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
									local str = cdLabel:FindFirstChildOfClass("UIStroke")
									if str then str.Enabled = true end
								end
								if cdOverlay then cdOverlay.Visible = false end
							else
								if gradient then
									gradient.Color = ColorSequence.new{
										ColorSequenceKeypoint.new(0, Color3.fromRGB(230, 35, 35)),
										ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 15, 15))
									}
								end
								if cdLabel then 
									cdLabel.Visible = true
									cdLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
									local str = cdLabel:FindFirstChildOfClass("UIStroke")
									if str then str.Enabled = true end
								end
								if cdOverlay then 
									cdOverlay.Visible = true
									cdOverlay.Text = string.format("%.0f", cd.Remaining)
								end
							end
					end
				end
			end
			else
				-- Only clear tracking reference if the player actually left the game to prevent race conditions during respawns
				if not player or not player.Parent then
					local billboard = parentGui:FindFirstChild(player.Name .. "_MoveBillboard")
					if billboard then billboard:Destroy() end
					cdState.move[player] = nil
				end
			end
		end)
		if not success then do end
		end
	end
end))

-- ESP Arrows Loop
table.insert(connections, RunService.RenderStepped:Connect(updateArrows))

-- Auto Block / Parry Loop (throttled to 30ms to reduce stutter)
local lastBlockCheck = 0
table.insert(connections, RunService.RenderStepped:Connect(function()
	if os.clock() - lastCounterTime < counterLockoutDuration then return end
	local now = os.clock()
	if now - lastBlockCheck < 0.03 then return end
	lastBlockCheck = now
	local shouldBlock, activeTrack = checkShouldBlock()
	if shouldBlock then
		doParryTap(activeTrack)
	end
end))

-- Air Swing Loop (every frame: the punish timing is exact, polling lag shifts it 1:1)
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoCounterEnabled or not airSwingEnabled then
		airSwingArmed = nil
		return
	end
	-- A counter is mid-flight (ours just fired, or impact cleared the arm):
	-- wait it out WITHOUT dropping the arm; staleness rules below decide
	if transitioningToCounter then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airTransition", 1, "AIR_SKIP", "reason=transitioning",
				"counterGen=" .. tostring(counterGen))
		end
		return
	end
	if os.clock() - lastCounterTime < counterLockoutDuration then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airLockout", 1, "AIR_SKIP", "reason=counterLockout",
				string.format("age=%.3f", os.clock() - lastCounterTime))
		end
		return
	end
	local now = os.clock()

	local localChar = LocalPlayer.Character
	local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
	if not localChar or not localHrp or not localHum or localHum.Health <= 0 then
		airSwingArmed = nil
		return
	end

	if not _G.PiggyAnimCache then _G.PiggyAnimCache = {} end
	local animNow = os.clock()
	for i = #lastBlockedAnims, 1, -1 do
		if animNow - lastBlockedAnims[i].Time > 2.0 then
			table.remove(lastBlockedAnims, i)
		end
	end

	if airSwingArmed then
		local armed = airSwingArmed
		local root = armed.root
		if not root or not root.Parent or (now - armed.t0) > AIR_SWING_TIMEOUT then
			counterDiag("AIR_DROP", "reason=rootGoneOrTimeout",
				string.format("age=%.3f", now - armed.t0), "timeout=" .. tostring(AIR_SWING_TIMEOUT))
			airSwingArmed = nil -- enemy gone / stale: nothing spent, nothing touched
			return
		end
		-- Not yet: the swing hasn't landed-or-whiffed
		if (now - armed.t0) < airSwingDelay then return end
		-- Too stale to punish cleanly (kept missing its window): drop it
		if (now - armed.t0) > airSwingDelay + AIR_SWING_MAX_LATE then
			counterDiag("AIR_DROP", "reason=tooStale",
				string.format("age=%.3f", now - armed.t0),
				"delay=" .. tostring(airSwingDelay),
				"maxLate=" .. tostring(AIR_SWING_MAX_LATE))
			airSwingArmed = nil
			return
		end
		-- Cooldown active: hold the arm and retry next frame, don't burn the track
		if now - lastAirSwingTime < airSwingCooldown then
			if counterDiagEnv.PiggyCounterVerbose then
				counterDiagThrottled("airCooldown", 1, "AIR_SKIP", "reason=airSwingCooldown",
					string.format("age=%.3f", now - lastAirSwingTime))
			end
			return
		end
		local dist = (root.Position - localHrp.Position).Magnitude
		if dist > swingRange then
			counterDiag("AIR_DROP", "reason=outOfRange",
				string.format("dist=%.1f", dist), "range=" .. tostring(swingRange))
			airSwingArmed = nil -- out of Swing Range: don't whiff
			return
		end
		-- Deliberately no block yield: a real impact already won the race above
		-- (transitioningToCounter), so this swing whiffed -- punish it even held.
		counterDiag("AIR_FIRE", string.format("age=%.3f", now - armed.t0),
			"delay=" .. tostring(airSwingDelay),
			"counterM1Delay=" .. tostring(counterM1Delay),
			string.format("dist=%.1f", dist),
			"autoBlockEnabled=" .. tostring(autoBlockEnabled))
		lastAirSwingTime = now
		airSwingArmed = nil
		airSwingFire()
		return
	end

	-- Not armed: cooldown gate, then look for a fresh enemy swing
	if now - lastAirSwingTime < airSwingCooldown then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airCooldownIdle", 1, "AIR_SKIP", "reason=airSwingCooldown",
				string.format("age=%.3f", now - lastAirSwingTime))
		end
		return
	end

	-- Only answer swings fired while WE are holding block. If our own M1 is
	-- still going (key up, no block live), let this one pass untouched until
	-- we're blocking again -- nothing is consumed, so it re-evaluates then.
	if not isAirSwingHolding() then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airNotHolding", 1, "AIR_SKIP", "reason=notHoldingBlock")
		end
		return
	end

	-- Don't block-cancel our own attack to chase a punish
	local localAnimator = localHum:FindFirstChildOfClass("Animator")
	local localTracks = localAnimator and localAnimator:GetPlayingAnimationTracks() or localHum:GetPlayingAnimationTracks()
	local localSwingName, localSwingId
	for _, t in ipairs(localTracks) do
		local n = t.Name:lower()
		if string.find(n, "light") or string.find(n, "punch") or string.find(n, "atk") or string.find(n, "slash") or string.find(n, "swing") then
			localSwingName = t.Name
			localSwingId = t.Animation and t.Animation.AnimationId
			local prevLocalM1 = lastLocalM1Time
			lastLocalM1Time = now
			counterDiagThrottled("airSelfSwing", 0.5, "AIR_SKIP", "reason=ownSwing",
				"name=" .. tostring(localSwingName), "id=" .. tostring(localSwingId),
				string.format("sinceLastLocalM1=%.3f", now - prevLocalM1))
			return
		end
	end
	if now - lastLocalM1Time < AIR_SWING_SELF_GUARD then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airSelfGuard", 1, "AIR_SKIP", "reason=selfGuard",
				string.format("age=%.3f", now - lastLocalM1Time))
		end
		return
	end

	local track, enemyRoot = findAirSwingTarget(localHrp)
	if enemyRoot then
		-- Anchor the timer to the animation's TRUE start, not to when we
		-- happened to notice it (gates can delay detection). The delay
		-- slider is therefore always "time since they started swinging".
		local startOffset = 0
		if track then
			pcall(function() startOffset = track.TimePosition or 0 end)
		end
		if type(startOffset) ~= "number" or startOffset < 0 then startOffset = 0 end
		-- Freshness gate: only arm on swings that genuinely just started. A
		-- track first seen deep into playback is stale, not a fresh swing --
		-- typically the fade-out of their block pose on a block -> M1 flicker
		-- (Blocking flag clears before the M1 replicates) or a previous swing
		-- still playing when the next one starts. Anchoring to it phases the
		-- timer to the WRONG swing, so the punish fires inside the real
		-- swing's startup and gets us punished. So don't arm on it -- the
		-- real fresh track (new object) still arms when it shows up.
		-- Genuine first sights (replication + gate lag) land well inside the window, and the truthful backdate below makes
		-- fire land at true start + delay every time instead of only sometimes.
		if startOffset <= AIR_SWING_FRESH_WINDOW then
			-- Track only: no F press while tracking, so a physical hold is
			-- never disturbed until the fire instant (see fire rules above).
			airSwingArmed = {
				root = enemyRoot,
				t0 = now - startOffset,
			}
			counterDiag("AIR_ARM", "name=" .. tostring(track and track.Name),
				"id=" .. tostring(track and track.Animation and track.Animation.AnimationId),
				string.format("startOffset=%.3f", startOffset),
				"delay=" .. tostring(airSwingDelay),
				"t0=" .. string.format("%.3f", now - startOffset),
				"root=" .. tostring(enemyRoot and enemyRoot.Parent and enemyRoot.Parent.Name),
				"range=" .. tostring(swingRange))
		else
			counterDiagThrottled("airStale", 0.5, "AIR_REJECT_STALE",
				"reason=startOffsetTooOld",
				"name=" .. tostring(track and track.Name),
				"id=" .. tostring(track and track.Animation and track.Animation.AnimationId),
				string.format("startOffset=%.3f", startOffset),
				"freshWindow=" .. tostring(AIR_SWING_FRESH_WINDOW))
		end
	else
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiagThrottled("airNoTarget", 1, "AIR_SKIP", "reason=noTarget")
		end
	end
end))

-- Auto Skills Loop (uses HUD.Moves CD frames to detect ready skills — works on all characters)
local function fireSkillKey(slot)
	local keyMap = {
		[1] = Enum.KeyCode.One,
		[2] = Enum.KeyCode.Two,
		[3] = Enum.KeyCode.Three,
		[4] = Enum.KeyCode.Four,
		[5] = Enum.KeyCode.Five,
	}
	local key = keyMap[slot]
	if key then
		VirtualInputManager:SendKeyEvent(true, key, false, game)
		VirtualInputManager:SendKeyEvent(false, key, false, game)
	end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoPlayEnabled then return end
	local now = os.clock()
	if now - autoState.lastSkillUseTime < autoState.skillUseInterval then return end

	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	local movesContainer = PlayerGui:FindFirstChild("HUD") and PlayerGui.HUD:FindFirstChild("Moves")
	if not movesContainer then return end

	for offset = 1, 4 do
		local i = (autoState.lastUsedSlot + offset - 1) % 4 + 1
		local slotObj = movesContainer:FindFirstChild(tostring(i))
		if slotObj then
			local cd = slotObj:FindFirstChild("CD")
			if cd and cd.Visible and cd.Size.Y.Scale >= 0 then
				autoState.lastUsedSlot = i
				autoState.lastSkillUseTime = now
				autoState.skillFiredTime = now
				fireSkillKey(i)
				break
			end
		end
	end
end))

-- ====================== TRIGGERBOT ======================
-- Single master toggle (stays on). Two move keybinds (Move 1 / Move 2) each
-- file a fire request for their slot AND mark whoever is under the crosshair
-- at that moment (each new press retargets). The shared lock/arrow only ever
-- exists because of a press and drops the instant no requests remain — never
-- lingering while the toggle just sits on. A request fires its slot the moment
-- the marked target is open, on screen and we are not blocking.
local triggerMarkGui = nil
do
	triggerMarkGui = Instance.new("BillboardGui")
	triggerMarkGui.Name = "PiggyTriggerMark"
	triggerMarkGui.Size = UDim2.new(0, 24, 0, 24)
	triggerMarkGui.StudsOffset = Vector3.new(0, 2.5, 0)
	triggerMarkGui.AlwaysOnTop = true
	triggerMarkGui.Enabled = false
	triggerMarkGui.Parent = screenGui

	local diamond = Instance.new("Frame")
	diamond.Name = "Arrow"
	diamond.Size = UDim2.new(0, 14, 0, 14)
	diamond.Position = UDim2.new(0.5, -7, 0.5, -7)
	diamond.Rotation = 45
	diamond.BackgroundColor3 = Color3.fromRGB(80, 255, 140)
	diamond.BorderSizePixel = 0
	diamond.Parent = triggerMarkGui
	local dCorner = Instance.new("UICorner") dCorner.CornerRadius = UDim.new(0, 3) dCorner.Parent = diamond
	local dStroke = Instance.new("UIStroke") dStroke.Color = Color3.fromRGB(0, 0, 0) dStroke.Thickness = 1 dStroke.Parent = diamond
end

local function isTriggerBlocking(char)
	local b = char:FindFirstChild("Blocking")
	if b then
		if b:IsA("BoolValue") or b:IsA("ValueBase") then
			return b.Value == true
		end
		return true
	end
	if char:GetAttribute("Blocking") == true then return true end
	return false
end

local function getTriggerHead(character)
	return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

-- Own move-slot mapping: HUD slot N carries the move name in its TextLabel,
-- which matches the Backpack Configuration name (verified live). Falls back
-- to Nth configuration when the HUD is unavailable.
local function getOwnSlotMoveName(slot)
	local ok, name = pcall(function()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		local hud = pg and pg:FindFirstChild("HUD")
		local moves = hud and hud:FindFirstChild("Moves")
		local slotObj = moves and moves:FindFirstChild(tostring(slot))
		local label = slotObj and slotObj:FindFirstChild("TextLabel")
		if label and label:IsA("TextLabel") and label.Text ~= "" then
			return label.Text
		end
		return nil
	end)
	if ok then return name end
	return nil
end

local function getOwnSlotConfig(slot)
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not bp then return nil end
	local want = getOwnSlotMoveName(slot)
	if want then
		for _, config in ipairs(bp:GetChildren()) do
			if config:IsA("Configuration") and config.Name == want then
				return config
			end
		end
		-- Normalized fallback: HUD/backpack names sometimes differ in
		-- spacing/case per character (e.g. "Star Platinum" vs "StarPlatinum")
		local ok, wantNorm = pcall(function() return tostring(want):gsub("%s+", ""):lower() end)
		if ok and wantNorm then
			for _, config in ipairs(bp:GetChildren()) do
				if config:IsA("Configuration") then
					local ok2, cfgNorm = pcall(function() return tostring(config.Name):gsub("%s+", ""):lower() end)
					if ok2 and cfgNorm == wantNorm then
						return config
					end
				end
			end
		end
	end
	local n = 0
	for _, config in ipairs(bp:GetChildren()) do
		if config:IsA("Configuration") then
			n = n + 1
			if n == slot then return config end
		end
	end
	return nil
end

-- Mirrors the move ESP threshold: COOLDOWN counts 0->20 after a real cast
-- (verified live), ready past 19.5. Absent attribute = ready.
local function isOwnSlotOnCooldown(slot)
	local cfg = getOwnSlotConfig(slot)
	if not cfg then return false end
	local ok, v = pcall(function() return cfg:GetAttribute("COOLDOWN") end)
	if not ok or v == nil then return false end
	local num = tonumber(v)
	return num ~= nil and num < 19.5
end

-- Clears a channel's fire request after it resolves. The master toggle stays on:
-- each keypress is one firing attempt, confirmed by the slot's cooldown. When
-- no requests remain the shared lock (and arrow) drops with them, so nothing
-- lingers while the toggle just sits on.
tbState.clearRequest = function(idx, msg, silent)
	if idx == 2 then
		tbState.pending2 = false
		tbState.awaitingCd2 = false
		tbState.unconfirmed2 = 0
	else
		tbState.pending1 = false
		tbState.awaitingCd = false
		tbState.unconfirmed = 0
	end
	if not tbState.pending1 and not tbState.pending2 then
		tbState.markPlayer = nil
		tbState.markChar = nil
		tbState.wasBlocking = false
		if triggerMarkGui then triggerMarkGui.Enabled = false end
	end
	autoSaveSettings()
	if silent then return end
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Triggerbot",
			Text = msg or ("Move fired (slot " .. ((idx == 2) and tbState.slot2 or tbState.slot) .. ")"),
			Duration = 2
		})
	end)
end

-- Per-channel fire evaluation against the shared lock. A channel only acts
-- while its key was pressed (pending request): it presses its own slot,
-- confirms via that slot's cooldown, retries swallowed presses and clears
-- the request once resolved.
local function evalTriggerChannel(idx, now, markChanged, justUnblocked)
	local slot = (idx == 2) and tbState.slot2 or tbState.slot
	local pending = (idx == 2) and tbState.pending2 or tbState.pending1
	if not pending then return end
	local requestTime = (idx == 2) and tbState.req2 or tbState.req1
	if now - requestTime > tbState.pendingTimeout then
		tbState.clearRequest(idx, nil, true)
		return
	end
	if (idx == 2) and tbState.awaitingCd2 or (idx ~= 2) and tbState.awaitingCd then
		if isOwnSlotOnCooldown(slot) then
			tbState.clearRequest(idx)
		else
			local pressTime = (idx == 2) and tbState.pressTime2 or tbState.pressTime
			if now - pressTime > tbState.cdTimeout then
				if idx == 2 then
					tbState.awaitingCd2 = false
					tbState.unconfirmed2 = tbState.unconfirmed2 + 1
					if tbState.unconfirmed2 >= tbState.maxUnconfirmed then
						tbState.clearRequest(idx, "Triggerbot gave up (no cooldown detected)")
					end
				else
					tbState.awaitingCd = false
					tbState.unconfirmed = tbState.unconfirmed + 1
					if tbState.unconfirmed >= tbState.maxUnconfirmed then
						tbState.clearRequest(idx, "Triggerbot gave up (no cooldown detected)")
					end
				end
			end
		end
		return
	end
	local lastFire = (idx == 2) and tbState.lastFire2 or tbState.lastFire
	if markChanged or justUnblocked or (now - lastFire > tbState.refire) then
		if isOwnSlotOnCooldown(slot) then
			-- Own move still cooling: hold (stay armed) until it is ready
			return
		end
		if idx == 2 then tbState.lastFire2 = now else tbState.lastFire = now end
		fireSkillKey(slot)
		if getOwnSlotConfig(slot) then
			if idx == 2 then
				tbState.awaitingCd2 = true
				tbState.pressTime2 = now
			else
				tbState.awaitingCd = true
				tbState.pressTime = now
			end
		else
			-- Slot has no trackable cooldown state: assume the press landed
			tbState.clearRequest(idx)
		end
	end
end

	table.insert(connections, RunService.RenderStepped:Connect(function()
	if not tbState.enabled then
		if triggerMarkGui then triggerMarkGui.Enabled = false end
		tbState.markPlayer = nil
		tbState.markChar = nil
		tbState.wasBlocking = false
		tbState.awaitingCd = false
		tbState.awaitingCd2 = false
		tbState.pending1 = false
		tbState.pending2 = false
		tbState.retarget = false
		return
	end

	local myChar = LocalPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if not myChar or not myHum or myHum.Health <= 0 then
		if triggerMarkGui then triggerMarkGui.Enabled = false end
		tbState.markPlayer = nil
		tbState.markChar = nil
		tbState.wasBlocking = false
		return
	end

	-- Dynamic per-press lock: the lock only ever exists because a fire key was
	-- pressed. A fresh keypress retargets to whoever is under the crosshair
	-- now; while a request waits with nothing locked, the live cursor keeps
	-- trying (early presses still catch a target that walks in). No requests,
	-- no lock — so the mark can never linger while the toggle just sits on.
	if tbState.retarget then
		tbState.retarget = false
		tbState.markPlayer = nil
		tbState.markChar = nil
		tbState.wasBlocking = false
		tbState.awaitingCd = false
		tbState.unconfirmed = 0
		tbState.awaitingCd2 = false
		tbState.unconfirmed2 = 0
	end
	local markChanged = false
	if not tbState.markPlayer or not tbState.markPlayer.Parent then
		tbState.markPlayer = nil
		tbState.markChar = nil
		tbState.wasBlocking = false
		tbState.awaitingCd = false
		tbState.unconfirmed = 0
		tbState.awaitingCd2 = false
		tbState.unconfirmed2 = 0
		if tbState.pending1 or tbState.pending2 then
			local markHrp = getTargetNearCursor(150)
			local markPlayer = (markHrp and markHrp.Parent) and Players:GetPlayerFromCharacter(markHrp.Parent) or nil
			if markPlayer and (not markPlayer.Character or markPlayer.Character ~= markHrp.Parent) then
				markPlayer = nil
			end
			if markPlayer then
				tbState.markPlayer = markPlayer
				markChanged = true
			end
		end
	end
	local markPlayer = tbState.markPlayer

	if markPlayer and markPlayer.Character then
		local head = getTriggerHead(markPlayer.Character)
		if head then
			if triggerMarkGui.Adornee ~= head then triggerMarkGui.Adornee = head end
			triggerMarkGui.Enabled = true
		else
			triggerMarkGui.Enabled = false
		end
	else
		triggerMarkGui.Enabled = false
	end

	if not markPlayer or not markPlayer.Character then return end
	local mchar = markPlayer.Character
	if tbState.markChar ~= mchar then
		tbState.markChar = mchar
		tbState.wasBlocking = false
		markChanged = true
	end
	local mhum = mchar:FindFirstChildOfClass("Humanoid")
	if not mhum or mhum.Health <= 0 then return end

	local blocking = isTriggerBlocking(mchar)
	local justUnblocked = tbState.wasBlocking and not blocking
	tbState.wasBlocking = blocking
	if blocking then return end

	-- On-screen gate: only fire while the locked target is actually on screen,
	-- so it never goes off when they are behind you or off camera.
	local mhrp = mchar:FindFirstChild("HumanoidRootPart")
	if not mhrp then return end
	local _, mOnScreen = Camera:WorldToViewportPoint(mhrp.Position)
	if not mOnScreen then return end

	-- Don't burn the one-shot while WE are blocking: the server swallows move
	-- keys thrown from block, so hold (stay enabled) until we release instead.
	if isAirSwingHolding() then return end

	local now = os.clock()
	-- Cooldown confirmation per channel (see evalTriggerChannel): a press only
	-- counts once the slot's Backpack Configuration actually gains its COOLDOWN
	-- attribute. Swallowed presses never show one, so the channel stays armed
	-- and retries instead of disabling.
	evalTriggerChannel(1, now, markChanged, justUnblocked)
	evalTriggerChannel(2, now, markChanged, justUnblocked)
end))

-- Auto M1 Loop (left click with skill priority)
local function fireAutoM1()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not bp then return end
	local input = bp:FindFirstChild("Input")
	if not input then return end

	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	pcall(function()
		input:FireServer("M1", {
			air = false,
			mousehit = root.CFrame,
			md = Vector3.zero,
			dodgevelo = nil,
			skeydown = false,
			skeyreal = false
		})
	end)
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoPlayEnabled then return end
	local now = os.clock()
	if now - autoState.lastAutoM1Time < autoState.autoM1Interval then return end
	if autoPlayEnabled and now - autoState.skillFiredTime < autoState.skillM1Lockout then return end

	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local inRange = false
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local pChar = player.Character
		if not pChar then continue end
		local pRoot = pChar:FindFirstChild("HumanoidRootPart")
		if not pRoot then continue end
		if (pRoot.Position - root.Position).Magnitude <= 12 then
			inRange = true
			break
		end
	end
	if not inRange then return end

	autoState.lastAutoM1Time = now
	fireAutoM1()
end))

-- Auto Lock Loop (independent camera lock — doesn't interfere with main Lock tab)
local function getClosestPlayer()
	local char = LocalPlayer.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local closestDist = math.huge
	local closestTarget = nil

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if teamCheckEnabled and isTeammate(player) then continue end
			local hrp = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (hrp.Position - root.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closestTarget = hrp
				end
			end
		end
	end
	return closestTarget
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	if autoPlayEnabled then
		local target = getClosestPlayer()
		if target then
			autoState.lockTarget = target
			autoState.lockActive = true
		else
			autoState.lockTarget = nil
			autoState.lockActive = false
		end
	else
		autoState.lockTarget = nil
		autoState.lockActive = false
	end
end))

-- Separate camera lock RenderStepped for auto lock
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoState.lockActive or not autoState.lockTarget or not autoState.lockTarget.Parent then return end

	local targetPlayer = Players:GetPlayerFromCharacter(autoState.lockTarget.Parent)
	if teamCheckEnabled and targetPlayer and isTeammate(targetPlayer) then
		autoState.lockTarget = nil
		autoState.lockActive = false
		return
	end

	local currentPos = Camera.CFrame.Position
	local targetPos = autoState.lockTarget.Position
	if predictionEnabled then
		targetPos = targetPos + autoState.lockTarget.Velocity * predictionStrength
	end

	local targetCFrame = CFrame.new(currentPos, targetPos)
	Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothness)
end))

-- Auto Mode Loop (presses G when charge/mode/ult bar reaches 100%)
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoPlayEnabled then return end

	local hud = PlayerGui:FindFirstChild("HUD")
	if not hud then return end
	local ultBar = hud:FindFirstChild("Ultimate")
	if not ultBar then return end
	local bar = ultBar:FindFirstChild("Bar")
	if not bar then return end
	if bar.Size.X.Scale < 1 then return end
	if os.clock() - autoState.lastModeGTime < 0.5 then return end

	autoState.lastModeGTime = os.clock()
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
end))

-- Auto Walk Loop (walks towards nearest player with stuck detection)
local lastStuckPos, lastStuckTime, stuckJumpCooldown, lastHeightJump
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoPlayEnabled then return end

	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end

	local target = getClosestPlayer()
	if not target then return end
	if teamCheckEnabled then
		local targetPlayer = Players:GetPlayerFromCharacter(target.Parent)
		if targetPlayer and isTeammate(targetPlayer) then return end
	end
	local now = os.clock()
	local dist = (target.Position - root.Position).Magnitude

	-- Jump when below target in melee range (to hit elevated enemies)
	if dist < 12 then
		local heightDiff = target.Position.Y - root.Position.Y
		if heightDiff > 1.5 and (now - (lastHeightJump or 0)) > 0.4 then
			lastHeightJump = now
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
			task.delay(0.08, function()
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
			end)
			if heightDiff > 10 then
				task.delay(0.2, function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
					task.wait(0.08)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
				end)
			end
		end
	end

	if dist < 5 then return end

	hum:Move((target.Position - root.Position).Unit)

	-- Stuck detection: if position barely changed in 0.5s, jump
	if not lastStuckPos then
		lastStuckPos, lastStuckTime = root.Position, now
	elseif now - lastStuckTime >= 0.5 then
		if (root.Position - lastStuckPos).Magnitude < 1.5 and (now - (stuckJumpCooldown or 0)) > 2 then
			stuckJumpCooldown = now
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
			task.delay(0.08, function()
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
			end)
		end
		lastStuckPos, lastStuckTime = root.Position, now
	end
end))

-- Auto Sprint Loop
local lastSprintPress = 0
local sprintKeyHeld = false
table.insert(connections, RunService.RenderStepped:Connect(function()
	if autoState.sprintEnabled then
		local char = LocalPlayer.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				if not sprintKeyHeld then
					sprintKeyHeld = true
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
				end
				local now = os.clock()
				if now - lastSprintPress > 0.8 then
					lastSprintPress = now
					task.spawn(function()
						task.wait()
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
						task.wait()
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
					end)
				end
			else
				if sprintKeyHeld then
					sprintKeyHeld = false
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
				end
			end
		end
	elseif sprintKeyHeld then
		sprintKeyHeld = false
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
	end
end))

-- Auto Dash (every 0.5 seconds, press W before Q to avoid backdashing)
local lastDashTime = 0
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoPlayEnabled then return end
	local now = os.clock()
	if now - lastDashTime < 0.5 then return end
	lastDashTime = now
	task.spawn(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
		task.wait()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
	end)
end))

-- Persistent character tracking loop (Detects spawns/respawns reliably on client)
local lastCharTrack = 0
table.insert(connections, RunService.RenderStepped:Connect(function()
	local now = os.clock()
	if now - lastCharTrack < 0.2 then return end
	lastCharTrack = now
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			if char and char.Parent then
				local chargeBillboard = parentGui:FindFirstChild(player.Name .. "_ChargeBillboard")
				local moveBillboard = parentGui:FindFirstChild(player.Name .. "_MoveBillboard")
				
				if not chargeBillboard then
					task.spawn(createChargeBillboard, player, char)
				end
				if not moveBillboard then
					task.spawn(createMoveBillboard, player, char)
				end
			end
		end
	end
end))
table.insert(connections, Players.PlayerRemoving:Connect(onPlayerRemoving))

-- Hook update loop (runs once per second, completely bypasses metatable hooks and write-only get crashes)
local lastHookUpdate = 0
table.insert(connections, RunService.RenderStepped:Connect(function()
	local now = os.clock()
	if now - lastHookUpdate < 1.0 then return end
	lastHookUpdate = now
	
	if autoBlackFlashEnabled then
		if not blackFlashCheck then
			blackFlashCheck = game.ReplicatedStorage:FindFirstChild("BlackFlashCheck")
		end
		if blackFlashCheck then
			pcall(function() blackFlashCheck.OnClientInvoke = customBlackFlashHandler end)
		end
	end
	

end))

;do
targetEspAnimIds = {["8974264434"] = true, ["1465165770"] = true, ["6754969370"] = true, ["8329506316"] = true, ["8328876513"] = true, ["8681762596"] = true, ["9217238023"] = true, ["9217206855"] = true, ["1731463612"] = true, ["12927680964"] = true, ["1543309482"] = true, ["12272453134"] = true, ["12928840256"] = true, ["1886062099"] = true, ["17294679607"] = true, ["17334236236"] = true, ["132225462199066"] = true, ["17357489936"] = true, ["3265430243"] = true, ["118910380600259"] = true, ["4653386705"] = true, ["6750008948"] = true, ["6705045388"] = true, ["5674269180"] = true, ["7481178803"] = true, ["7488015413"] = true, ["98445813659716"] = true, ["18772942292"] = true, ["136303135203840"] = true, ["7493582520"] = true, ["94489156644683"] = true, ["109495714822112"] = true, ["129765754659992"] = true, ["6114641038"] = true, ["3339935109"] = true, ["6210077683"] = true, ["11865482364"] = true, ["112201216467412"] = true, ["6700988109"] = true, ["6326195655"] = true, ["9494065811"] = true, ["11782773915"] = true, ["99142602347698"] = true, ["8350863798"] = true, ["8329143223"] = true, ["10633162453"] = true, ["8332552679"] = true, ["14091927516"] = true}
targetEspSkillNames = {["Lightning Spear"] = true, ["Pistol"] = true, ["Jet Pistol"] = true, ["Grill Shot"] = true, ["Yata Mirror"] = true, ["Bagworm"] = true, ["Sogeking Snipe"] = true, ["Snipe"] = true, ["Desert Pull"] = true, ["El Thor"] = true, ["Thunder  Dragon"] = true, ["Thunder Bird"] = true, ["Quick Draw"] = true, ["Rush"] = true, ["Super Rush"] = true, ["Gut Kick"] = true, ["Amazing Impact"] = true, ["Flash Fist"] = true, ["Z Vanish"] = true, ["Blazing Rush"] = true, ["Suprise"] = true, ["Ki Traps"] = true, ["Cosmic Rush"] = true, ["Kick Away/Sledgehammer"] = true, ["Grab"] = true, ["Sand Coffin"] = true, ["Amaterasu"] = true, ["Super Shark Bomb Jutsu"] = true, ["Spear"] = true, ["Pounce"] = true, ["STEAL"] = true, ["Bala"] = true, ["Quake"] = true, ["Accelerate"] = true, ["Spinning Elbow"] = true, ["Saint Beatdown"] = true, ["Hat Throw"] = true, ["Plasma "] = true, ["Victory"] = true, ["Pillars of Creation"] = true, ["Pillar"] = true, ["Smoky Chain"] = true, ["Judgement Chain"] = true, ["Needle Barage"] = true, ["Strong Dowsing Chain"] = true, ["PROMINENCE BURN"] = true, ["Onslaught"] = true, ["Shoot Style: Leap"] = true, ["Flare Blitz"] = true, ["Projection"] = true, ["Fallen Angel"] = true, ["Cyclops Punches"] = true, ["Gates of Babylon"] = true, ["Maiya"] = true, ["Enkidu"] = true, ["Starlight Shot"] = true, ["Gae Bolg"] = true, ["Gem Shot"] = true, ["Moon Flash"] = true, ["Burst"] = true, ["Blue Rose"] = true, ["Nova Ascension"] = true, ["Switch"] = true, ["Bank Shot"] = true, ["Arrow Storm"] = true, ["Rage Spike"] = true, ["Spin"] = true, ["Pinpoint Shot"] = true}
function isPlayingTargetAnim(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return false end
	for _, track in animator:GetPlayingAnimationTracks() do
		local aid = track.Animation and track.Animation.AnimationId
		if aid then
			local idNum = tostring(aid):match("%d+")
			if idNum and targetEspAnimIds[idNum] then
				return true
			end
		end
	end
	return false
end
;(function()
	function showTargetAlert()
		if not espState.targetEnabled then return end
		if not LocalPlayer.Character then return end
		if espState.targetAlertTime > 0 and os.clock() - espState.targetAlertTime < 3 then return end
		local head = getCharacterHeadNonYielding(LocalPlayer.Character)
		if not head then return end

		espState.targetAlertTime = os.clock()

		if espState.targetBillboard and espState.targetBillboard.Parent then
			espState.targetBillboard.Adornee = head
			if targetEspScale then
				targetEspScale.Scale = 0
				TweenService:Create(targetEspScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
			end
			if targetEspLabel then
				targetEspLabel.TextTransparency = 0
				targetEspLabel.TextStrokeTransparency = 0
			end
			return
		end

		local Billboard = Instance.new("BillboardGui")
		Billboard.Name = "TargetAlert_Exclamation"
		Billboard.Size = UDim2.new(3, 0, 3, 0)
		Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		Billboard.AlwaysOnTop = true
		Billboard.Adornee = head
		Billboard.Parent = parentGui

		local scale = Instance.new("UIScale")
		scale.Scale = 0
		scale.Parent = Billboard

		local Label = Instance.new("TextLabel")
		Label.Name = "Exclamation"
		Label.Size = UDim2.new(1, 0, 1, 0)
		Label.BackgroundTransparency = 1
		Label.Text = "!"
		Label.TextColor3 = Color3.fromRGB(255, 50, 50)
		Label.TextScaled = true
		Label.Font = Enum.Font.SourceSansBold
		Label.TextStrokeTransparency = 0
		Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		Label.Parent = Billboard

		local textConstraint = Instance.new("UITextSizeConstraint")
		textConstraint.MinTextSize = 18
		textConstraint.MaxTextSize = 60
		textConstraint.Parent = Label

		espState.targetBillboard = Billboard
		targetEspScale = scale
		targetEspLabel = Label

		-- Pop-in animation
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	end

	local function hideTargetAlert()
		local billboard = espState.targetBillboard
		local scale = targetEspScale
		local label = targetEspLabel
		espState.targetBillboard = nil
		targetEspScale = nil
		targetEspLabel = nil
		if billboard and billboard.Parent then
			-- Fade out and shrink
			local tween = TweenService:Create(scale or billboard, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0})
			tween.Completed:Connect(function()
				pcall(function() billboard:Destroy() end)
			end)
			tween:Play()
			if label then
				TweenService:Create(label, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
			end
		end
		espState.targetAlertTime = 0
	end

	-- Alert visibility loop
	task.spawn(function()
		while true do
			task.wait(0.1)
			if espState.targetEnabled and espState.targetAlertTime > 0 then
				if os.clock() - espState.targetAlertTime <= 1.5 then
					if not espState.targetBillboard or not espState.targetBillboard.Parent then
						showTargetAlert()
					elseif LocalPlayer.Character then
						local head = getCharacterHeadNonYielding(LocalPlayer.Character)
						if head then espState.targetBillboard.Adornee = head end
					end
				else
					hideTargetAlert()
				end
			end
		end
	end)

	-- Checks if the local player is the closest target in the enemy's crosshair
	-- Uses the game's own targeting metric (|lookVector - dir|.Magnitude < 0.4)
	function isLocalPlayerClosestTarget(enemyChar)
		if not enemyChar or not LocalPlayer.Character then return false end
		local enemyHRP = enemyChar:FindFirstChild("HumanoidRootPart")
		local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not enemyHRP or not myHRP then return false end
		if (myHRP.Position - enemyHRP.Position).Magnitude > targetEspRange then return false end

		local lookVector = enemyHRP.CFrame.LookVector
		local dirToMe = (myHRP.Position - enemyHRP.Position).Unit
		local myDiff = (lookVector - dirToMe).Magnitude

		if myDiff >= targetEspSensitivity then return false end

		-- Check if another player is closer to their crosshair
		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end
			local char = player.Character
			if not char then continue end
			if char:FindFirstChild("NoTarg") then continue end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then continue end
			if (hrp.Position - enemyHRP.Position).Magnitude > 180 then continue end
			local dir = (hrp.Position - enemyHRP.Position).Unit
			local d = (lookVector - dir).Magnitude
			if d < myDiff then
				return false
			end
		end

		return true
	end

	-- Monitor enemy characters for Action folder creation (move startup)
	local live = workspace:FindFirstChild("Live")
	if live then
		live.ChildAdded:Connect(function(char)
			task.spawn(function()
				local player = Players:GetPlayerFromCharacter(char)
				if not player or player == LocalPlayer then return end
				if teamCheckEnabled and isTeammate(player) then return end
				local actionFolder = char:WaitForChild("Action", 5)
				if not actionFolder or not espState.targetEnabled then return end
				if isPlayingTargetAnim(char) and isLocalPlayerClosestTarget(char) then
					showTargetAlert()
					do end
				end
			end)
		end)
		for _, char in live:GetChildren() do
			local player = Players:GetPlayerFromCharacter(char)
			if player and player ~= LocalPlayer and char:FindFirstChild("Action") then
				if teamCheckEnabled and isTeammate(player) then continue end
				if isPlayingTargetAnim(char) and isLocalPlayerClosestTarget(char) then
					showTargetAlert()
				end
			end
		end
	end

	-- RenderStepped loop: watch all enemies for target anim + Action state
	table.insert(connections, RunService.RenderStepped:Connect(function()
		if not espState.targetEnabled then return end
		if not LocalPlayer.Character then return end
		local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not myHRP then return end
		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end
			if teamCheckEnabled and isTeammate(player) then continue end
			local char = player.Character
			if not char then continue end
			if not char:FindFirstChild("Action") then continue end
			if isPlayingTargetAnim(char) and isLocalPlayerClosestTarget(char) then
				if espState.targetBillboard and espState.targetBillboard.Parent and LocalPlayer.Character then
					local head = getCharacterHeadNonYielding(LocalPlayer.Character)
					if head then espState.targetBillboard.Adornee = head end
				end
			end
		end
	end))

	-- Hook TagReplicate as backup (fires on hit, but useful for uptilt/downtilt logging)
	local tagRepSuccess, tagReplicate = pcall(function()
		return game:GetService("ReplicatedStorage"):WaitForChild("TagSystem2"):WaitForChild("TagReplicate")
	end)
	if tagRepSuccess and tagReplicate then
		local lastTagTime = 0
		tagReplicate.OnClientEvent:Connect(function(tags, targetPath)
			if type(tags) ~= "table" then return end
			local targetStr = type(targetPath) == "string" and targetPath or tostring(targetPath)
			local isOnMe = targetStr ~= "" and (
				targetStr:find(LocalPlayer.Name) or
				targetStr:find("Players." .. LocalPlayer.Name)
			)
			local hasUptilt = false
			local hasDowntilt = false
			local hasCreator = false
			local hasUsingMove = false
			for _, tag in ipairs(tags) do
				if type(tag) == "table" then
					if tag.TrueName == "recentuptilt" then hasUptilt = true end
					if tag.TrueName == "recentdowntilt" then hasDowntilt = true end
					if tag.TrueName == "creator" and isOnMe then
						hasCreator = true
					end
					if tag.TrueName == "usingmove" and isOnMe then
						hasUsingMove = true
					end
				end
			end
			lastTagTime = os.clock()
			if hasUptilt or hasDowntilt then
				local tagType = hasUptilt and "uptilt" or "downtilt"
				do end
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						local hum = p.Character:FindFirstChildOfClass("Humanoid")
						if hum then
							local animator = hum:FindFirstChildOfClass("Animator")
							local tracks = animator and animator:GetPlayingAnimationTracks() or hum:GetPlayingAnimationTracks()
							for _, t in ipairs(tracks) do
								local aid = t.Animation and t.Animation.AnimationId or "none"
								do end
							end
						end
					end
				end
			end
		end)
	end
end)()

-- Apply file-based autoload config
ConfigManager.load("autoload")
-- Track when enemies enter mode/ult state (skip alerts during activation animation)
_G.PiggyModeSkip = _G.PiggyModeSkip or {}
;(function()
	local live = workspace:FindFirstChild("Live")
	if not live then return end
	local function watchCharForMode(char)
		local conn = char.ChildAdded:Connect(function(child)
			if child.Name == "State2" or child.Name == "Soru" then
				local player = Players:GetPlayerFromCharacter(char)
				if player and player ~= LocalPlayer then
					_G.PiggyModeSkip[player] = os.clock()
				end
			end
		end)
		table.insert(connections, conn)
		local cleanup
		cleanup = char.AncestryChanged:Connect(function(_, parent)
			if not parent then
				if conn and conn.Connected then conn:Disconnect() end
				if cleanup and cleanup.Connected then cleanup:Disconnect() end
			end
		end)
		table.insert(connections, cleanup)
	end
	live.ChildAdded:Connect(function(char)
		task.spawn(function()
			local player = Players:GetPlayerFromCharacter(char)
			if player and player ~= LocalPlayer then
				watchCharForMode(char)
			end
		end)
	end)
	for _, char in live:GetChildren() do
		local player = Players:GetPlayerFromCharacter(char)
		if player and player ~= LocalPlayer then
			watchCharForMode(char)
		end
	end
end)()

table.insert(connections, game.DescendantAdded:Connect(function(obj)
	if obj.Name ~= "UsingSkill" then return end
	if not obj:IsA("StringValue") then return end
	local char = obj.Parent
	if not char then return end
	local player = Players:GetPlayerFromCharacter(char)
	if not player then return end
	local skillName = obj.Value
	if not skillName or skillName == "" then return end

	if player == LocalPlayer then
		if gojoAfterimageEnabled and (skillName == "Blue" or skillName == "Blue: Max Output") then
			gojoBlueActive = true
			task.delay(3, function() gojoBlueActive = false end)
		end
		return
	end
	if teamCheckEnabled and isTeammate(player) then return end
	if espState.targetEnabled and LocalPlayer.Character and targetEspSkillNames[skillName] and isLocalPlayerClosestTarget(char) then
		task.spawn(function()
			task.wait(0.03)
			if char and char.Parent and isPlayingTargetAnim(char) then
				showTargetAlert()
			end
		end)
	end
	if not espState.inputsEnabled then return end
	cdState.flashTimes[player.Name .. "_" .. skillName] = os.clock()
end))
end


end
)()

