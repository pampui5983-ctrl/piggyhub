-- RAGE TAB (Fly)
local function cleanupFlyMovers()
	if flyGyro then pcall(function() flyGyro:Destroy() end) flyGyro = nil end
	if flyVel then pcall(function() flyVel:Destroy() end) flyVel = nil end
end

setFly = function(on)
	flyEnabled = on
	if not on then cleanupFlyMovers() return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	cleanupFlyMovers()
	flyGyro = Instance.new("BodyGyro")
	flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	flyGyro.P = 1000
	flyGyro.CFrame = hrp.CFrame
	flyGyro.Parent = hrp
	flyVel = Instance.new("BodyVelocity")
	flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	flyVel.Velocity = Vector3.zero
	flyVel.Parent = hrp
end

flyToggleObj = createToggle(rageTabFrame, "Fly", 10, flyEnabled, function(state)
    setFly(state)
end)
settingsRefs.flyEnabled = flyToggleObj

settingsRefs.flyKey = createKeybind(rageTabFrame, "Fly Keybind", 48, flyKey, function(key)
    flyKey = key
end)

settingsRefs.flySpeed = createSlider(rageTabFrame, "Fly Speed", 86, 10, 200, flySpeed, function(val)
    flySpeed = val
end, function(text, val)
    return text .. ": " .. string.format("%.0f", val)
end)

table.insert(connections, RunService.Heartbeat:Connect(function()
	if not flyEnabled then return end
	if headAttachFlying then return end -- HeadAttach owns the root while sticking
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end
	if not flyGyro or not flyVel or not flyGyro.Parent or not flyVel.Parent then
		setFly(true)
		if not flyGyro or not flyVel then return end
	end
	local cam = Camera.CFrame
	local move = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.yAxis end
	local now = os.clock()
	-- Hit-slow: while our own M1 swing is fresh, cap speed so you don't
	-- overshoot the person you're hitting (flySwingTime is stamped by the
	-- swing hook in the Auto Block section, next to sharedM1AnimIds).
	local speed = flySpeed
	if now - flySwingTime < 0.3 then speed = 12 end
	if move.Magnitude > 0.01 then move = move.Unit * speed end
	flyVel.Velocity = move
	flyGyro.CFrame = cam
end))

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	if flyEnabled then setFly(true) end
end))

-- RAGE TAB (Head Attach, ported from headride.luau: hold key to stick above whoever you're looking at)
headAttachToggleObj = createToggle(rageTabFrame, "Head Attach", 140, headAttachEnabled, function(state)
    headAttachEnabled = state
    if not state then
        headAttachHolding = false
        headAttachCurrent = nil
        headAttachOffsetDir = nil
        if headAttachFlying then
            headAttachFlying = false
            pcall(function()
                local c = LocalPlayer.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if h then h.PlatformStand = false end
            end)
        end
    end
end)
settingsRefs.headAttachEnabled = headAttachToggleObj

settingsRefs.headAttachKey = createKeybind(rageTabFrame, "Head Attach Keybind", 178, headAttachKey, function(key)
    headAttachKey = key
end)

settingsRefs.headAttachOffset = createSlider(rageTabFrame, "Head Attach Offset", 216, 0, 12, headAttachOffset, function(val)
    headAttachOffset = val
end, function(text, val)
    return text .. ": " .. string.format("%.0f", val)
end)

local function headAttachRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function headAttachHum()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function headAttachValid(head, myRoot)
    if not head or not head.Parent then return false end
    local m = head.Parent
    local h = m and m:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if (head.Position - myRoot.Position).Magnitude > HEAD_ATTACH_MAX_RANGE then return false end
    return true
end

local function headAttachScoreOf(head, camPos, lookVec, myRoot)
    local to = head.Position - camPos
    if to.Magnitude <= 0 then return math.huge end
    return (lookVec - to.Unit).Magnitude + ((head.Position - myRoot.Position).Magnitude / HEAD_ATTACH_MAX_RANGE)
end

local function headAttachIsTarget(m)
    if m == LocalPlayer.Character then return false end -- never yourself
    if m.Name:find("Dummy") then return true end
    return Players:GetPlayerFromCharacter(m) ~= nil -- any live player, same rules
end

local function headAttachGoal()
    local live = workspace:FindFirstChild("Live")
    local mr = headAttachRoot()
    local cam = Camera
    if not live or not mr or not cam then headAttachCurrent = nil return nil end
    local camPos = cam.CFrame.Position
    local look = cam.CFrame.LookVector
    if headAttachValid(headAttachCurrent, mr) then
        local curScore = headAttachScoreOf(headAttachCurrent, camPos, look, mr)
        local best, bestScore = nil, math.huge
        for _, m in ipairs(live:GetChildren()) do
            if headAttachIsTarget(m) then
                local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
                if head ~= headAttachCurrent and headAttachValid(head, mr) then
                    local s = headAttachScoreOf(head, camPos, look, mr)
                    if s < bestScore then best, bestScore = head, s end
                end
            end
        end
        -- only steal focus if clearly better (kills frame-to-frame flicker)
        if best and bestScore < curScore * HEAD_ATTACH_SWITCH_MARGIN then headAttachCurrent = best end
        return headAttachCurrent
    end
    local best, bestScore = nil, math.huge
    for _, m in ipairs(live:GetChildren()) do
        if headAttachIsTarget(m) then
            local h = m:FindFirstChildOfClass("Humanoid")
            local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
            if h and h.Health > 0 and head then
                local myDist = (head.Position - mr.Position).Magnitude
                -- range limit is measured from YOU to the target
                if myDist > HEAD_ATTACH_MAX_RANGE then continue end
                local to = head.Position - camPos
                local dist = to.Magnitude
                if dist > 0 then
                    -- blend: camera-centering + closeness to you (both matter)
                    local score = (look - to.Unit).Magnitude + (myDist / HEAD_ATTACH_MAX_RANGE)
                    if score < bestScore then best, bestScore = head, score end
                end
            end
        end
    end
    headAttachCurrent = best
    return best
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    local hrp, h = headAttachRoot(), headAttachHum()
    if not hrp or not h then return end
    if headAttachEnabled and headAttachHolding and headAttachKey then
        local head = headAttachGoal()
        if not head then
            -- nothing in range/sight: stay fully normal, never freeze mid-air
            if headAttachFlying then headAttachFlying = false h.PlatformStand = false end
            return
        end
        if not headAttachFlying then headAttachFlying = true h.PlatformStand = true end
        local base = head.Position + Vector3.new(0, HEAD_ATTACH_ABOVE, 0)
        if headAttachOffset > 0.01 then
            -- Offset to the far side of the target along the direction WE are
            -- looking (camera-anchored). The old position-anchored version
            -- (us-to-target vector) flipped the goal to the opposite side
            -- every time we crossed over the head, causing the back-and-forth
            -- teleporting. Camera direction has no such feedback loop.
            -- Latched: looking straight down degenerates the flattened vector,
            -- so keep the last good direction instead of jumping.
            local camLook = Camera and Camera.CFrame.LookVector or nil
            local dir = camLook and Vector3.new(camLook.X, 0, camLook.Z) or nil
            if dir and dir.Magnitude > 0.2 then
                headAttachOffsetDir = dir.Unit
            else
                local away = head.Position - hrp.Position
                away = Vector3.new(away.X, 0, away.Z)
                if away.Magnitude > 0.5 then
                    headAttachOffsetDir = away.Unit
                end
            end
            if headAttachOffsetDir then
                base = base + headAttachOffsetDir * headAttachOffset
            end
        else
            headAttachOffsetDir = nil
        end
        local d = (base - hrp.Position).Magnitude
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        -- organic layer: breathe vertically always, arc sideways while traveling.
        -- both fade with closeness so the final sit-down is still exact.
        local t = os.clock()
        local closeK = math.clamp(d / HEAD_ATTACH_STICK_DIST, 0, 1)
        local bob = math.sin(t * HEAD_ATTACH_BOB_SPEED) * HEAD_ATTACH_BOB * (0.4 + 0.6 * (1 - closeK))
        local camR = Camera and Camera.CFrame.RightVector or Vector3.xAxis
        local sway = math.sin(t * HEAD_ATTACH_SWAY_SPEED) * HEAD_ATTACH_SWAY * closeK
        local goal = base + Vector3.new(0, bob, 0) + camR * sway
        if d < HEAD_ATTACH_DEADZONE then goal = base + Vector3.new(0, bob * 0.5, 0) end
        local a = d < HEAD_ATTACH_STICK_DIST and HEAD_ATTACH_STICK or HEAD_ATTACH_CHASE
        hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(goal, goal + hrp.CFrame.LookVector), a)
    elseif headAttachFlying then
        headAttachFlying = false
        h.PlatformStand = false
    end
end))

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if UserInputService:GetFocusedTextBox() then return end
    if headAttachEnabled and headAttachKey and input.KeyCode == headAttachKey then
        headAttachHolding = true
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if headAttachKey and input.KeyCode == headAttachKey then
        headAttachHolding = false
    end
end))

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
    headAttachHolding = false
    headAttachFlying = false
    headAttachCurrent = nil
    headAttachOffsetDir = nil
end))

