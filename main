miscPadding.PaddingRight = UDim.new(0, 10)
miscPadding.Parent = miscTabFrame

local configTabFrame = Instance.new("Frame")
configTabFrame.Size = UDim2.new(1, -150, 1, -20)
configTabFrame.Position = UDim2.new(0, 140, 0, 10)
configTabFrame.BackgroundTransparency = 1
configTabFrame.Visible = false
configTabFrame.Parent = bodyFrame

local rageTabFrame = Instance.new("Frame")
rageTabFrame.Size = UDim2.new(1, -150, 1, -20)
rageTabFrame.Position = UDim2.new(0, 140, 0, 10)
rageTabFrame.BackgroundTransparency = 1
rageTabFrame.Visible = false
rageTabFrame.Parent = bodyFrame

local skinTabFrame = Instance.new("ScrollingFrame")
skinTabFrame.Size = UDim2.new(1, -150, 1, -20)
skinTabFrame.Position = UDim2.new(0, 140, 0, 10)
skinTabFrame.BackgroundTransparency = 1
skinTabFrame.Visible = false
skinTabFrame.Parent = bodyFrame
skinTabFrame.ScrollBarThickness = 6
skinTabFrame.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 95)
skinTabFrame.ScrollingDirection = Enum.ScrollingDirection.Y
skinTabFrame.BorderSizePixel = 0

-- ====================== SKIN CHANGER ======================
-- Built inside a function (not a bare do-block) so its ~100 locals get their
-- own 200-register budget instead of crowding the top-level chunk (which
-- otherwise dies with "out of local registers ... exceeded limit 200").
local function buildSkinTab()
local SkinLP = game:GetService("Players").LocalPlayer
local lockActive = false
local lockState = nil
local lockLoop = nil
local lockDescCon = nil
local headHidden = false
local charAccsRemoved = false
local lockBypass = 0
local LOCK_BODY_PARTS = {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
local STANDARD_PARTS = {Head=true, Torso=true, ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true, HumanoidRootPart=true, Humanoid=true, Neck=true, FakeHead=true, FH=true}
local SAVE_FOLDER = "PiggyHub/Skins/"
local inpBg = Color3.fromRGB(20, 18, 28)
local txtPri = Color3.fromRGB(230, 230, 240)
local txtSec = Color3.fromRGB(150, 150, 170)
local bdr = Color3.fromRGB(45, 8, 8)

local function extractIds(input)
	local ids = {}
	for id in input:gmatch("(%d+)") do table.insert(ids, id) end
	return ids
end

local function makeBox(ph)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, 0, 0, 30)
	box.BackgroundColor3 = inpBg
	box.BorderSizePixel = 0
	box.Text = ""
	box.PlaceholderText = ph
	box.PlaceholderColor3 = txtSec
	box.TextColor3 = txtPri
	box.TextSize = 12
	box.Font = Enum.Font.Gotham
	box.ClearTextOnFocus = false
	box.Parent = skinTabFrame
	local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 5); bc.Parent = box
	local bs = Instance.new("UIStroke"); bs.Color = bdr; bs.Thickness = 1; bs.Parent = box
	return box
end

local function makeBtn(text, color, cb)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 30)
	btn.BackgroundColor3 = color or Color3.fromRGB(26, 24, 36)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = txtPri
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamSemibold
	btn.Parent = skinTabFrame
	local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 5); bc.Parent = btn
	btn.InputBegan:Connect(function(inp, proc)
		if proc then return end
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then cb() end
	end)
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = Color3.fromRGB(55, 10, 10) end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = color or Color3.fromRGB(26, 24, 36) end)
	return btn
end

local function makeLabeledRow(label, default)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 28)
	row.BackgroundTransparency = 1
	row.Parent = skinTabFrame
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0, 110, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = label; lbl.TextColor3 = txtSec; lbl.TextSize = 12; lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -116, 1, -4)
	box.Position = UDim2.new(0, 112, 0, 2)
	box.BackgroundColor3 = inpBg; box.BorderSizePixel = 0
	box.Text = tostring(default); box.TextColor3 = txtPri; box.TextSize = 12
	box.Font = Enum.Font.Gotham; box.ClearTextOnFocus = false
	box.Parent = row
	local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 4); bc.Parent = box
	local bs = Instance.new("UIStroke"); bs.Color = bdr; bs.Thickness = 1; bs.Parent = box
	return box
end

-- Status bar
local statusLbl = Instance.new("TextLabel")
statusLbl.Size = UDim2.new(1, 0, 0, 20); statusLbl.BackgroundColor3 = Color3.fromRGB(14, 12, 22)
statusLbl.BorderSizePixel = 0; statusLbl.Text = ""; statusLbl.TextColor3 = Color3.fromRGB(140, 200, 140)
statusLbl.TextSize = 11; statusLbl.Font = Enum.Font.Gotham; statusLbl.Parent = skinTabFrame
local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0, 4); sc.Parent = statusLbl

local function setStatus(msg, color)
	statusLbl.Text = msg
	statusLbl.TextColor3 = color or Color3.fromRGB(140, 200, 140)
	task.delay(3, function() statusLbl.Text = "" end)
end

-- ===== SKIN CHANGER =====
local shirtBox = makeBox("Shirt Texture ID")
local pantsBox = makeBox("Pants Texture ID")
makeBtn("Apply All", nil, function()
	if lockActive then setStatus("Turn Lock OFF first!", Color3.fromRGB(255, 180, 80)); return end
	local char = SkinLP.Character
	if not char then setStatus("No character!", Color3.fromRGB(255, 100, 100)); return end
	local shirtIds = extractIds(shirtBox.Text)
	local pantsIds = extractIds(pantsBox.Text)
	if #shirtIds == 0 and #pantsIds == 0 then setStatus("Enter an ID first!", Color3.fromRGB(255, 180, 80)); return end
	local ok, err = pcall(function()
		if #shirtIds > 0 then
			local existing; for _, c in char:GetChildren() do if c:IsA("Shirt") then existing = c; break end end
			if not existing then local cloth = char:FindFirstChild("Clothing"); if cloth then for _, c in cloth:GetChildren() do if c:IsA("Shirt") then existing = c; break end end end end
			if existing then existing.ShirtTemplate = "rbxassetid://" .. shirtIds[1]
			else local s = Instance.new("Shirt"); s.ShirtTemplate = "rbxassetid://" .. shirtIds[1]; s.Parent = char end
		end
		if #pantsIds > 0 then
			local existing; for _, c in char:GetChildren() do if c:IsA("Pants") then existing = c; break end end
			if not existing then local cloth = char:FindFirstChild("Clothing"); if cloth then for _, c in cloth:GetChildren() do if c:IsA("Pants") then existing = c; break end end end end
			if existing then existing.PantsTemplate = "rbxassetid://" .. pantsIds[1]
			else local p = Instance.new("Pants"); p.PantsTemplate = "rbxassetid://" .. pantsIds[1]; p.Parent = char end
		end
	end)
	if not ok then setStatus("Error: " .. err, Color3.fromRGB(255, 100, 100)); return end
	setStatus("Applied!", Color3.fromRGB(140, 200, 140))
end)

-- ===== ACCESSORIES =====
local accBox = makeBox("Accessory IDs (comma-separated)")
local accOX = makeLabeledRow("X (Left/Right):", "0")
local accOY = makeLabeledRow("Y (Up/Down):", "0.5")
local accOZ = makeLabeledRow("Z (Forward/Back):", "0")

makeBtn("Apply Accessory", Color3.fromRGB(26, 24, 40), function()
	if lockActive then lockBypass = lockBypass + 1 end
	local ok2, err2 = pcall(function()
		setStatus("Applying accessory...", Color3.fromRGB(140, 200, 140))
		local char = SkinLP.Character
		if not char then setStatus("No character!", Color3.fromRGB(255, 100, 100)); return end
		local accIds = extractIds(accBox.Text)
		if #accIds == 0 then setStatus("Enter an accessory ID!", Color3.fromRGB(255, 180, 80)); return end
		for _, id in accIds do
			local weldName = "AccWeld_" .. id
			for _, c in char:GetChildren() do if c:IsA("Accessory") then local h = c:FindFirstChild("Handle"); if h and h:FindFirstChild(weldName) then c:Destroy() end end end
			local ok, loaded = pcall(game.GetObjects, game, "rbxassetid://" .. id)
			if ok and loaded then
				for _, obj in loaded do
					if obj:IsA("Accessory") then
						obj.Parent = char
						local handle = obj:FindFirstChild("Handle"); local head = char:FindFirstChild("Head")
						if handle and head then
							handle.Massless = true
							local ox = tonumber(accOX.Text) or 0; local oy = tonumber(accOY.Text) or 0.5; local oz = tonumber(accOZ.Text) or 0
							local weld = Instance.new("Weld"); weld.Name = weldName; weld.Part0 = head; weld.Part1 = handle; weld.C0 = CFrame.new(ox, oy, oz); weld.Parent = handle
						end
					end
				end
			end
		end
		setStatus("Accessory applied!", Color3.fromRGB(140, 200, 140))
	end)
	if not ok2 then setStatus("ERROR: " .. tostring(err2), Color3.fromRGB(255, 80, 80)) end
	if lockBypass > 0 then lockBypass = lockBypass - 1 end
end)

makeBtn("Reset All", Color3.fromRGB(65, 18, 18), function()
	if lockActive then setStatus("Turn Lock OFF first!", Color3.fromRGB(255, 180, 80)); return end
	shirtBox.Text = ""; pantsBox.Text = ""; accBox.Text = ""
	local char = SkinLP.Character
	if char then
		local count = 0; for _, old in char:GetChildren() do if old:IsA("Accessory") then old:Destroy(); count = count + 1 end end
		local head = char:FindFirstChild("Head"); if head then head.Transparency = 0 end
		setStatus("Reset complete" .. (count > 0 and " (" .. count .. " accessories removed)" or ""), Color3.fromRGB(200, 180, 120))
	else setStatus("Textboxes cleared", Color3.fromRGB(200, 180, 120)) end
end)

local rotRow = Instance.new("Frame")
rotRow.Size = UDim2.new(1, 0, 0, 28); rotRow.BackgroundTransparency = 1; rotRow.Parent = skinTabFrame
local rotLbl = Instance.new("TextLabel")
rotLbl.Size = UDim2.new(0, 110, 1, 0); rotLbl.BackgroundTransparency = 1; rotLbl.Text = "Angle (degrees):"
rotLbl.TextColor3 = txtSec; rotLbl.TextSize = 12; rotLbl.Font = Enum.Font.Gotham; rotLbl.TextXAlignment = Enum.TextXAlignment.Left; rotLbl.Parent = rotRow
local rotBox = Instance.new("TextBox")
rotBox.Size = UDim2.new(0, 55, 1, -4); rotBox.Position = UDim2.new(0, 112, 0, 2)
rotBox.BackgroundColor3 = inpBg; rotBox.BorderSizePixel = 0; rotBox.Text = "90"; rotBox.TextColor3 = txtPri
rotBox.TextSize = 12; rotBox.Font = Enum.Font.Gotham; rotBox.ClearTextOnFocus = false; rotBox.Parent = rotRow
local rbc = Instance.new("UICorner"); rbc.CornerRadius = UDim.new(0, 4); rbc.Parent = rotBox
local rbs = Instance.new("UIStroke"); rbs.Color = bdr; rbs.Thickness = 1; rbs.Parent = rotBox

makeBtn("Rotate Accessories", Color3.fromRGB(50, 30, 55), function()
	if lockActive then setStatus("Turn Lock OFF first!", Color3.fromRGB(255, 180, 80)); return end
	local char = SkinLP.Character; if not char then return end
	local deg = tonumber(rotBox.Text) or 90; local rad = math.rad(deg); local count = 0
	local targetIds = extractIds(accBox.Text); local targetSet = {}
	for _, id in targetIds do targetSet[id] = true end
	for _, c in char:GetDescendants() do
		if c:IsA("Weld") and c.Name:lower():find("accweld") and c.Part0 then
			local weldId = c.Name:match("AccWeld_(.+)") or ""
			if #targetIds == 0 or targetSet[weldId] then
				c.C0 = CFrame.new(c.C0.Position) * CFrame.Angles(0, rad, 0); count = count + 1
			end
		end
	end
	if count > 0 then setStatus("Rotated " .. count .. " by " .. deg .. " deg", Color3.fromRGB(200, 180, 120))
	else setStatus("No accessories to rotate", Color3.fromRGB(200, 180, 120)) end
end)

makeBtn("Remove Hair", Color3.fromRGB(65, 18, 45), function()
	if lockActive then setStatus("Turn Lock OFF first!", Color3.fromRGB(255, 180, 80)); return end
	local char = SkinLP.Character; if not char then return end
	local removed = 0
	for _, c in char:GetDescendants() do
		local name = c.Name:lower()
		if (name == "hair" or name:find("hair")) and (c:IsA("MeshPart") or c:IsA("Part") or c:IsA("SpecialMesh")) then
			if c:IsA("BasePart") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end
			if c:IsA("SpecialMesh") then c.Transparency = 1 end; removed = removed + 1
		end
	end
	if removed > 0 then setStatus("Hidden hair! (" .. removed .. " parts)", Color3.fromRGB(200, 180, 120))
	else setStatus("No hair found", Color3.fromRGB(200, 180, 120)) end
end)

makeBtn("Hide Head", Color3.fromRGB(55, 30, 55), function()
	local char = SkinLP.Character; if not char then setStatus("No character!", Color3.fromRGB(255, 100, 100)); return end
	headHidden = true; if lockActive and lockState then lockState.headTrans = 1 end
	local count = 0
	for _, c in char:GetDescendants() do
		if c:IsA("BasePart") and (c.Name == "Head" or c.Name == "FakeHead" or c.Name == "FH" or (c:FindFirstChildWhichIsA("Decal") ~= nil)) then
			c.Transparency = 1; c.CanCollide = false; c.CastShadow = false
			for _, d in c:GetDescendants() do if d:IsA("SpecialMesh") or d:IsA("Decal") or d:IsA("SurfaceAppearance") then d:Destroy() end end
			count = count + 1
		end
	end
	if count > 0 then setStatus("Head hidden!", Color3.fromRGB(140, 200, 140))
	else setStatus("No head parts found", Color3.fromRGB(200, 180, 120)) end
end)

makeBtn("Remove Character Accessories", Color3.fromRGB(60, 18, 40), function()
	local char = SkinLP.Character; if not char then setStatus("No character!", Color3.fromRGB(255, 100, 100)); return end
	charAccsRemoved = true; if lockActive and lockState then lockState.charAccsRemoved = true end
	local removed = 0
	for _, c in char:GetDescendants() do
		if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then
			c.Transparency = 1; c.CanCollide = false; c.CastShadow = false; removed = removed + 1
		end
	end
	if removed > 0 then setStatus("Hidden " .. removed .. " character accessories!", Color3.fromRGB(140, 200, 140))
	else setStatus("No character accessories found", Color3.fromRGB(200, 180, 120)) end
end)

-- ===== SAVING =====
local saveNameBox = makeBox("Preset name (e.g. Gojo Default)")

local function ensureSaveFolder()
	if not isfolder("PiggyHub/") then pcall(makefolder, "PiggyHub/") end
	if not isfolder(SAVE_FOLDER) then pcall(makefolder, SAVE_FOLDER) end
end

local function getPresetNames()
	ensureSaveFolder(); local names = {}
	local ok, files = pcall(listfiles, SAVE_FOLDER)
	if ok then for _, f in files do local n = f:match("([^/\\]+)%.json$"); if n then table.insert(names, n) end end end
	table.sort(names); return names
end

local function capturePresetData()
	local char = SkinLP.Character; local data = {}; local shirtId, pantsId = "", ""
	if char then
		for _, c in char:GetChildren() do if c:IsA("Shirt") then shirtId = c.ShirtTemplate; break end end
		for _, c in char:GetChildren() do if c:IsA("Pants") then pantsId = c.PantsTemplate; break end end
	end
	if shirtId == "" then local ids = extractIds(shirtBox.Text); if #ids > 0 then shirtId = "rbxassetid://" .. ids[1] end end
	if pantsId == "" then local ids = extractIds(pantsBox.Text); if #ids > 0 then pantsId = "rbxassetid://" .. ids[1] end end
	data.shirtId = shirtId; data.pantsId = pantsId
	if char then
		local head = char:FindFirstChild("Head")
		if head then
			data.headTransparency = head.Transparency
			data.headMeshId = head:IsA("MeshPart") and head.MeshId or ""
		end
		data.headHidden = head and head.Transparency >= 0.99 or headHidden
		local hasHair = false
		for _, c in char:GetDescendants() do
			local n = c.Name:lower()
			if (n == "hair" or n:find("hair")) and (c:IsA("MeshPart") or c:IsA("Part") or c:IsA("SpecialMesh") or c:IsA("Weld")) then hasHair = true; break end
		end
		data.hairRemoved = not hasHair
		local hiddenCount = 0
		for _, c in char:GetDescendants() do
			if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then
				if c.Transparency >= 0.99 then hiddenCount = hiddenCount + 1 end
			end
		end
		data.accessoriesRemoved = hiddenCount > 0
	end
	data.accessories = {}
	if char then
		for _, c in char:GetChildren() do
			if c:IsA("Accessory") then
				local handle = c:FindFirstChild("Handle")
				if handle then
					for _, w in handle:GetChildren() do
						if w:IsA("Weld") then
							local id = ""
							if w.Name:find("^AccWeld_") then id = w.Name:match("AccWeld_(.+)") or ""
							else
								local m = handle:IsA("MeshPart") and handle.MeshId:match("(%d+)") or ""
								if m == "" then
									local sm = handle:FindFirstChildWhichIsA("SpecialMesh")
									if sm then local mid; pcall(function() mid = sm.MeshId end); local tex; pcall(function() tex = sm.Texture end); m = (mid and mid:match("(%d+)")) or (tex and tex:match("(%d+)")) or "" end
								end
								id = m
							end
							if id ~= "" then
								local rx, ry, rz = w.C0:ToOrientation()
								table.insert(data.accessories, {id = id, x = w.C0.X, y = w.C0.Y, z = w.C0.Z, rx = rx, ry = ry, rz = rz})
							end; break
						end
					end
				end
			end
		end
	end
	data.lockActive = lockActive; return data
end

local function applyPresetData(data)
	local char = SkinLP.Character; if not char then setStatus("No character to apply to!", Color3.fromRGB(255, 100, 100)); return false end
	local wasLocked = lockActive
	if wasLocked then disableLock() end
	if data.shirtId and data.shirtId ~= "" then
		local found; for _, c in char:GetChildren() do if c:IsA("Shirt") then found = c; break end end
		if not found then found = Instance.new("Shirt"); found.Parent = char end; found.ShirtTemplate = data.shirtId
	end
	if data.pantsId and data.pantsId ~= "" then
		local found; for _, c in char:GetChildren() do if c:IsA("Pants") then found = c; break end end
		if not found then found = Instance.new("Pants"); found.Parent = char end; found.PantsTemplate = data.pantsId
	end
	if char then
		local head = char:FindFirstChild("Head")
		if head then
			if data.headTransparency ~= nil then head.Transparency = data.headTransparency end
			if data.headMeshId and data.headMeshId ~= "" and head:IsA("MeshPart") then head.MeshId = data.headMeshId end
		end
	end
	if data.accessories and #data.accessories > 0 then
		for _, c in char:GetChildren() do if c:IsA("Accessory") then c:Destroy() end end
		local head = char:FindFirstChild("Head")
		for _, ad in data.accessories do
			local ok, loaded = pcall(game.GetObjects, game, "rbxassetid://" .. ad.id)
			if ok and loaded then
				for _, obj in loaded do
					if obj:IsA("Accessory") then
						obj.Parent = char; local handle = obj:FindFirstChild("Handle")
						if handle and head then
							handle.Massless = true
							local weld = Instance.new("Weld"); weld.Name = "AccWeld_" .. ad.id; weld.Part0 = head; weld.Part1 = handle
							weld.C0 = CFrame.new(ad.x or 0, ad.y or 0.5, ad.z or 0) * CFrame.fromOrientation(ad.rx or 0, ad.ry or 0, ad.rz or 0)
							weld.Parent = handle
						end
					end
				end
			end
		end
	end
	if data.accessoriesRemoved then
		for _, c in char:GetDescendants() do
			if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then
				c.Transparency = 1; c.CanCollide = false; c.CastShadow = false
			end
		end
	end
	if data.hairRemoved then
		for _, c in char:GetDescendants() do
			local n = c.Name:lower()
			if (n == "hair" or n:find("hair")) and (c:IsA("MeshPart") or c:IsA("Part") or c:IsA("SpecialMesh")) then
				if c:IsA("BasePart") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end
				if c:IsA("SpecialMesh") then c.Transparency = 1 end
			end
			if c:IsA("Weld") and c.Name:lower():find("hair") then c:Destroy() end
		end
	end
	local ch = SkinLP.Character
	if ch then
		if data.headHidden then
			for _, c in ch:GetDescendants() do
				if c:IsA("BasePart") and (c.Name == "Head" or c.Name == "FakeHead" or c.Name == "FH") then
					c.Transparency = 1; c.CanCollide = false; c.CastShadow = false
					for _, d in c:GetDescendants() do
						if d:IsA("SpecialMesh") or d:IsA("Decal") or d:IsA("SurfaceAppearance") then d:Destroy() end
					end
				end
			end
		end
		if data.accessoriesRemoved then
			for _, c in ch:GetDescendants() do
				if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then
					c.Transparency = 1; c.CanCollide = false; c.CastShadow = false
				end
			end
		end
	end
	lockActive = true
	if ch then
		local ok, state = pcall(captureCharState, ch)
		if ok and state then
			lockState = state
			pcall(enforceProperties, ch, lockState)
			if lockLoop then coroutine.close(lockLoop); lockLoop = nil end
			lockLoop = coroutine.create(function() while true do task.wait(0.15); if not lockActive then break end; local c2 = SkinLP.Character; if c2 and lockState then enforceLight(c2, lockState) end end end)
			coroutine.resume(lockLoop)
			if lockDescCon then lockDescCon:Disconnect(); lockDescCon = nil end
			lockDescCon = ch.DescendantAdded:Connect(function(c)
				if not lockActive or not lockState then return end
				if c:IsA("Shirt") and lockState.shirt then c.ShirtTemplate = lockState.shirt; return end
				if c:IsA("Pants") and lockState.pants then c.PantsTemplate = lockState.pants; return end
				if c:IsA("Accessory") then if lockBypass > 0 then lockBypass = lockBypass - 1; return end; local h = c:FindFirstChild("Handle"); if h and h:IsA("BasePart") then h.Transparency = 1; h.CanCollide = false; h.CastShadow = false end; return end
				if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end
				if c:IsA("Decal") then c.Transparency = 1 end
			end)
		end
	end
	lockBtn.Text = "Lock: ON"; lockBtn.TextColor3 = Color3.fromRGB(140, 200, 140); lockStroke.Color = Color3.fromRGB(8, 60, 8)
	setStatus("Preset loaded + Lock ON", Color3.fromRGB(140, 200, 140))
	return true
end

local saveBtn = Instance.new("TextButton")
saveBtn.Size = UDim2.new(1, 0, 0, 30); saveBtn.BackgroundColor3 = Color3.fromRGB(40, 55, 40); saveBtn.BorderSizePixel = 0
saveBtn.Text = "Save Preset"; saveBtn.TextColor3 = txtPri; saveBtn.TextSize = 12; saveBtn.Font = Enum.Font.GothamSemibold; saveBtn.Parent = skinTabFrame
local sbc = Instance.new("UICorner"); sbc.CornerRadius = UDim.new(0, 5); sbc.Parent = saveBtn
saveBtn.InputBegan:Connect(function(inp, proc)
	if proc then return end
	if inp.UserInputType == Enum.UserInputType.MouseButton1 then
		local name = saveNameBox.Text; if #name == 0 then setStatus("Enter a preset name!", Color3.fromRGB(255, 180, 80)); return end
		local data = capturePresetData(); local json = game:GetService("HttpService"):JSONEncode(data)
		ensureSaveFolder(); local ok, err = pcall(writefile, SAVE_FOLDER .. name .. ".json", json)
		if not ok then setStatus("Save failed: " .. tostring(err), Color3.fromRGB(255, 100, 100)); return end
		setStatus("Saved preset: " .. name, Color3.fromRGB(140, 200, 140)); refreshPresetList()
	end
end)



local presetListFrame = Instance.new("Frame")
presetListFrame.Size = UDim2.new(1, 0, 0, 0); presetListFrame.BackgroundTransparency = 1; presetListFrame.Parent = skinTabFrame; presetListFrame.ClipsDescendants = true

local function refreshPresetList()
	for _, c in presetListFrame:GetChildren() do c:Destroy() end
	local names = getPresetNames(); local py = 0
	if #names == 0 then
		local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 0, 20); lbl.Position = UDim2.new(0, 0, 0, py)
		lbl.BackgroundTransparency = 1; lbl.Text = "No saved presets"; lbl.TextColor3 = txtSec; lbl.TextSize = 11
		lbl.Font = Enum.Font.Gotham; lbl.Parent = presetListFrame; py = py + 20
	else
		for _, name in names do
			local row = Instance.new("Frame"); row.Size = UDim2.new(1, 0, 0, 28); row.Position = UDim2.new(0, 0, 0, py)
			row.BackgroundTransparency = 1; row.Parent = presetListFrame
			local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(0.5, -4, 1, 0); lbl.BackgroundTransparency = 1
			lbl.Text = name; lbl.TextColor3 = txtPri; lbl.TextSize = 12; lbl.Font = Enum.Font.Gotham; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
			local loadBtn = Instance.new("TextButton"); loadBtn.Size = UDim2.new(0.24, -2, 1, -4); loadBtn.Position = UDim2.new(0.5, 0, 0, 2)
			loadBtn.BackgroundColor3 = Color3.fromRGB(32, 48, 32); loadBtn.BorderSizePixel = 0
			loadBtn.Text = "Load"; loadBtn.TextColor3 = Color3.fromRGB(140, 200, 140); loadBtn.TextSize = 11; loadBtn.Font = Enum.Font.GothamSemibold; loadBtn.Parent = row
			local lc = Instance.new("UICorner"); lc.CornerRadius = UDim.new(0, 4); lc.Parent = loadBtn
			loadBtn.InputBegan:Connect(function(inp, proc)
				if proc then return end
				if inp.UserInputType == Enum.UserInputType.MouseButton1 then
					local path = SAVE_FOLDER .. name .. ".json"
					if isfile(path) then
						local ok, data = pcall(game:GetService("HttpService").JSONDecode, game:GetService("HttpService"), readfile(path))
						if ok then if applyPresetData(data) then setStatus("Loaded: " .. name, Color3.fromRGB(140, 200, 140)) end
						else setStatus("Parse error!", Color3.fromRGB(255, 100, 100)) end
					else setStatus("File not found!", Color3.fromRGB(255, 100, 100)); refreshPresetList() end
				end
			end)
			local delBtn = Instance.new("TextButton"); delBtn.Size = UDim2.new(0.24, -2, 1, -4); delBtn.Position = UDim2.new(0.76, 0, 0, 2)
			delBtn.BackgroundColor3 = Color3.fromRGB(60, 18, 18); delBtn.BorderSizePixel = 0
			delBtn.Text = "Del"; delBtn.TextColor3 = Color3.fromRGB(220, 120, 120); delBtn.TextSize = 11; delBtn.Font = Enum.Font.GothamSemibold; delBtn.Parent = row
			local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0, 4); dc.Parent = delBtn
			delBtn.InputBegan:Connect(function(inp, proc)
				if proc then return end
				if inp.UserInputType == Enum.UserInputType.MouseButton1 then
					local path = SAVE_FOLDER .. name .. ".json"
					if isfile(path) then pcall(delfile, path); setStatus("Deleted: " .. name, Color3.fromRGB(200, 120, 120)); refreshPresetList() end
				end
			end)
			py = py + 32
		end
	end
	presetListFrame.Size = UDim2.new(1, 0, 0, py)
end

local refreshBtn = Instance.new("TextButton")
refreshBtn.Size = UDim2.new(1, 0, 0, 26); refreshBtn.BackgroundColor3 = Color3.fromRGB(195, 28, 28); refreshBtn.BorderSizePixel = 0
refreshBtn.Text = "Refresh List"; refreshBtn.TextColor3 = txtPri; refreshBtn.TextSize = 11; refreshBtn.Font = Enum.Font.GothamSemibold; refreshBtn.Parent = skinTabFrame
local rfc = Instance.new("UICorner"); rfc.CornerRadius = UDim.new(0, 5); rfc.Parent = refreshBtn
refreshBtn.InputBegan:Connect(function(inp, proc) if proc then return end; if inp.UserInputType == Enum.UserInputType.MouseButton1 then refreshPresetList() end end)
refreshPresetList()

-- ===== LOCK SYSTEM =====
local function findCloth(char, isShirt)
	local cls = isShirt and "Shirt" or "Pants"
	for _, c in char:GetChildren() do if c:IsA(cls) then return c end end
	local cloth = char:FindFirstChild("Clothing"); if cloth then for _, c in cloth:GetChildren() do if c:IsA(cls) then return c end end end
	return nil
end

local function captureCharState(char)
	if not char then return nil end
	local s = {}
	for _, c in char:GetChildren() do if c:IsA("Shirt") then s.shirt = c.ShirtTemplate; break end end
	for _, c in char:GetChildren() do if c:IsA("Pants") then s.pants = c.PantsTemplate; break end end
	s.colors = {}; s.transparencies = {}
	for _, n in LOCK_BODY_PARTS do local p = char:FindFirstChild(n); if p and p:IsA("BasePart") then s.colors[n] = p.Color; s.transparencies[n] = p.Transparency end end
	local head = char:FindFirstChild("Head")
	if head then
		s.headTrans = head.Transparency; s.headMeshId = head:IsA("MeshPart") and head.MeshId or ""; s.headShape = head:IsA("Part") and head.Shape or Enum.PartShape.Block
		s.faceDecals = {}; s.headSMeshes = {}
		for _, d in head:GetDescendants() do
			if d:IsA("Decal") then table.insert(s.faceDecals, {Face = d.Face, Texture = d.Texture}) end
			if d:IsA("SpecialMesh") then local tex; pcall(function() tex = d.Texture end); table.insert(s.headSMeshes, {Texture = tex or "", MeshType = d.MeshType, MeshId = d.MeshId, Scale = d.Scale}) end
		end
	end
	s.hairRemoved = true
	for _, c in char:GetDescendants() do local n = c.Name:lower(); if (n == "hair" or n:find("hair")) and (c:IsA("MeshPart") or c:IsA("Part") or c:IsA("SpecialMesh") or c:IsA("Weld")) then s.hairRemoved = false; break end end
	s.accData = {}
	for _, c in char:GetChildren() do
		if c:IsA("Accessory") then
			local handle = c:FindFirstChild("Handle")
			if handle then
				local assetId = ""
				for _, w in handle:GetChildren() do
					if w:IsA("Weld") and w.Name:find("^AccWeld_") then
						assetId = w.Name:match("AccWeld_(.+)") or ""
						if assetId ~= "" then local rx, ry, rz = w.C0:ToOrientation(); table.insert(s.accData, {id = assetId, x = w.C0.X, y = w.C0.Y, z = w.C0.Z, rx = rx, ry = ry, rz = rz}); break end
					end
				end
				if assetId == "" then
					for _, w in handle:GetChildren() do
						if w:IsA("Weld") and w.Part0 then
							local mid = handle:IsA("MeshPart") and handle.MeshId:match("(%d+)") or ""
							if mid == "" then local sm = handle:FindFirstChildWhichIsA("SpecialMesh"); if sm then local smTex; pcall(function() smTex = sm.Texture end); mid = sm.MeshId:match("(%d+)") or (smTex and smTex:match("(%d+)")) or "" end end
							if mid ~= "" then local rx, ry, rz = w.C0:ToOrientation(); table.insert(s.accData, {id = mid, x = w.C0.X, y = w.C0.Y, z = w.C0.Z, rx = rx, ry = ry, rz = rz}) end; break
						end
					end
				end
			end
		end
	end
	local hiddenNonStd = 0
	for _, c in char:GetDescendants() do if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then if c.Transparency >= 0.99 then hiddenNonStd = hiddenNonStd + 1 end end end
	s.charAccsRemoved = hiddenNonStd > 0; return s
end

local function enforceProperties(char, s)
	if not char or not s then return end; pcall(function()
		local sh = findCloth(char, true)
		if s.shirt then if not sh then sh = Instance.new("Shirt"); sh.Parent = char end; sh.ShirtTemplate = s.shirt elseif sh then sh:Destroy() end
		local pa = findCloth(char, false)
		if s.pants then if not pa then pa = Instance.new("Pants"); pa.Parent = char end; pa.PantsTemplate = s.pants elseif pa then pa:Destroy() end
		for _, n in LOCK_BODY_PARTS do local p = char:FindFirstChild(n); if p and p:IsA("BasePart") then if s.colors[n] then p.Color = s.colors[n] end; if s.transparencies[n] ~= nil then p.Transparency = s.transparencies[n] end end end
		local head = char:FindFirstChild("Head")
		if head then
			if s.headTrans ~= nil then
				head.Transparency = s.headTrans
				if s.headTrans >= 0.9 then
					head.CanCollide = false; head.CastShadow = false
					for _, d in head:GetDescendants() do if d:IsA("SpecialMesh") or d:IsA("Decal") or d:IsA("SurfaceAppearance") then d:Destroy() end end
					for _, c in char:GetDescendants() do if (c.Name == "FakeHead" or c.Name == "FH") and c:IsA("BasePart") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false; for _, d in c:GetDescendants() do if d:IsA("SpecialMesh") or d:IsA("Decal") or d:IsA("SurfaceAppearance") then d:Destroy() end end end end
				end
			end
			if head:IsA("MeshPart") and s.headMeshId and s.headMeshId ~= "" then head.MeshId = s.headMeshId elseif head:IsA("Part") and s.headShape then head.Shape = s.headShape end
			if s.faceDecals then for _, fd in s.faceDecals do local found; for _, d in head:GetDescendants() do if d:IsA("Decal") and d.Face == fd.Face then found = d; if d.Texture ~= fd.Texture then d.Texture = fd.Texture end end end; if not found then local nd = Instance.new("Decal"); nd.Face = fd.Face; nd.Texture = fd.Texture; nd.Parent = head end end end
			if s.headSMeshes then for _, hm in s.headSMeshes do local found; for _, m in head:GetDescendants() do if m:IsA("SpecialMesh") then found = m; if hm.Texture then pcall(function() m.Texture = hm.Texture end) end; if m.MeshType ~= hm.MeshType then m.MeshType = hm.MeshType end; if hm.MeshId and m.MeshId ~= hm.MeshId then m.MeshId = hm.MeshId end; if hm.Scale and m.Scale ~= hm.Scale then m.Scale = hm.Scale end end end; if not found then local nm = Instance.new("SpecialMesh"); pcall(function() nm.Texture = hm.Texture or "" end); nm.MeshType = hm.MeshType; nm.MeshId = hm.MeshId or ""; nm.Scale = hm.Scale or Vector3.new(1,1,1); nm.Parent = head end end end
		end
		if s.hairRemoved then for _, c in char:GetDescendants() do local n = c.Name:lower(); if (n == "hair" or n:find("hair")) and (c:IsA("MeshPart") or c:IsA("Part") or c:IsA("SpecialMesh")) then if c:IsA("BasePart") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end; if c:IsA("SpecialMesh") then c.Transparency = 1 end end end end
		if s.accData and #s.accData > 0 then
			lockBypass = #s.accData
			for _, ad in s.accData do
				local ok, loaded = pcall(game.GetObjects, game, "rbxassetid://" .. ad.id)
				if ok and loaded then for _, obj in loaded do if obj:IsA("Accessory") then obj.Parent = char; local handle = obj:FindFirstChild("Handle"); if handle and head then handle.Massless = true; local weld = Instance.new("Weld"); weld.Name = "AccWeld_" .. ad.id; weld.Part0 = head; weld.Part1 = handle; weld.C0 = CFrame.new(ad.x, ad.y, ad.z) * CFrame.fromOrientation(ad.rx, ad.ry, ad.rz); weld.Parent = handle end end end end
				lockBypass = lockBypass - 1
			end
		end
		if s.charAccsRemoved then for _, c in char:GetDescendants() do if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end end end
	end)
end

local function enforceLight(char, s)
	if not char or not s then return end; pcall(function()
		local sh = findCloth(char, true); if s.shirt then if not sh then sh = Instance.new("Shirt"); sh.Parent = char end; sh.ShirtTemplate = s.shirt elseif sh then sh:Destroy() end
		local pa = findCloth(char, false); if s.pants then if not pa then pa = Instance.new("Pants"); pa.Parent = char end; pa.PantsTemplate = s.pants elseif pa then pa:Destroy() end
		for _, n in LOCK_BODY_PARTS do local p = char:FindFirstChild(n); if p and p:IsA("BasePart") then if s.colors[n] then p.Color = s.colors[n] end; if s.transparencies[n] ~= nil then p.Transparency = s.transparencies[n] end end end
		local head = char:FindFirstChild("Head")
		if head then head.Transparency = s.headTrans or 0; if s.headShape and head:IsA("Part") then head.Shape = s.headShape end; if head:IsA("MeshPart") and s.headMeshId and s.headMeshId ~= "" then head.MeshId = s.headMeshId end end
		if s.charAccsRemoved then for _, c in char:GetDescendants() do if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end end end
	end)
end

local function enableLock()
	if not SkinLP.Character then setStatus("Cannot lock: no character!", Color3.fromRGB(255, 100, 100)); return end
	local char = SkinLP.Character; if not char then setStatus("Cannot lock: no character!", Color3.fromRGB(255, 100, 100)); return end
	local ok, state = pcall(captureCharState, char); if not ok or not state then setStatus("Failed to capture character state!", Color3.fromRGB(255, 100, 100)); return end
	lockActive = true; lockState = state; enforceProperties(char, lockState)
	if lockLoop then coroutine.close(lockLoop); lockLoop = nil end
	lockLoop = coroutine.create(function() while true do task.wait(0.15); if not lockActive then break end; local ch = SkinLP.Character; if ch and lockState then enforceLight(ch, lockState) end end end)
	coroutine.resume(lockLoop)
	if lockDescCon then lockDescCon:Disconnect(); lockDescCon = nil end
	lockDescCon = char.DescendantAdded:Connect(function(c)
		if not lockActive or not lockState then return end
		if c:IsA("Shirt") and lockState.shirt then c.ShirtTemplate = lockState.shirt; return end
		if c:IsA("Pants") and lockState.pants then c.PantsTemplate = lockState.pants; return end
		if c:IsA("Accessory") then if lockBypass > 0 then lockBypass = lockBypass - 1; return end; local h = c:FindFirstChild("Handle"); if h and h:IsA("BasePart") then h.Transparency = 1; h.CanCollide = false; h.CastShadow = false end; return end
		if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end
		if c:IsA("Decal") then c.Transparency = 1 end
	end)
	setStatus("Character locked!", Color3.fromRGB(140, 200, 140))
end

local function disableLock()
	lockActive = false; lockState = nil
	if lockLoop then coroutine.close(lockLoop); lockLoop = nil end
	if lockDescCon then lockDescCon:Disconnect(); lockDescCon = nil end
	local char = SkinLP.Character
	if char then
		if headHidden then
			for _, c in char:GetDescendants() do
				if c:IsA("BasePart") and (c.Name == "Head" or c.Name == "FakeHead" or c.Name == "FH") then
					c.Transparency = 0; c.CanCollide = true; c.CastShadow = true
				end
			end
		end
		if charAccsRemoved then
			for _, c in char:GetDescendants() do
				if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then
					c.Transparency = 0; c.CanCollide = true; c.CastShadow = true
				end
			end
		end
	end
	headHidden = false; charAccsRemoved = false
end

local enforceCor = coroutine.create(function()
	while true do
		task.wait(0.1); local char = SkinLP.Character
		if char then
			local accsRemoved = charAccsRemoved or (lockActive and lockState and lockState.charAccsRemoved)
			if headHidden or (lockActive and lockState and lockState.headTrans and lockState.headTrans >= 0.99) then
				for _, c in char:GetDescendants() do if c:IsA("BasePart") and (c.Name == "Head" or c.Name == "FakeHead" or c.Name == "FH") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end end
			end
			if accsRemoved then
				for _, c in char:GetDescendants() do if c:IsA("BasePart") and not STANDARD_PARTS[c.Name] and not c:FindFirstAncestorOfClass("Accessory") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end end
			end
		end
	end
end)
coroutine.resume(enforceCor)
_G.__SkinCleanup = { enforceCor = enforceCor }

local lockBtn = Instance.new("TextButton")
lockBtn.Size = UDim2.new(1, 0, 0, 32); lockBtn.BackgroundColor3 = Color3.fromRGB(30, 28, 38); lockBtn.BorderSizePixel = 0
lockBtn.Text = "Lock: OFF"; lockBtn.TextColor3 = Color3.fromRGB(200, 80, 80); lockBtn.TextSize = 13; lockBtn.Font = Enum.Font.GothamBold; lockBtn.Parent = skinTabFrame
local lc2 = Instance.new("UICorner"); lc2.CornerRadius = UDim.new(0, 6); lc2.Parent = lockBtn
local lockStroke = Instance.new("UIStroke"); lockStroke.Color = Color3.fromRGB(60, 8, 8); lockStroke.Thickness = 2; lockStroke.Parent = lockBtn
lockBtn.InputBegan:Connect(function(inp, proc)
	if proc then return end
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if lockActive then disableLock(); lockBtn.Text = "Lock: OFF"; lockBtn.TextColor3 = Color3.fromRGB(200, 80, 80); lockStroke.Color = Color3.fromRGB(60, 8, 8); setStatus("Character unlocked!", Color3.fromRGB(200, 180, 120))
		else enableLock(); if lockActive then lockBtn.Text = "Lock: ON"; lockBtn.TextColor3 = Color3.fromRGB(140, 200, 140); lockStroke.Color = Color3.fromRGB(8, 60, 8) end end
	end
end)

-- Respawn auto-apply
table.insert(connections, SkinLP.CharacterAdded:Connect(function(char)
	local ok, err = pcall(function() char:WaitForChild("HumanoidRootPart", 5) end); if not ok then return end; task.wait(2)
	if lockActive then
		local ch = SkinLP.Character; if not ch then return end
		if not lockState then
			local ok, newState = pcall(captureCharState, ch)
			if ok and newState then lockState = newState else disableLock(); lockBtn.Text = "Lock: OFF"; lockBtn.TextColor3 = Color3.fromRGB(200, 80, 80); lockStroke.Color = Color3.fromRGB(60, 8, 8); setStatus("Lock state lost — re-toggle Lock ON!", Color3.fromRGB(255, 180, 80)); return end
		end
		if lockState and lockState.accData and #lockState.accData > 0 then for _, c in ch:GetChildren() do if c:IsA("Accessory") then local h = c:FindFirstChild("Handle"); if h and h:IsA("BasePart") then h.Transparency = 1; h.CanCollide = false; h.CastShadow = false end end end; task.wait(0.3) end
		if lockState then enforceProperties(ch, lockState) end
		if lockDescCon then lockDescCon:Disconnect(); lockDescCon = nil end
		lockDescCon = ch.DescendantAdded:Connect(function(c)
			if not lockActive or not lockState then return end
			if c:IsA("Shirt") and lockState.shirt then c.ShirtTemplate = lockState.shirt; return end
			if c:IsA("Pants") and lockState.pants then c.PantsTemplate = lockState.pants; return end
			if c:IsA("Accessory") then if lockBypass > 0 then lockBypass = lockBypass - 1; return end; local h = c:FindFirstChild("Handle"); if h and h:IsA("BasePart") then h.Transparency = 1; h.CanCollide = false; h.CastShadow = false end; return end
			if c:IsA("BasePart") then c.Transparency = 1; c.CanCollide = false; c.CastShadow = false end
			if c:IsA("Decal") then c.Transparency = 1 end
		end)
		local lateCor = coroutine.create(function() task.wait(4); if lockActive and lockState then local ch2 = SkinLP.Character; if ch2 then enforceProperties(ch2, lockState) end end end); coroutine.resume(lateCor)
		setStatus("Lock re-applied on respawn!", Color3.fromRGB(140, 200, 140)); return
	end
	local sIds = extractIds(shirtBox.Text); local pIds = extractIds(pantsBox.Text)
	if #sIds > 0 then task.wait(0.5); local existing; for _, c in char:GetChildren() do if c:IsA("Shirt") then existing = c; break end end; if existing then existing.ShirtTemplate = "rbxassetid://" .. sIds[1] else local s = Instance.new("Shirt"); s.ShirtTemplate = "rbxassetid://" .. sIds[1]; s.Parent = char end end
	if #pIds > 0 then task.wait(0.5); local existing; for _, c in char:GetChildren() do if c:IsA("Pants") then existing = c; break end end; if existing then existing.PantsTemplate = "rbxassetid://" .. pIds[1] else local p = Instance.new("Pants"); p.PantsTemplate = "rbxassetid://" .. pIds[1]; p.Parent = char end end
end))

-- Canvas auto-size
local skinLayout = Instance.new("UIListLayout")
skinLayout.Padding = UDim.new(0, 6)
skinLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
skinLayout.Parent = skinTabFrame
skinLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	skinTabFrame.CanvasSize = UDim2.new(0, 0, 0, skinLayout.AbsoluteContentSize.Y + 20)
end)
task.spawn(function()
	skinTabFrame.CanvasSize = UDim2.new(0, 0, 0, skinLayout.AbsoluteContentSize.Y + 20)
end)

end
buildSkinTab()
;(function() -- wrap rest in IIFE to reduce register pressure
local targetEspSensitivity = 0.25
local targetEspRange = 180
local recentM1Time = os.clock()
-- Fly / HeadAttach state (lives here, not top-level: the main chunk is at
-- the 200-register limit). All users are below in this IIFE.
local flySwingTime = 0 -- last own-M1-swing timestamp (fly slows while fresh)
local headAttachEnabled = false
local headAttachKey = nil -- unbound by default; hold via the Rage keybind
local headAttachOffset = 0 -- studs beyond the target from your side (0 = directly above head)
local headAttachHolding = false
local headAttachFlying = false
local headAttachCurrent = nil
local headAttachToggleObj = nil
local headAttachOffsetDir = nil -- latched hover direction (camera-anchored, survives degenerate frames)
-- HeadAttach tuning (ported from headride.luau)
local HEAD_ATTACH_ABOVE = 3.2
local HEAD_ATTACH_CHASE = 0.35
local HEAD_ATTACH_STICK_DIST = 6
local HEAD_ATTACH_STICK = 0.2
local HEAD_ATTACH_DEADZONE = 0.8
local HEAD_ATTACH_BOB = 0.22
local HEAD_ATTACH_BOB_SPEED = 2.1
local HEAD_ATTACH_SWAY = 0.8
local HEAD_ATTACH_SWAY_SPEED = 1.4
local HEAD_ATTACH_SWITCH_MARGIN = 0.6
local HEAD_ATTACH_MAX_RANGE = 16

-- ====================== CONFIG MANAGER ======================
local HttpService = game:GetService("HttpService")
local CONFIG_FOLDER = "PiggyHub/configs/"
local settingsRefs = {}
local targetBanBoxRefs = {}
local antiBanBoxRef = {}

local ConfigManager = {}

function ConfigManager.ensureFolder()
	if not isfolder then return false end
	if not isfolder("PiggyHub/") then
		makefolder("PiggyHub/")
	end
	if not isfolder(CONFIG_FOLDER) then
		makefolder(CONFIG_FOLDER)
	end
	return true
end

function ConfigManager.collectSettings()
	return {
		guiEnabled = guiEnabled,
		teamCheckEnabled = teamCheckEnabled,
		predictionEnabled = predictionEnabled,
		predictionStrength = predictionStrength,
		smoothness = smoothness,
		lockKey = lockKey.Name,
		lockMode = lockMode,
		flyEnabled = flyEnabled,
		flyKey = flyKey and flyKey.Name or nil,
		flySpeed = flySpeed,
		headAttachEnabled = headAttachEnabled,
		headAttachKey = headAttachKey and headAttachKey.Name or nil,
		headAttachOffset = headAttachOffset,
		moveEspEnabled = moveEspEnabled,
		ultEspEnabled = ultEspEnabled,
		arrowsEnabled = arrowsEnabled,
		moveInputsEnabled = moveInputsEnabled,
		autoBlockEnabled = autoBlockEnabled,
		blockTapDelay = blockTapDelay,
		blockTapDuration = blockTapDuration,
		counterM1Delay = counterM1Delay,
		autoCounterEnabled = autoCounterEnabled,
		counterKey = counterKey.Name,
		airSwingEnabled = airSwingEnabled,
		swingRange = swingRange,
		airSwingDelay = airSwingDelay,
		triggerbotEnabled = triggerbotEnabled,
		triggerbotKey = triggerbotKey.Name,
		triggerbotSlot = triggerbotSlot,
		triggerbot2Key = triggerbot2Key.Name,
		triggerbot2Slot = triggerbot2Slot,
		autoInfinityKey = autoInfinityKey.Name,
		toggleUIKey = toggleUIKey.Name,
		autoBlackFlashEnabled = autoBlackFlashEnabled,
		autoInfinityEnabled = autoInfinityEnabled,
		autoInfinityUnlocked = autoInfinityUnlocked,
		autoInfinityLookSensitivity = autoInfinityLookSensitivity,
		autoInfinityRayRadius = autoInfinityRayRadius,
		autoPlayEnabled = autoPlayEnabled,
		autoSprintEnabled = autoSprintEnabled,
		targetBanText1 = targetBanBoxRefs[1] and targetBanBoxRefs[1].Text or "",
		targetBanText2 = targetBanBoxRefs[2] and targetBanBoxRefs[2].Text or "",
		targetBanText3 = targetBanBoxRefs[3] and targetBanBoxRefs[3].Text or "",
		targetBanText4 = targetBanBoxRefs[4] and targetBanBoxRefs[4].Text or "",
		targetBanEnabled = targetBanEnabled,
		antiBanText1 = antiBanBoxRef[1] and antiBanBoxRef[1].Text or "",
		antiBanEnabled = antiBanEnabled,
		ultEspSize = ultEspSize,
		moveEspSize = moveEspSize,
		gojoAfterimageEnabled = gojoAfterimageEnabled,
		targetEspEnabled = targetEspEnabled,
		targetEspSensitivity = targetEspSensitivity,
		targetEspRange = targetEspRange,
	}
end

function ConfigManager.save(name)
	ConfigManager.ensureFolder()
	local data = ConfigManager.collectSettings()
	local json = HttpService:JSONEncode(data)
	writefile(CONFIG_FOLDER .. name .. ".json", json)
end

function ConfigManager.load(name)
	local path = CONFIG_FOLDER .. name .. ".json"
	if not isfile then return false, "isfile not available" end
	if not isfile(path) then return false, "Config not found" end
	if not readfile then return false, "readfile not available" end
	local json = readfile(path)
	local success, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not success or not data then return false, "Invalid config file" end
	
	local ok, err = pcall(function()
	
	guiEnabled = data.guiEnabled or false
	teamCheckEnabled = data.teamCheckEnabled or false
	predictionEnabled = data.predictionEnabled or false
	predictionStrength = data.predictionStrength or 0.15
	smoothness = data.smoothness or 0.25
	if data.lockKey then lockKey = Enum.KeyCode[data.lockKey] or lockKey end
	do
		local mode = data.lockMode
		if mode ~= "Off" and mode ~= "Camera" and mode ~= "Silent" then
			-- Legacy file: boolean toggle + optional Camera/Silent mode.
			if data.guiEnabled then
				mode = (data.lockMode == "Silent") and "Silent" or "Camera"
			else
				mode = "Off"
			end
		end
		applyLockMode(mode)
	end
	flyEnabled = data.flyEnabled or false
	if data.flyKey then flyKey = Enum.KeyCode[data.flyKey] or nil end
	flySpeed = data.flySpeed or 50
	if flyEnabled then pcall(setFly, true) end
	headAttachEnabled = data.headAttachEnabled or false
	if data.headAttachKey then headAttachKey = Enum.KeyCode[data.headAttachKey] or nil end
	headAttachOffset = tonumber(data.headAttachOffset) or 0
	moveEspEnabled = data.moveEspEnabled or false
	ultEspEnabled = data.ultEspEnabled or false
			arrowsEnabled = data.arrowsEnabled or false
			moveInputsEnabled = data.moveInputsEnabled or false
			autoBlockEnabled = data.autoBlockEnabled or false
	blockTapDelay = data.blockTapDelay or 0.04
	blockTapDuration = data.blockTapDuration or 0.15
	counterM1Delay = data.counterM1Delay or 0.03
	autoCounterEnabled = data.autoCounterEnabled or false
	airSwingEnabled = data.airSwingEnabled or false
	if not airSwingEnabled then _G.airSwingTrack = nil end
	swingRange = data.swingRange or 18
	airSwingDelay = data.airSwingDelay or 0.40
	triggerbotEnabled = data.triggerbotEnabled or data.triggerbot2Enabled or false
	if data.triggerbotKey then triggerbotKey = Enum.KeyCode[data.triggerbotKey] or triggerbotKey end
	if type(data.triggerbotSlot) == "number" then triggerbotSlot = math.clamp(math.floor(data.triggerbotSlot), 1, 4) end
	if data.triggerbot2Key then triggerbot2Key = Enum.KeyCode[data.triggerbot2Key] or triggerbot2Key end
	if type(data.triggerbot2Slot) == "number" then triggerbot2Slot = math.clamp(math.floor(data.triggerbot2Slot), 1, 4) end
	if data.counterKey then counterKey = Enum.KeyCode[data.counterKey] or counterKey end
	if data.autoInfinityKey then autoInfinityKey = Enum.KeyCode[data.autoInfinityKey] or autoInfinityKey end
	if data.toggleUIKey then toggleUIKey = Enum.KeyCode[data.toggleUIKey] or toggleUIKey end
	autoBlackFlashEnabled = data.autoBlackFlashEnabled or false
	autoInfinityEnabled = data.autoInfinityEnabled or false
	autoInfinityUnlocked = data.autoInfinityUnlocked or false
	autoPlayEnabled = data.autoPlayEnabled or false
	autoSprintEnabled = data.autoSprintEnabled or false
	if data.targetBanText1 and targetBanBoxRefs[1] then targetBanBoxRefs[1].Text = data.targetBanText1 end
	if data.targetBanText2 and targetBanBoxRefs[2] then targetBanBoxRefs[2].Text = data.targetBanText2 end
	if data.targetBanText3 and targetBanBoxRefs[3] then targetBanBoxRefs[3].Text = data.targetBanText3 end
	if data.targetBanText4 and targetBanBoxRefs[4] then targetBanBoxRefs[4].Text = data.targetBanText4 end
	targetBanEnabled = data.targetBanEnabled or false
	if targetBanEnabled then
		targetBanCharacters = {}
		if targetBanBoxRefs[1] and targetBanBoxRefs[1].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[1].Text end
		if targetBanBoxRefs[2] and targetBanBoxRefs[2].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[2].Text end
		if targetBanBoxRefs[3] and targetBanBoxRefs[3].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[3].Text end
		if targetBanBoxRefs[4] and targetBanBoxRefs[4].Text ~= "" then targetBanCharacters[#targetBanCharacters+1] = targetBanBoxRefs[4].Text end
		targetBanCharIdx = 1
		lastBannedChars = {}
		banActioned = false
		banCooldown = 0
	end
	if data.antiBanText1 and antiBanBoxRef[1] then antiBanBoxRef[1].Text = data.antiBanText1 end
	antiBanEnabled = data.antiBanEnabled or false
	if antiBanEnabled then
		antiBanCharacters = {}
		if antiBanBoxRef[1] and antiBanBoxRef[1].Text ~= "" then antiBanCharacters[#antiBanCharacters+1] = antiBanBoxRef[1].Text end
		antiBanCharIdx = 1
		antiBanPhase = "ban"
		antiBanActioned = false
		antiBanCooldown = 0
		antiBanPageIdx = 0
		antiBanPages = {}
	end
	ultEspSize = data.ultEspSize or 3.0
	moveEspSize = data.moveEspSize or 2.4
	gojoAfterimageEnabled = data.gojoAfterimageEnabled or false
	targetEspEnabled = data.targetEspEnabled or false
	targetEspSensitivity = data.targetEspSensitivity or 0.25
	targetEspRange = data.targetEspRange or 180
	autoInfinityLookSensitivity = data.autoInfinityLookSensitivity or 0.5
	autoInfinityRayRadius = data.autoInfinityRayRadius or 40
	
	if settingsRefs.guiEnabled then settingsRefs.guiEnabled.Set(guiEnabled) end
	if settingsRefs.teamCheckEnabled then settingsRefs.teamCheckEnabled.Set(teamCheckEnabled) end
	if settingsRefs.predictionEnabled then settingsRefs.predictionEnabled.Set(predictionEnabled) end
	if settingsRefs.predictionStrength then settingsRefs.predictionStrength.Set(predictionStrength) end
	if settingsRefs.smoothness then settingsRefs.smoothness.Set(smoothness) end
	if settingsRefs.lockKey then settingsRefs.lockKey.Set(lockKey) end
	if settingsRefs.lockMode then settingsRefs.lockMode.Set(lockMode) end
	if settingsRefs.flyEnabled then settingsRefs.flyEnabled.Set(flyEnabled) end
	if settingsRefs.flyKey then settingsRefs.flyKey.Set(flyKey) end
	if settingsRefs.flySpeed then settingsRefs.flySpeed.Set(flySpeed) end
	if settingsRefs.headAttachEnabled then settingsRefs.headAttachEnabled.Set(headAttachEnabled) end
	if settingsRefs.headAttachKey then settingsRefs.headAttachKey.Set(headAttachKey) end
	if settingsRefs.headAttachOffset then settingsRefs.headAttachOffset.Set(headAttachOffset) end
	if settingsRefs.moveEspEnabled then settingsRefs.moveEspEnabled.Set(moveEspEnabled) end
	if settingsRefs.ultEspEnabled then settingsRefs.ultEspEnabled.Set(ultEspEnabled) end
			if settingsRefs.arrowsEnabled then settingsRefs.arrowsEnabled.Set(arrowsEnabled) end
			if settingsRefs.moveInputsEnabled then settingsRefs.moveInputsEnabled.Set(moveInputsEnabled) end
			if settingsRefs.autoBlockEnabled then settingsRefs.autoBlockEnabled.Set(autoBlockEnabled) end
	if settingsRefs.blockTapDelay then settingsRefs.blockTapDelay.Set(blockTapDelay) end
	if settingsRefs.blockTapDuration then settingsRefs.blockTapDuration.Set(blockTapDuration) end
 	if settingsRefs.counterM1Delay then settingsRefs.counterM1Delay.Set(counterM1Delay) end
 	if settingsRefs.swingRange then settingsRefs.swingRange.Set(swingRange) end
 	if settingsRefs.airSwingDelay then settingsRefs.airSwingDelay.Set(airSwingDelay) end
	if settingsRefs.autoCounterEnabled then settingsRefs.autoCounterEnabled.Set(autoCounterEnabled) end
	if settingsRefs.airSwing then settingsRefs.airSwing.Set(airSwingEnabled) end
	if settingsRefs.triggerbotEnabled then settingsRefs.triggerbotEnabled.Set(triggerbotEnabled) end
	if settingsRefs.triggerbotKey then settingsRefs.triggerbotKey.Set(triggerbotKey) end
	if settingsRefs.triggerbotSlot then settingsRefs.triggerbotSlot.Set(triggerbotSlot) end
	if settingsRefs.triggerbot2Key then settingsRefs.triggerbot2Key.Set(triggerbot2Key) end
	if settingsRefs.triggerbot2Slot then settingsRefs.triggerbot2Slot.Set(triggerbot2Slot) end
	if settingsRefs.counterKey then settingsRefs.counterKey.Set(counterKey) end
	if settingsRefs.autoInfinityKey then settingsRefs.autoInfinityKey.Set(autoInfinityKey) end
	if settingsRefs.toggleUIKey then settingsRefs.toggleUIKey.Set(toggleUIKey) end
	if settingsRefs.autoInfinityUnlocked then settingsRefs.autoInfinityUnlocked.Set(autoInfinityUnlocked) end
	if settingsRefs.autoBlackFlashEnabled then settingsRefs.autoBlackFlashEnabled.Set(autoBlackFlashEnabled) end
	if settingsRefs.autoPlayEnabled then settingsRefs.autoPlayEnabled.Set(autoPlayEnabled) end
	if settingsRefs.targetBanEnabled then settingsRefs.targetBanEnabled.Set(targetBanEnabled) end
	if settingsRefs.antiBanEnabled then settingsRefs.antiBanEnabled.Set(antiBanEnabled) end
	if settingsRefs.gojoAfterimageEnabled then settingsRefs.gojoAfterimageEnabled.Set(gojoAfterimageEnabled) end
	if settingsRefs.targetEspEnabled then settingsRefs.targetEspEnabled.Set(targetEspEnabled) end
	if settingsRefs.targetEspSensitivity then settingsRefs.targetEspSensitivity.Set(targetEspSensitivity) end
	if settingsRefs.targetEspRange then settingsRefs.targetEspRange.Set(targetEspRange) end
	if settingsRefs.autoInfinityLookSensitivity then settingsRefs.autoInfinityLookSensitivity.Set(autoInfinityLookSensitivity) end
	if settingsRefs.autoInfinityRayRadius then settingsRefs.autoInfinityRayRadius.Set(autoInfinityRayRadius) end
	if settingsRefs.ultEspSize then settingsRefs.ultEspSize.Set(ultEspSize) end
	if settingsRefs.moveEspSize then settingsRefs.moveEspSize.Set(moveEspSize) end
updateCounterLabel()
	updateInfinityLabel()
end)
if not ok then return false, tostring(err) end
return true
end

function ConfigManager.list()
	ConfigManager.ensureFolder()
	local configs = {}
	if not listfiles then return configs end
	local files = listfiles(CONFIG_FOLDER)
	for _, file in ipairs(files) do
		local name = file:match("([^/\\]+)%.json$")
		if name then
			table.insert(configs, name)
		end
	end
	return configs
end

function ConfigManager.delete(name)
	local path = CONFIG_FOLDER .. name .. ".json"
	if isfile and isfile(path) then
		delfile(path)
	end
end

local autoSaveScheduled = nil
local function autoSaveSettings()
	if not ConfigManager.save then return end
	if autoSaveScheduled then return end
	autoSaveScheduled = true
	task.delay(1, function()
		autoSaveScheduled = false
		local ok = pcall(function()
			ConfigManager.save("autoload")
		end)
		if not ok then do end end
	end)
end

-- ====================== GUI HELPER CREATORS ======================
local function createToggle(parent, text, yPos, defaultState, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(245, 245, 250)
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 48, 0, 24)
    switch.Position = UDim2.new(1, -48, 0.5, -12)
    switch.BackgroundColor3 = defaultState and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(45, 45, 55)
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame
    local swCorner = Instance.new("UICorner") swCorner.CornerRadius = UDim.new(1, 0) swCorner.Parent = switch
    local swStroke = Instance.new("UIStroke") swStroke.Color = Color3.fromRGB(60, 60, 75) swStroke.Thickness = 1 swStroke.Parent = switch

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = defaultState and UDim2.new(0, 27, 0, 3) or UDim2.new(0, 3, 0, 3)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = switch
    local knobCorner = Instance.new("UICorner") knobCorner.CornerRadius = UDim.new(1, 0) knobCorner.Parent = knob

    local activeState = defaultState
    
    local function updateVisuals()
        TweenService:Create(switch, TweenInfo.new(0.15), {BackgroundColor3 = activeState and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(45, 45, 55)}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = activeState and UDim2.new(0, 27, 0, 3) or UDim2.new(0, 3, 0, 3)}):Play()
    end
    
    switch.MouseButton1Click:Connect(function()
        activeState = not activeState
        updateVisuals()
        callback(activeState)
        autoSaveSettings()
    end)
    
    return {
        Switch = switch,
        Set = function(state)
            activeState = state
            updateVisuals()
        end
    }
end

local function createSlider(parent, text, yPos, min, max, defaultVal, callback, formatter)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 18)
    label.BackgroundTransparency = 1
    label.Text = formatter and formatter(text, defaultVal) or (text .. ": " .. string.format("%.2f", defaultVal))
    label.TextColor3 = Color3.fromRGB(200, 200, 210)
    label.TextSize = 11
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, 0, 0, 6)
    sliderBg.Position = UDim2.new(0, 0, 0, 24)
    sliderBg.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = frame
    local sliderCorner = Instance.new("UICorner") sliderCorner.CornerRadius = UDim.new(1, 0) sliderCorner.Parent = sliderBg

    local percentage = (defaultVal - min) / (max - min)
    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(255, 105, 180)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    local fillCorner = Instance.new("UICorner") fillCorner.CornerRadius = UDim.new(1, 0) fillCorner.Parent = sliderFill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(percentage, -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = sliderBg
    local knobCorner = Instance.new("UICorner") knobCorner.CornerRadius = UDim.new(1, 0) knobCorner.Parent = knob

    local dragging = false
    local function update(input)
        local percent = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local value = min + percent * (max - min)
        label.Text = formatter and formatter(text, value) or (text .. ": " .. string.format("%.2f", value))
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, -6, 0.5, -6)
        callback(value)
        autoSaveSettings()
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end))

    table.insert(connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end))
    
    return {
        Set = function(val)
            local percent = (val - min) / (max - min)
            label.Text = formatter and formatter(text, val) or (text .. ": " .. string.format("%.2f", val))
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            knob.Position = UDim2.new(percent, -6, 0.5, -6)
        end
    }
end

local function createKeybind(parent, text, yPos, defaultKey, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundTransparency = 1
    frame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -142, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(245, 245, 250)
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size = UDim2.new(0, 72, 0, 24)
    bindBtn.Position = UDim2.new(1, -72, 0.5, -12)
    bindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    bindBtn.Text = (defaultKey and defaultKey.Name) or "None"
    bindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    bindBtn.Font = Enum.Font.GothamBold
    bindBtn.TextSize = 11
    bindBtn.Parent = frame
    local btnCorner = Instance.new("UICorner") btnCorner.CornerRadius = UDim.new(0, 6) btnCorner.Parent = bindBtn
    local btnStroke = Instance.new("UIStroke") btnStroke.Color = Color3.fromRGB(60, 60, 75) btnStroke.Thickness = 1 btnStroke.Parent = bindBtn

    local unbindBtn = Instance.new("TextButton")
    unbindBtn.Size = UDim2.new(0, 58, 0, 24)
    unbindBtn.Position = UDim2.new(1, -136, 0.5, -12)
    unbindBtn.BackgroundColor3 = Color3.fromRGB(65, 28, 28)
    unbindBtn.Text = "Unbind"
    unbindBtn.TextColor3 = Color3.fromRGB(220, 130, 130)
    unbindBtn.Font = Enum.Font.GothamBold
    unbindBtn.TextSize = 10
    unbindBtn.Parent = frame
    local unbindCorner = Instance.new("UICorner") unbindCorner.CornerRadius = UDim.new(0, 6) unbindCorner.Parent = unbindBtn

    local binding = false
    local result = {
        Set = function(key)
            bindBtn.Text = (key and key.Name) or "None"
        end
    }
    unbindBtn.MouseButton1Click:Connect(function()
        if binding then return end
        result.Set(nil)
        callback(nil)
        autoSaveSettings()
    end)
    bindBtn.MouseButton1Click:Connect(function()
        if binding then return end
        binding = true
        bindBtn.Text = "..."
        bindBtn.BackgroundColor3 = Color3.fromRGB(65, 65, 80)
        
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                bindBtn.Text = input.KeyCode.Name
                bindBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
                conn:Disconnect()
                binding = false
                callback(input.KeyCode)
                autoSaveSettings()
            end
        end)
    end)
    return result
end

-- ====================== MOUNT TABS AND POPULATE OPTIONS ======================

-- Master setter for the Lock selector. "Off" disables the lock outright;
-- anything else enables it. Dropdown text syncs when the UI exists.
applyLockMode = function(mode)
    if mode ~= "Off" and mode ~= "Camera" and mode ~= "Silent" then return end
    lockMode = mode
    guiEnabled = (mode ~= "Off")
    if not guiEnabled then
        active = false
        lockedTarget = nil
    end
    if refreshLockDropdown then refreshLockDropdown() end
end

-- MAIN TAB (Lock, Team check, Prediction, Smoothness, Lock Keybind)
do -- Lock dropdown: Off / Camera / Silent (single selector replaces the old toggle + mode list)
    local lockFrame = Instance.new("Frame")
    lockFrame.Size = UDim2.new(1, 0, 0, 32)
    lockFrame.Position = UDim2.new(0, 0, 0, 10)
    lockFrame.BackgroundTransparency = 1
    lockFrame.Parent = mainTabFrame

    local modeLabel = Instance.new("TextLabel")
    modeLabel.Size = UDim2.new(1, -120, 1, 0)
    modeLabel.BackgroundTransparency = 1
    modeLabel.Text = "Lock"
    modeLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
    modeLabel.TextSize = 13
    modeLabel.Font = Enum.Font.GothamMedium
    modeLabel.TextXAlignment = Enum.TextXAlignment.Left
    modeLabel.Parent = lockFrame

    local dropBtn = Instance.new("TextButton")
    dropBtn.Size = UDim2.new(0, 110, 0, 24)
    dropBtn.Position = UDim2.new(1, -110, 0.5, -12)
    dropBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    dropBtn.Text = lockMode
    dropBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    dropBtn.Font = Enum.Font.GothamBold
    dropBtn.TextSize = 12
    dropBtn.AutoButtonColor = false
    dropBtn.Parent = lockFrame
    local dbCorner = Instance.new("UICorner"); dbCorner.CornerRadius = UDim.new(0, 6); dbCorner.Parent = dropBtn
    local dbStroke = Instance.new("UIStroke"); dbStroke.Color = Color3.fromRGB(60, 60, 75); dbStroke.Thickness = 1; dbStroke.Parent = dropBtn

    local dropList = Instance.new("Frame")
    dropList.Size = UDim2.new(0, 110, 0, 82)
    dropList.Position = UDim2.new(1, -110, 0, 30)
    dropList.BackgroundColor3 = Color3.fromRGB(20, 18, 28)
    dropList.BorderSizePixel = 0
    dropList.Visible = false
    dropList.ZIndex = 10
    dropList.Parent = lockFrame
    local dlCorner = Instance.new("UICorner"); dlCorner.CornerRadius = UDim.new(0, 6); dlCorner.Parent = dropList

    refreshLockDropdown = function()
        dropBtn.Text = lockMode
    end

    local modes = { "Off", "Camera", "Silent" }
    for i, name in ipairs(modes) do
        local opt = Instance.new("TextButton")
        opt.Size = UDim2.new(1, -4, 0, 24)
        opt.Position = UDim2.new(0, 2, 0, 2 + (i - 1) * 26)
        opt.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
        opt.Text = name
        opt.TextColor3 = Color3.fromRGB(230, 230, 240)
        opt.Font = Enum.Font.Gotham
        opt.TextSize = 12
        opt.BorderSizePixel = 0
        opt.ZIndex = 10
        opt.Parent = dropList
        local modeName = name
        opt.MouseButton1Click:Connect(function()
            applyLockMode(modeName)
            dropList.Visible = false
            autoSaveSettings()
        end)
        opt.MouseEnter:Connect(function()
            opt.BackgroundColor3 = Color3.fromRGB(50, 48, 58)
        end)
        opt.MouseLeave:Connect(function()
            opt.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
        end)
    end

    dropBtn.MouseButton1Click:Connect(function()
        dropList.Visible = not dropList.Visible
    end)
    refreshLockDropdown()
    settingsRefs.lockMode = {
        Set = function(val)
            if val == "Off" or val == "Camera" or val == "Silent" then
                applyLockMode(val)
            end
        end
    }
    -- Back-compat shim: legacy configs/code drive the old boolean toggle.
    settingsRefs.guiEnabled = {
        Set = function(state)
            if state then
                applyLockMode((lockMode ~= "Off" and lockMode) or "Camera")
            else
                applyLockMode("Off")
            end
        end
    }
end

