-- ====================== AUTOINFINITY ENEMY SCAN NOTICE ======================
-- When AutoInfinity is on, scan every enemy's character (via the SpawnChar
-- attribute, same signal the hook uses) and show which of their moves are
-- counterable, e.g. "Piccolo: demon wave, hellzone".
local autoInfinityNotice = Instance.new("TextLabel")
autoInfinityNotice.Name = "AutoInfinityNotice"
autoInfinityNotice.Size = UDim2.new(0, 300, 0, 0)
autoInfinityNotice.Position = UDim2.new(1, -10, 1, -10)
autoInfinityNotice.AnchorPoint = Vector2.new(1, 1)
autoInfinityNotice.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
autoInfinityNotice.BackgroundTransparency = 0.25
autoInfinityNotice.BorderSizePixel = 0
autoInfinityNotice.Text = ""
autoInfinityNotice.TextColor3 = Color3.fromRGB(190, 210, 230)
autoInfinityNotice.TextSize = 13
autoInfinityNotice.Font = Enum.Font.Gotham
autoInfinityNotice.TextXAlignment = Enum.TextXAlignment.Right
autoInfinityNotice.TextYAlignment = Enum.TextYAlignment.Bottom
autoInfinityNotice.TextWrapped = true
autoInfinityNotice.AutomaticSize = Enum.AutomaticSize.Y
autoInfinityNotice.Visible = false
autoInfinityNotice.Parent = screenGui
table.insert(connections, autoInfinityNotice:GetPropertyChangedSignal("Text"):Connect(function()
	autoInfinityNotice.Size = UDim2.new(0, 300, 0, autoInfinityNotice.TextBounds.Y + 12)
end))

-- Rebuild the "counterable moves" notice from currently-spawned enemies.
local function autoInfinityScanNotice()
	if not autoInfinityEnabled then
		autoInfinityNotice.Visible = false
		return
	end
	local lines = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char then continue end
		if teamCheckEnabled and aiIsTeammate(player) then continue end
		local base = player:GetAttribute("SpawnChar") or (char.GetAttribute and char:GetAttribute("SpawnChar"))
		local parts = {}
		local collect = function(cn)
			if not cn or type(cn) ~= "string" then return end
			local moves = aiState.counterMoves[cn]
			if not moves then return end
			for name in pairs(moves) do parts[#parts + 1] = name end
		end
		collect(base)
		if type(base) == "string" then collect(base .. " [Awakening]") end
		if #parts > 0 then
			local label = (base or char.Name) .. ": "
			table.sort(parts, function(a, b) return a < b end)
			lines[#lines + 1] = label .. table.concat(parts, ", ")
		end
	end
	if #lines > 0 then
		autoInfinityNotice.Text = table.concat(lines, "\n")
		autoInfinityNotice.Visible = true
	else
		autoInfinityNotice.Text = ""
		autoInfinityNotice.Visible = false
	end
end

-- keep the notice fresh while AutoInfinity runs (players spawn/change chars)
local autoInfinityScanNoticeLast = 0
local autoInfinityNoticeShownAt = 0
local function autoInfinityShowNotice()
	autoInfinityNoticeShownAt = os.clock()
	autoInfinityScanNotice()
end
table.insert(connections, RunService.RenderStepped:Connect(function()
	if not autoInfinityEnabled then return end
	-- if the notice was never shown since enabling, show it now
	if autoInfinityNoticeShownAt == 0 then
		autoInfinityShowNotice()
	end
	-- auto-hide the notice 3s after it was shown
	if os.clock() - autoInfinityNoticeShownAt > 3 then
		if autoInfinityNotice.Visible then autoInfinityNotice.Visible = false end
		return
	end
	-- throttle to ~2 Hz
	if os.clock() - autoInfinityScanNoticeLast < 0.5 then return end
	autoInfinityScanNoticeLast = os.clock()
	autoInfinityScanNotice()
end))

