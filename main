-- UI decoration helpers (declared once, reused everywhere). Each call site used
-- to declare its own `local corner/stroke/padding` temporary; some executors
-- count those against the top-level chunk's 200-local budget and fail compiling
-- with "Out of local registers ... exceeded limit 200" right after the shell.
local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius
	c.Parent = parent
	return c
end
local function addStroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Parent = parent
	return s
end
local function addRightPadding(parent, offset)
	local p = Instance.new("UIPadding")
	p.PaddingRight = UDim.new(0, offset)
	p.Parent = parent
	return p
end

-- ====================== COUNTER DIAGNOSTICS ======================
-- Behaviour-neutral tracing for Auto Block / Auto Counter / Air Swing.
-- Silent by default: no console prints, no file writes, no ring buffer.
-- To trace again, set getgenv().PiggyCounterOptIn = true BEFORE executing.
-- Runtime toggles still work:
--   getgenv().PiggyCounterDiagOn = true    -- start/stop collecting
--   getgenv().PiggyCounterFile = true      -- file output
--   getgenv().PiggyCounterPrint = true     -- console output
--   getgenv().PiggyCounterVerbose = true   -- per-frame/guard spam
-- Dump the ring buffer: getgenv().PiggyCounterDump(200)
-- Clear it:             getgenv().PiggyCounterClear()
-- File (when enabled and the executor supports appendfile): PiggyHub/counter_diag.log
local counterDiagEnv = _G
pcall(function()
	if typeof(getgenv) == "function" and getgenv() then counterDiagEnv = getgenv() end
end)
-- Force everything off unless the user opted in for this run. The old code only
-- filled these in when nil, so a `true` left behind by a previous execution kept
-- the console spamming forever.
local counterDiagOptIn = counterDiagEnv.PiggyCounterOptIn == true
counterDiagEnv.PiggyCounterDiagOn = counterDiagOptIn
counterDiagEnv.PiggyCounterFile = counterDiagOptIn
counterDiagEnv.PiggyCounterPrint = counterDiagOptIn
if counterDiagEnv.PiggyCounterVerbose == nil then counterDiagEnv.PiggyCounterVerbose = false end

local counterDiagEntries = {}
counterDiagEnv.PiggyCounterDiag = counterDiagEntries
local counterDiagMax = 600
local counterDiagThrottle = {}

local counterDiagFileQueue = {}
local function counterDiagFlush()
	if #counterDiagFileQueue == 0 then return end
	local chunk = table.concat(counterDiagFileQueue, "\n") .. "\n"
	for i = #counterDiagFileQueue, 1, -1 do counterDiagFileQueue[i] = nil end
	if not counterDiagEnv.PiggyCounterFile then return end
	pcall(function()
		if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder("PiggyHub") then
			makefolder("PiggyHub")
		end
		if typeof(appendfile) == "function" then
			appendfile("PiggyHub/counter_diag.log", chunk)
		end
	end)
end
local function counterDiagAppend(line)
	if not counterDiagEnv.PiggyCounterFile then return end
	table.insert(counterDiagFileQueue, line)
	-- Flush in batches from the heartbeat (see watchdog below); only force an
	-- early flush if the buffer gets large, so the hot F/M1 paths never wait
	-- on disk I/O.
	if #counterDiagFileQueue >= 200 then counterDiagFlush() end
end

local function counterDiag(evt, ...)
	if not counterDiagEnv.PiggyCounterDiagOn then return end
	local parts = {}
	for i = 1, select("#", ...) do
		parts[i] = tostring(select(i, ...))
	end
	local line = string.format("[CDIAG %.3f] %s %s", os.clock(), tostring(evt), table.concat(parts, " "))
	table.insert(counterDiagEntries, line)
	if #counterDiagEntries > counterDiagMax then table.remove(counterDiagEntries, 1) end
	if counterDiagEnv.PiggyCounterPrint then print(line) end
	counterDiagAppend(line)
end

local function counterDiagThrottled(key, interval, evt, ...)
	local now = os.clock()
	local last = counterDiagThrottle[key]
	if last and now - last < interval then return end
	counterDiagThrottle[key] = now
	counterDiag(evt, ...)
end

counterDiagEnv.PiggyCounterDump = function(n)
	local total = #counterDiagEntries
	local first = math.max(1, total - (tonumber(n) or 120) + 1)
	print(string.format("[CDIAG] ----- dump %d/%d -----", first, total))
	for i = first, total do print(counterDiagEntries[i]) end
	print("[CDIAG] ----- end dump -----")
	return table.concat(counterDiagEntries, "\n", first, total)
end
counterDiagEnv.PiggyCounterClear = function()
	for i = #counterDiagEntries, 1, -1 do counterDiagEntries[i] = nil end
	print("[CDIAG] cleared")
end

local counterTransitionStart = 0
local counterTransitionWarned = false
local counterDiagSendRecords = {}
local counterDiagSharedM1Ids = nil -- assigned after sharedM1AnimIds is built

local function counterDiagBlocking()
	local bits = {}
	local char = LocalPlayer.Character
	local b = char and char:FindFirstChild("Blocking")
	if b then
		if b:IsA("BoolValue") or b:IsA("ValueBase") then
			bits[#bits + 1] = "blockVal=" .. tostring(b.Value)
		else
			bits[#bits + 1] = "blockVal=<object>"
		end
	else
		bits[#bits + 1] = "blockVal=nil"
	end
	if char then bits[#bits + 1] = "blockAttr=" .. tostring(char:GetAttribute("Blocking")) end
	bits[#bits + 1] = "isKeyDownF=" .. tostring(UserInputService:IsKeyDown(Enum.KeyCode.F))
	bits[#bits + 1] = "userHoldingF=" .. tostring(userHoldingF)
	bits[#bits + 1] = "blockingState=" .. tostring(blockingState)
	bits[#bits + 1] = "pendingDown=" .. tostring(pendingDownEcho)
	bits[#bits + 1] = "pendingUp=" .. tostring(pendingUpEcho)
	if lastDownStamp > 0 then bits[#bits + 1] = string.format("downAge=%.3f", os.clock() - lastDownStamp) end
	if lastUpStamp > 0 then bits[#bits + 1] = string.format("upAge=%.3f", os.clock() - lastUpStamp) end
	local pingOk, ping = pcall(function() return LocalPlayer:GetNetworkPing() end)
	if pingOk and type(ping) == "number" and ping > 0 then
		bits[#bits + 1] = string.format("pingMs=%.0f", ping * 1000)
	end
	return table.concat(bits, " ")
end

local function counterDiagNoteM1Send(tag)
	if not counterDiagEnv.PiggyCounterDiagOn then return end
	local rec = { t = os.clock(), tag = tostring(tag or "?"), seen = false }
	table.insert(counterDiagSendRecords, rec)
	for i = #counterDiagSendRecords, 1, -1 do
		if os.clock() - counterDiagSendRecords[i].t > 10 then table.remove(counterDiagSendRecords, i) end
	end
	task.delay(0.8, function()
		if not rec.seen then
			counterDiag("NO_OWN_M1_ANIM", "src=" .. rec.tag,
				string.format("sinceSend=%.3f", os.clock() - rec.t),
				counterDiagBlocking())
		end
	end)
end

local function counterDiagOnOwnAnim(track)
	if not counterDiagEnv.PiggyCounterDiagOn then return end
	local now = os.clock()
	local aid = track and track.Animation and track.Animation.AnimationId
	local name = track and track.Name or "?"
	local idNum = aid and (tostring(aid):match("%d+")) or ""
	local isM1 = counterDiagSharedM1Ids and counterDiagSharedM1Ids[idNum] or false
	local recent
	for i = #counterDiagSendRecords, 1, -1 do
		local rec = counterDiagSendRecords[i]
		if now - rec.t <= 1.5 and not rec.seen then
			recent = rec
			break
		end
	end
	if not recent then
		if counterDiagEnv.PiggyCounterVerbose then
			counterDiag("OWN_ANIM_BG", "name=" .. tostring(name), "id=" .. tostring(aid))
		end
		return
	end
	if isM1 then
		recent.seen = true
		counterDiag("OWN_M1_ANIM", "src=" .. recent.tag, "name=" .. tostring(name),
			"id=" .. tostring(aid), string.format("sinceSend=%.3f", now - recent.t),
			counterDiagBlocking())
	else
		-- Not a known M1 ID: log it so an unknown/new M1 id is visible, but do
		-- not mark the send as answered (a block-release pose must not hide a
		-- swallowed M1).
		counterDiag("OWN_ANIM_NEAR", "src=" .. recent.tag, "isM1Id=false",
			"name=" .. tostring(name), "id=" .. tostring(aid),
			string.format("sinceSend=%.3f", now - recent.t))
	end
end

counterDiag("DIAG_READY", "on=" .. tostring(counterDiagEnv.PiggyCounterDiagOn),
	"file=" .. tostring(counterDiagEnv.PiggyCounterFile),
	"dump=getgenv().PiggyCounterDump()")

-- Script-owned F presses expect exactly one InputBegan/Ended echo each, so the
-- userHoldingF tracker below can tell synthetic presses apart from a physical
-- finger with no timing blind spots and no IsKeyDown polling. Zero delay:
-- bookkeeping happens inline, no waits added to any block/counter path.
local function scriptFDown()
	pendingDownEcho = pendingDownEcho + 1
	lastDownStamp = os.clock()
	counterDiag("SCRIPT_F_DOWN", "pendingDown=" .. tostring(pendingDownEcho),
		"blockingState=" .. tostring(blockingState), "transitioning=" .. tostring(transitioningToCounter))
	pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game) end)
end
local function scriptFUp()
	pendingUpEcho = pendingUpEcho + 1
	lastUpStamp = os.clock()
	counterDiag("SCRIPT_F_UP", "pendingUp=" .. tostring(pendingUpEcho),
		"blockingState=" .. tostring(blockingState), "transitioning=" .. tostring(transitioningToCounter))
	pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game) end)
end
table.insert(connections, UserInputService.InputBegan:Connect(function(input, _gp)
	if input.KeyCode == Enum.KeyCode.F and input.UserInputType == Enum.UserInputType.Keyboard then
		if pendingDownEcho > 0 and os.clock() - lastDownStamp < ECHO_WINDOW then
			pendingDownEcho = pendingDownEcho - 1
			counterDiag("F_DOWN_ECHO", "pendingDown=" .. tostring(pendingDownEcho),
				string.format("age=%.3f", os.clock() - lastDownStamp))
			return
		end
		pendingDownEcho = 0
		userHoldingF = true
		counterDiag("F_DOWN_PHYS", counterDiagBlocking())
	end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.F and input.UserInputType == Enum.UserInputType.Keyboard then
		if pendingUpEcho > 0 and os.clock() - lastUpStamp < ECHO_WINDOW then
			pendingUpEcho = pendingUpEcho - 1
			counterDiag("F_UP_ECHO", "pendingUp=" .. tostring(pendingUpEcho),
				string.format("age=%.3f", os.clock() - lastUpStamp),
				"userHoldingF=" .. tostring(userHoldingF))
			return
		end
		pendingUpEcho = 0
		counterDiag("F_UP_PHYS", "userHoldingF=" .. tostring(userHoldingF),
			"counterGen=" .. tostring(counterGen),
			"transitioning=" .. tostring(transitioningToCounter),
			"blockingState=" .. tostring(blockingState))
		if userHoldingF then
			userHoldingF = false
			blockGen = blockGen + 1
			counterGen = counterGen + 1
			blockingState = false
			airSwingArmed = nil
			testHoldBlock = false
			counterDiag("F_UP_BUMP", "counterGen=" .. tostring(counterGen),
				"transitioning=" .. tostring(transitioningToCounter),
				"LEAK_WINDOW=" .. tostring(transitioningToCounter))
			scriptFUp()
		else
			counterDiag("F_UP_PHYS_IGNORED", "reason=userHoldingF=false")
		end
	end
end))
pcall(function() userHoldingF = UserInputService:IsKeyDown(Enum.KeyCode.F) end)

local function clickBanButton(btn)
	local ok = pcall(function()
		local bc = PlayerGui:FindFirstChild("BanChooser")
		if bc then
			local comm = bc:FindFirstChild("Communicate")
			if comm and comm:IsA("RemoteEvent") then
				comm:FireServer(btn.Name)
			end
		end
		-- Also click via mouse for visual feedback
		local pos = btn.AbsolutePosition
		local size = btn.AbsoluteSize
		if pos.X > 0 and pos.Y > 0 then
			VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2 + 75, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(pos.X + size.X / 2, pos.Y + size.Y / 2 + 75, 0, false, game, 0)
		end
	end)
	return ok
end

local function clickPos(x, y)
	local ok = pcall(function()
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait(0.03)
		VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end)
	return ok
end

local function findCharButton(searchName)
	local bc = PlayerGui:FindFirstChild("BanChooser")
	if not bc or not bc.Enabled then return nil, nil end
	local cs = bc:FindFirstChild("CharacterSelect")
	if not cs then return nil, nil end
	local chars = cs:FindFirstChild("Characters")
	if not chars then return nil, nil end

	for _, page in chars:GetChildren() do
		if not page:IsA("Frame") then continue end
		for _, cat in page:GetChildren() do
			if not cat:IsA("Frame") then continue end
			local slots = cat:FindFirstChild("Slots")
			if not slots then continue end
			for _, btn in slots:GetChildren() do
				if not btn:IsA("ImageButton") then continue end
				local n = btn.Name:lower()
				if n == searchName or n:find(searchName, 1, true) then
					return btn, page
				end
			end
		end
	end
	return nil, nil
end

local function navigateToPage(chars, targetPage, cs)
	local pages = {}
	for _, p in chars:GetChildren() do
		if p:IsA("Frame") then
			table.insert(pages, p)
		end
	end
	if #pages == 0 then return true end

	local targetIdx, currentIdx
	for i, p in ipairs(pages) do
		if p == targetPage then targetIdx = i end
		if p.Visible then currentIdx = i end
	end
	if not targetIdx or not currentIdx or targetIdx == currentIdx then return true end

	local diff = targetIdx - currentIdx
	local btnName = diff > 0 and "Next" or "Back"
	local navBtn = cs:FindFirstChild(btnName)
	if navBtn and navBtn:IsA("TextButton") then
		local npos = navBtn.AbsolutePosition
		local nsz = navBtn.AbsoluteSize
		if npos.X > 0 and npos.Y > 0 then
			clickPos(npos.X + nsz.X/2, npos.Y + nsz.Y/2)
		end
		return false
	end
	return true
end

-- Safely determine GUI parent by testing write permissions
local parentGui = PlayerGui
do
	pcall(function()
		local testGui = Instance.new("ScreenGui")
		testGui.Parent = CoreGui
		parentGui = CoreGui
		testGui:Destroy()
	end)
end

-- Clean up any existing instances of PiggyUI in both parents
do
	pcall(function()
		local oldGui1 = PlayerGui:FindFirstChild("PiggyUI")
		if oldGui1 then oldGui1:Destroy() end
		local oldGuiV2 = PlayerGui:FindFirstChild("PiggyUIV2")
		if oldGuiV2 then oldGuiV2:Destroy() end
		if parentGui == CoreGui then
			local oldGui2 = CoreGui:FindFirstChild("PiggyUI")
			if oldGui2 then oldGui2:Destroy() end
			local oldGui2v2 = CoreGui:FindFirstChild("PiggyUIV2")
			if oldGui2v2 then oldGui2v2:Destroy() end
		end
	end)
end

do end
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PiggyUIV2"
screenGui.ResetOnSpawn = false
screenGui.Parent = parentGui

-- Main UI Frame (Stunning Dark/Neon Theme)
local mainFrame = Instance.new("Frame")
